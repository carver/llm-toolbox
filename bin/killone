#!/usr/bin/env python3
"""Stop exactly one process, found by name or command line, and never the caller.

`pkill -f PATTERN` also matches the shell running it, because the pattern is in
that shell's own command line, and kills it. killone skips itself and every
ancestor, and refuses to act unless exactly one process matches.

Exit status: 0 signalled one process, 1 nothing matched, 2 several matched
(listed, none signalled), 3 the signal failed. See also waitone.
"""

import argparse
import os
import signal
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from procmatch import exactly_one, wait_gone  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="killone", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("pattern", help="exact process name, or with -f a regex over the full command line")
    parser.add_argument("-f", "--full", action="store_true", help="match the full command line, like pkill -f")
    parser.add_argument("-s", "--signal", default="TERM", help="signal name or number (default %(default)s)")
    parser.add_argument("-n", "--dry-run", action="store_true", help="show what would be signalled")
    parser.add_argument(
        "-w", "--wait", type=float, default=0, metavar="SECONDS",
        help="wait up to SECONDS for the process to exit; exit 3 if it doesn't",
    )
    args = parser.parse_args(argv)

    sig_name = args.signal.upper().removeprefix("SIG")
    sig = signal.Signals(int(sig_name)) if sig_name.isdigit() else signal.Signals["SIG" + sig_name]
    found = exactly_one(args.pattern, args.full, "killone")
    if isinstance(found, int):
        return found
    pid, cmdline = found
    if args.dry_run:
        print(f"would send {sig.name} to {pid}  {cmdline}")
        return 0
    try:
        os.kill(pid, sig)
    except OSError as e:
        print(f"killone: {sig.name} to {pid} failed: {e}", file=sys.stderr)
        return 3
    print(f"sent {sig.name} to {pid}  {cmdline}")
    if args.wait and not wait_gone(pid, args.wait):
        print(f"killone: {pid} still running after {args.wait}s", file=sys.stderr)
        return 3
    return 0


if __name__ == "__main__":
    sys.exit(main())
