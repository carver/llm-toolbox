#!/usr/bin/env python3
"""Ship a worktree's commits: rebase, check, then push, or with --local land them on
the main tree's branch.

    wt-ship                       rebase onto origin/<main tree's branch>, check, push
    wt-ship --check 'make test'   run this check instead of the repo's agent-pre-commit
    wt-ship --remove              then remove this worktree, through the main tree
    wt-ship --remote up --branch dev
    wt-ship --local [--remove]    in a repo that doesn't push: land on the main tree
    wt-ship -C ../repo-wt-topic --local --remove
                                  the same, run from outside the worktree

In order, it:

1. refuses uncommitted changes to tracked files;
2. fetches the remote, and when HEAD lacks REMOTE/BRANCH or holds fixup! commits,
   rebases onto it, folding them (autosquash). A conflict stops it with the rebase in
   progress: resolve the hunks (`conflicts -h`), `git rebase --continue`, then run it
   again;
3. refuses leftover conflict markers in what it would push;
4. runs the check: --check CMD (through sh), else the repo's agent-pre-commit hook
   (through agent-commit-gate --run when it's on PATH), else none, and says so;
5. pushes HEAD to REMOTE/BRANCH. When another session's push wins the race (a
   non-fast-forward rejection), it fetches, rebases, checks and pushes again, up to
   10 tries in all, then stops saying to run it again;
6. fetches again and confirms the remote branch holds HEAD;
7. prints the range it pushed, a notice for other sessions (which it doesn't send),
   and whether the main tree's branch is now behind the remote.

BRANCH defaults to the branch the main worktree has checked out. Nothing to push is a
clean exit. --remove runs `git worktree remove` from the main tree once the push is
confirmed. A shell that started the run inside the worktree is left in a deleted
folder, where Claude Code's Bash tool reports exit 1 after a landing that worked; -C
DIR, which runs wt-ship as if started in DIR (as `git -C` does), lets the call start
outside it.

--local, for a repo whose owner pushes, takes the same steps against the branch the
main tree has checked out instead of a remote (no --remote, and no other --branch):
it rebases onto that branch and checks as above, replaying only the commits since this
worktree forked from it (`--fork-point`, from the branch's reflog): a commit the branch
held then and holds no more, one another session rewrote or dropped, isn't replayed,
and the run names each such commit. With no fork point in the reflog it rebases as a
plain rebase would. Then it claims the main tree with its CLAUDE_WORKING flag, which
records $CLAUDE_CODE_SESSION_ID, the time, and this host and process (an old-style
flag of this session's, one without a process, is kept), and fast-forwards the main
tree with `git merge --ff-only`. While another run holds the flag, this session's
other runs (a subagent's) included, it waits its turn in a first-come-first-served
queue in the repo's common git dir, printing a line when whom it waits on changes,
and gives up after WT_SHIP_WAIT seconds, naming what held it up; --no-wait gives up
at once when the flag is held or anyone is queued. Under a lock in the queue folder,
it clears a flag, or an entry, whose process ran on this host and has ended. A flag
it can't judge, an old-style one or one from another host, it only waits on.
When another session landed during the check, it rebases and checks again, up to 10
times, still holding the claim, then merges. When the main tree's uncommitted changes
touch the files the merge changes, it stops, merging nothing: ask the user. The flag
it made, and its place in the queue, go once the merge is done or has failed, or the
run is stopped. It must run in a linked worktree.

Environment:
  WT_SHIP_WAIT   seconds --local waits for the main tree (default 1800)
  WT_SHIP_POLL   seconds between its looks at the flag and the queue (default 5;
                 the tests shorten both)

Exit status: 0 shipped, landed or nothing to do; 1 a step failed (the message says
what to do); 2 a usage error; with --local, 3 another session held the main tree's
claim past the wait (tell the user what held it up and since when), 4 the main tree's
uncommitted changes touch the files the landing changes (ask the user); 5 the tries
ran out, another session's pushes or commits winning each of 10 (run it again later).
"""

import argparse
import os
import shlex
import shutil
import signal
import subprocess
import sys
import time
from contextlib import contextmanager
from pathlib import Path
from typing import NamedTuple

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import fifo
from fifo import Holder

# --local's outcomes the user decides on.
CLAIMED, SAME_FILES = 3, 4


class Stop(Exception):
    """A step failed; the message says what to do, and status is the exit status."""

    def __init__(self, message, status=1):
        super().__init__(message)
        self.status = status


# This run's command line, so a stop can say to run the same thing again; main sets it.
RERUN = "wt-ship"


def worktree_hint(main_path):
    """How to run wt-ship on a worktree from the main tree."""
    return f"`wt-ship -C ../{Path(main_path).name}-wt-<topic>`"


class Mode(NamedTuple):
    """What a run does with the commits: for its messages, and how it rebases."""

    done: str  # "pushed" or "landed"
    # Rebase only the commits since HEAD forked from the branch, found through the
    # branch's reflog, so a commit another session rewrote meanwhile isn't replayed.
    fork_point: bool


PUSH = Mode("pushed", fork_point=False)
LAND = Mode("landed", fork_point=True)


def git(*args, check=True):
    run = subprocess.run(["git", *args], capture_output=True, text=True, check=False)
    if check and run.returncode != 0:
        raise Stop(f"git {' '.join(args)} failed:\n{run.stdout}{run.stderr}".rstrip())
    return run


def out(*args):
    return git(*args).stdout.strip()


def worktrees():
    """(path, branch or None) for each worktree, the main one first."""
    trees = []
    for block in out("worktree", "list", "--porcelain").split("\n\n"):
        lines = block.splitlines()
        path = next(ln[9:] for ln in lines if ln.startswith("worktree "))
        branch = next(
            (
                ln.removeprefix("branch refs/heads/")
                for ln in lines
                if ln.startswith("branch ")
            ),
            None,
        )
        trees.append((path, branch))
    return trees


def is_ancestor(older, newer):
    return git("merge-base", "--is-ancestor", older, newer, check=False).returncode == 0


def rebase(upstream, mode):
    env = os.environ | {"GIT_SEQUENCE_EDITOR": ":", "GIT_EDITOR": ":"}
    fork = ["--fork-point"] if mode.fork_point else []
    run = subprocess.run(
        ["git", "rebase", "-q", "-i", "--autosquash", *fork, upstream],
        env=env,
        capture_output=True,
        text=True,
        check=False,
    )
    if run.returncode != 0:
        raise Stop(
            f"{run.stdout}{run.stderr}".rstrip()
            + f"\nThe rebase onto {upstream} hit a conflict and is still in progress."
            "\nResolve each hunk (`conflicts FILE`, `conflicts -h`), `git add` the file,"
            f" `git rebase --continue`, then run `{RERUN}` again."
        )


def markers(upstream):
    check = git("diff", "--check", upstream, "HEAD", check=False).stdout
    found = [
        line.removesuffix(": leftover conflict marker")
        for line in check.splitlines()
        if line.endswith(": leftover conflict marker")
    ]
    if found:
        raise Stop(
            "Leftover conflict markers; resolve them (`conflicts -h`) and amend, or for a"
            " file that holds them on purpose, set conflict-marker-size in"
            " .gitattributes:\n  " + "\n  ".join(found)
        )


def run_stoppable(argv, env=None):
    """Run argv to its end and return its exit status. When this run is stopped
    meanwhile, argv's whole process group is stopped too, so no check outlives it."""
    process = subprocess.Popen(argv, env=env, start_new_session=True)
    try:
        return process.wait()
    except BaseException:
        os.killpg(process.pid, signal.SIGTERM)
        process.wait()
        raise


def run_check(command, mode):
    if command is None:
        hook = Path(out("rev-parse", "--git-path", "hooks")) / "agent-pre-commit"
        hook = (
            hook
            if hook.is_absolute()
            else Path(out("rev-parse", "--show-toplevel")) / hook
        )
        if not (hook.is_file() and os.access(hook, os.X_OK)):
            print(
                "No check: the repo has no agent-pre-commit hook and no --check was given."
            )
            return
        gate = shutil.which("agent-commit-gate")
        argv = [gate, "--run", str(hook)] if gate else [str(hook)]
        env = os.environ | {"AGENT_PRE_COMMIT": "1"}
        code = run_stoppable(argv, env)
        name = "agent-pre-commit"
    else:
        code = run_stoppable(["sh", "-c", command])
        name = repr(command)
    if code != 0:
        raise Stop(f"The check {name} failed (exit {code}); nothing was {mode.done}.")


# A push that lost a race: refused as a non-fast-forward, or the branch moved mid-push.
REJECTED = (
    "[rejected]",
    "non-fast-forward",
    "fetch first",
    "incorrect old value",
    "cannot lock ref",
)


FIXUP_PREFIXES = ("fixup! ", "squash! ", "amend! ")
# How many times a push may lose a race to another session's, each followed by a
# rebase and the check, before wt-ship gives up; the same for a landing whose branch
# moves during the check.
TRIES = 10
# The exit status when the tries run out: nothing failed, so run it again later.
TRY_AGAIN = 5


def has_fixups(upstream):
    """Whether HEAD holds a commit to fold, since upstream."""
    subjects = out("log", "--format=%s", f"{upstream}..HEAD").splitlines()
    return any(subject.startswith(FIXUP_PREFIXES) for subject in subjects)


def not_replayed(upstream):
    """The commits a --fork-point rebase onto upstream leaves out: those upstream held
    when HEAD forked from it and holds no more, such as one another session rewrote
    or dropped. Empty when upstream's reflog has no fork point."""
    fork = git("merge-base", "--fork-point", upstream, "HEAD", check=False)
    if fork.returncode != 0:
        return []
    base = out("merge-base", upstream, "HEAD")
    point = fork.stdout.strip()
    if point == base:
        return []
    return out("log", "--reverse", "--format=%h %s", f"{base}..{point}").splitlines()


def prepare(upstream, check, mode):
    """Rebase onto upstream when HEAD lacks it, holds fixups to fold, or (--local)
    holds commits the branch dropped; refuse markers; check."""
    skipped = not_replayed(upstream) if mode.fork_point else []
    if skipped:
        print(
            f"Not replaying these, which {upstream.removeprefix('refs/heads/')} held"
            " when this worktree forked from it and holds no more:\n  "
            + "\n  ".join(skipped)
            + "\n",
            flush=True,
        )
    if skipped or has_fixups(upstream) or not is_ancestor(upstream, "HEAD"):
        rebase(upstream, mode)
    markers(upstream)
    run_check(check, mode)


def rebase_and_check(remote, branch, check):
    """Fetch, rebase onto the remote branch, refuse markers, check."""
    git("fetch", "-q", remote, branch)
    upstream = f"{remote}/{branch}"
    prepare(upstream, check, PUSH)
    return upstream


def locate():
    """This worktree's path, the main tree's, the main tree's branch (None when
    detached), and whether this is the main tree."""
    here = os.path.realpath(out("rev-parse", "--show-toplevel"))
    main_path, main_branch = worktrees()[0]
    return here, main_path, main_branch, os.path.realpath(main_path) == here


def ship(args):
    if git("status", "--porcelain", "--untracked-files=no").stdout:
        raise Stop("There are uncommitted changes: commit or stash them first.")
    if args.local:
        return land(args)
    here, main_path, main_branch, in_main = locate()
    if args.remove and in_main:
        raise Stop(
            "--remove works only on a linked worktree, not the main tree: name one"
            f" with -C, as {worktree_hint(main_path)}."
        )
    branch = args.branch or main_branch
    if not branch:
        raise Stop(
            "The main tree is on a detached HEAD: say which branch with --branch."
        )
    remote = args.remote or "origin"
    git("fetch", "-q", remote, branch)
    upstream = f"{remote}/{branch}"
    if is_ancestor("HEAD", upstream):
        print(f"HEAD is already in {upstream}: nothing to push.")
        return 0
    rebase_and_check(remote, branch, args.check)
    for attempt in range(1, TRIES + 1):
        old = out("rev-parse", upstream)
        pushed = git("push", "-q", remote, f"HEAD:{branch}", check=False)
        if pushed.returncode == 0:
            break
        if not any(sign in pushed.stderr for sign in REJECTED):
            raise Stop(f"The push failed:\n{pushed.stderr.strip()}")
        if attempt == TRIES:
            raise Stop(
                f"Another push won the race {TRIES} times running: run `{RERUN}` again"
                f" once {upstream} is quieter.\n{pushed.stderr.strip()}",
                status=TRY_AGAIN,
            )
        print(
            f"Another push won the race, so rebasing, checking and trying again"
            f" (try {attempt + 1} of {TRIES}):\n{pushed.stderr.strip()}",
            flush=True,
        )
        rebase_and_check(remote, branch, args.check)
    git("fetch", "-q", remote, branch)
    new = out("rev-parse", "HEAD")
    if not is_ancestor(new, upstream):
        raise Stop(f"{upstream} doesn't hold {new[:12]} after the push.")
    report(old, new, PUSH.done, branch, f"to {upstream}")
    if main_branch == branch:
        local = out("rev-parse", f"refs/heads/{branch}")
        if local != new and is_ancestor(local, upstream):
            print(
                f"\nThe main tree ({main_path}) is behind {upstream}: tell the user, who pulls there."
            )
    if args.remove:
        remove(main_path, here)
    return 0


def remove(main_path, here):
    os.chdir(main_path)
    git("worktree", "remove", here)
    print(f"Removed the worktree {here}.")


def changed_places(files):
    """The top-level files and directories among `files`, a directory with how many
    of them it holds, in the order git lists them, so a notice stays short: a skill
    is named by its own folder, since that says which skill changed."""
    # Each place in the order git first lists it; a file's count stays 0.
    counts: dict[str, int] = {}
    for path in files:
        parts = path.split("/")
        if len(parts) == 1:
            counts.setdefault(path, 0)
            continue
        depth = 2 if parts[0] == "skills" and len(parts) > 2 else 1
        folder = "/".join(parts[:depth]) + "/"
        counts[folder] = counts.get(folder, 0) + 1
    return ", ".join(
        f"{place} ({count})" if place.endswith("/") else place
        for place, count in counts.items()
    )


def report(old, new, verb, branch, where):
    subjects = out("log", "--format=%s", "--reverse", f"{old}..{new}").splitlines()
    files = out("diff", "--name-only", old, new).splitlines()
    print(f"{verb.capitalize()} {old[:7]}..{new[:7]} {where}.")
    print("\nNotice for other sessions:")
    print(
        f"FYI: {verb} {old[:7]}..{new[:7]} to {branch}: {'; '.join(subjects)}. Files: {changed_places(files)}."
    )


# The flag that claims a main tree, by the user's global instructions (GLOBAL_CLAUDE.md).
FLAG = "CLAUDE_WORKING"


def exclude_flag(main_path):
    """List FLAG in the main repo's info/exclude, so git never shows or commits it."""
    exclude = common_dir(main_path) / "info" / "exclude"
    exclude.parent.mkdir(exist_ok=True)
    text = exclude.read_text() if exclude.exists() else ""
    if FLAG not in text.splitlines():
        with exclude.open("a") as file:
            file.write(("" if text.endswith("\n") or not text else "\n") + f"{FLAG}\n")


# The queue of sessions waiting to land, in the repo's common git dir (lib/fifo.py).
QUEUE = "wt-ship-queue"


def wait_seconds():
    return float(os.environ.get("WT_SHIP_WAIT", "1800"))


def poll_seconds():
    return float(os.environ.get("WT_SHIP_POLL", "5"))


def common_dir(main_path):
    return Path(
        out("-C", main_path, "rev-parse", "--path-format=absolute", "--git-common-dir")
    )


@contextmanager
def claim(main_path, wait):
    """Hold the main tree's FLAG: kept when it's an old-style flag of this session's,
    made (and removed afterwards, while it still holds this run's text) when free.
    With wait, join the queue and take the flag on this session's turn, giving up
    after WT_SHIP_WAIT seconds; without, stop when it's held or anyone is queued. A
    flag or entry whose process has ended is cleared."""
    exclude_flag(main_path)
    path = Path(main_path) / FLAG
    me = Holder.now(os.environ.get("CLAUDE_CODE_SESSION_ID", "") or "unknown-session")
    folder = common_dir(main_path) / QUEUE
    entry = None
    mine = None
    try:
        try:
            folder.mkdir(exist_ok=True)
            if wait:
                entry = fifo.join(folder, me)
        except OSError as error:
            raise Stop(
                f"Can't use the queue {folder}: {error.strerror}. Fix or remove it, then"
                f" run `{RERUN}` again."
            ) from None
        mine = take(path, folder, me, entry)
        yield
    finally:
        if entry is not None:
            entry.unlink(missing_ok=True)
        if mine is not None:
            fifo.release(path, mine)


def waiters_ahead(folder, entry):
    """The live waiters that joined before entry (all of them, without one), oldest
    first, as (entry path, holder); ended ones are removed."""
    return [(path, Holder.parse(text)) for path, text in fifo.ahead(folder, entry)]


def take(path, folder, me, entry):
    """Take the flag at path: the text it wrote, or None when it kept an old-style flag
    of this session's. Waits its turn in the queue when entry is set."""
    deadline = time.monotonic() + wait_seconds()
    said = None
    while True:
        text = fifo.holder_of(path, folder)
        held = Holder.parse(text) if text is not None else None
        if held is not None and held.session == me.session and held.pid is None:
            return None
        ahead = waiters_ahead(folder, entry)
        if held is None and not ahead:
            if not fifo.take(path, me.line()):
                continue  # another session took it first: look again
            if entry is not None:
                entry.unlink(missing_ok=True)
            return me.line()
        if entry is None or time.monotonic() >= deadline:
            raise Stop(gave_up(path, held, ahead, entry is not None), CLAIMED)
        status = (
            f"{len(ahead)} ahead in the queue, the first {ahead[0][1]}"
            if ahead
            else "first in the queue"
        )
        if held is not None:
            status += f"; the main tree is held by {held}"
        if status != said:
            print(f"Waiting to land: {status}.", flush=True)
            said = status
        time.sleep(poll_seconds())


def gave_up(path, held, ahead, waited):
    """Why --local stopped without the main tree, naming what held it up."""
    seconds = wait_seconds()
    if not waited:
        took = ""
    elif seconds >= 60:
        took = f" after {seconds / 60:.0f} minutes"
    else:
        took = f" after {seconds:.0f} seconds"
    blockers = []
    if held is not None:
        blockers.append(f"the flag {path} ({held})")
    if ahead:
        first, holder = ahead[0]
        blockers.append(f"{len(ahead)} waiting ahead, the first {first} ({holder})")
    return (
        f"Stopped waiting for the main tree{took}: {' and '.join(blockers)}. Tell the user"
        " what held it up and since when, so they can clear one a crashed session left,"
        f" then run `{RERUN}` again."
    )


def merge(main_path, sha):
    """Fast-forward the main tree to sha."""
    run = git("-C", main_path, "merge", "-q", "--ff-only", sha, check=False)
    if run.returncode == 0:
        return
    said = f"{run.stdout}{run.stderr}".strip()
    if "would be overwritten" in said:
        raise Stop(
            "The main tree's uncommitted changes touch files this landing changes, so"
            f" nothing was merged; ask the user:\n{said}",
            SAME_FILES,
        )
    raise Stop(f"git merge --ff-only failed in the main tree:\n{said}")


def land(args):
    """--local: rebase onto the main tree's branch, check, and fast-forward it."""
    if args.remote is not None:
        raise Stop(
            "--local lands on the main tree's branch: --remote doesn't go with it."
        )
    here, main_path, branch, in_main = locate()
    if in_main:
        raise Stop(
            "--local lands a linked worktree on the main tree's branch: name one with"
            f" -C, as {worktree_hint(main_path)}."
        )
    if not branch:
        raise Stop(
            "The main tree is on a detached HEAD: --local has no branch to land on."
        )
    if args.branch and args.branch != branch:
        raise Stop(
            f"--local lands on the branch the main tree has checked out ({branch}),"
            f" not {args.branch}."
        )
    ref = f"refs/heads/{branch}"  # a tag of the same name mustn't stand in for it
    if is_ancestor("HEAD", ref):
        print(f"HEAD is already in {branch}: nothing to land.")
        return 0
    prepare(ref, args.check, LAND)
    with claim(main_path, wait=not args.no_wait):
        # The claim stops other sessions from landing, but the owner, or a tool that
        # doesn't read the flag, may still move the branch: rebase until HEAD holds
        # it, checking each time, at most TRIES checks in all.
        attempt = 1
        while not is_ancestor(ref, "HEAD"):
            arrived = out("log", "--oneline", f"HEAD..{ref}")
            if attempt == TRIES:
                again = f"`{RERUN}`"
                raise Stop(
                    f"{branch} moved during the check {TRIES} times running, so"
                    f" nothing was landed. What arrived last:\n{arrived}\n"
                    f"Find what keeps committing to {branch}, then run {again} again.",
                    status=TRY_AGAIN,
                )
            attempt += 1
            print(
                f"{branch} moved during the check, so rebasing and checking again"
                f" (try {attempt} of {TRIES}).",
                flush=True,
            )
            prepare(ref, args.check, LAND)
        old = out("merge-base", ref, "HEAD")
        new = out("rev-parse", "HEAD")
        merge(main_path, new)
        if not is_ancestor(new, ref):
            raise Stop(f"{branch} doesn't hold {new[:12]} after the merge.")
    report(old, new, LAND.done, branch, f"on {branch} in the main tree ({main_path})")
    if args.remove:
        remove(main_path, here)
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "-C",
        dest="directory",
        metavar="DIR",
        help="run as if started in DIR, the worktree, so the call can start outside it",
    )
    parser.add_argument("--remote", help="the remote (default origin)")
    parser.add_argument(
        "--branch",
        help="the branch to push to (default: the main tree's; --local takes only that)",
    )
    parser.add_argument(
        "--check",
        metavar="CMD",
        help="the check to run before pushing or landing",
    )
    parser.add_argument(
        "--remove",
        action="store_true",
        help="remove this worktree once the push or the landing is confirmed",
    )
    parser.add_argument(
        "--local",
        action="store_true",
        help="land on the main tree's branch instead of pushing (a repo that doesn't push)",
    )
    parser.add_argument(
        "--no-wait",
        action="store_true",
        help="with --local, stop at once when another session holds the main tree",
    )
    args = parser.parse_args(argv)
    global RERUN
    RERUN = shlex.join(["wt-ship", *(sys.argv[1:] if argv is None else argv)])
    if args.directory is not None:
        try:
            os.chdir(args.directory)
        except OSError as error:
            print(
                f"Can't run in {args.directory}: {error.strerror}. Give -C the"
                " worktree's folder.",
                file=sys.stderr,
            )
            return 2
    # A stopped run unwinds like a failed one, so a claim it made is released.
    for stop in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(stop, lambda signum, _frame: sys.exit(128 + signum))
    try:
        return ship(args)
    except Stop as error:
        print(error, file=sys.stderr)
        return error.status


if __name__ == "__main__":
    sys.exit(main())
