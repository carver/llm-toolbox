#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# ///
"""Replace old text with new in files, all or nothing, from blocks on stdin.

  apply-edits <<'EDITS'
  --- src/app.py
  <<<<<<< SEARCH
  old text, exactly as in the file, any number of lines
  =======
  new text (leave empty to delete the old text's lines)
  >>>>>>> REPLACE
  --- README.md
  <<<<<<< SEARCH
  ...
  EDITS

Pick a heredoc delimiter that isn't a line of the blocks: a line EOF in the text ends
<<'EOF' early, and the shell runs the rest as commands.

Each `--- PATH` (relative to the current directory) starts a file's blocks; a file
takes any number, applied in order, each to the text the ones before it left. Every
old text must occur exactly once. If any block misses, nothing is written, and the
block is named with the closest text in the file shown as a diff.

Bare markers, without SEARCH and REPLACE, work too. So does the rest of Aider's
SEARCH/REPLACE format: a bare path on the line before a block instead of `--- PATH`,
and ``` fences around blocks, which are skipped. A marker may end in spaces.

In a Python file (.py, .pyi, or a script whose #! line runs python or `uv run
--script`), an old text not found as it is still matches where it differs only in
formatting that doesn't change the program, as when `ruff format` ran after the old
text was written: spacing between tokens, line breaks inside brackets, trailing commas,
parentheses that change nothing, and the spelling of a string or number with the same
value (quotes, escapes, a u prefix, letter case). Line breaks outside brackets, the
indentation after them and comments must match as they are. A match that takes more
than whitespace needs a file that parses, and counts only where the old text in its
place leaves the same syntax tree, so `(x,)` never matches `(x)`, and `x * (a + b)`
never matches `x * a + b`. Such a match must be unique too, and the output says which
blocks matched this way.

In any other file, an old text not found as it is still matches where it differs only in
whitespace a formatter such as rustfmt or prettier changes, and in a trailing comma, as
when it split a call over lines. Whitespace may come or go next to a bracket or comma,
and before a method chain's `.`. A line break may come or go inside ( or [, after
punctuation other than `)]};?!`, and before a closing bracket, a chain's `.`, `&&`, `||`,
or a `{` after `)`, `]` or `>`. The indentation after a line break may differ, but
outside ( and [ every line must move as far as the first, so a block may move deeper as
a whole, and tabs never stand for spaces. A comma at the end of a line before a closing
bracket may be on one side only, in [ ] or { }, or in ( ) that hold a call's arguments or
another comma, so `(x,)` never matches `(x)`. Anything else must match as it is: spacing
within a line, strings ("...", `...`, '...', triple quotes, Rust's raw strings) and
comments (//, #, /* */), and the whitespace between two words or next to a backslash. An
old text that starts indented matches only at the start of a line, at any depth, and its
replacement goes in as written. Such a match must be unique too, and the output says
which blocks matched this way.

A line that is exactly one of the markers can't appear inside a block; edit such a
line another way. Files keep their line endings (\\n or \\r\\n). A symlink is edited
through to its target.

Exit status: 0 applied, 1 a block didn't apply (nothing written), 2 usage error (bad
input, a missing or unreadable file).
"""

import ast
import difflib
import io
import os
import re
import sys
import tempfile
import tokenize
import warnings
from collections.abc import Iterator
from dataclasses import dataclass, field
from pathlib import Path
from typing import Literal

USAGE = 2
MISSED = 1
OPEN, DIVIDER, CLOSE = "<<<<<<<", "=======", ">>>>>>>"
SPELLINGS = {
    OPEN: {OPEN, f"{OPEN} SEARCH"},
    DIVIDER: {DIVIDER},
    CLOSE: {CLOSE, f"{CLOSE} REPLACE"},
}
"""How each marker may be spelled: bare, or with Aider's label."""
HOW_TO_CLOSE = f"end it with {CLOSE} REPLACE"
EXPECTED = f"expected '--- PATH' or {OPEN} SEARCH"


class UsageError(Exception):
    pass


@dataclass
class Block:
    number: int
    old: str
    new: str


@dataclass
class FileEdits:
    path: Path
    blocks: list[Block] = field(default_factory=list)


def parse(text: str) -> list[FileEdits]:
    """The files and their blocks, in order; a path given twice gets one entry with both
    sections' blocks. Raises UsageError."""
    files: dict[Path, FileEdits] = {}
    current: FileEdits | None = None
    lines = list(enumerate(text.splitlines(), 1))
    at = 0
    while at < len(lines):
        number, line = lines[at]
        at += 1
        found = marker(line)
        if found == OPEN:
            if current is None:
                raise UsageError(f"line {number}: a block before any file's path")
            old, at = until(lines, at, DIVIDER, number)
            new, at = until(lines, at, CLOSE, number)
            if not old.strip():
                raise UsageError(f"line {number}: a block with no old text")
            current.blocks.append(Block(len(current.blocks) + 1, old, new))
        elif (path := header(line, number, opens_block(lines, at))) is not None:
            current = files.setdefault(path.resolve(), FileEdits(path))
        elif line.strip() and not is_fence(line):
            raise UsageError(f"line {number}: {EXPECTED}, got {line!r}")
    edited = [f for f in files.values() if f.blocks]
    if not edited:
        raise UsageError("no blocks on stdin")
    return edited


def header(line: str, number: int, before_block: bool) -> Path | None:
    """The file a line names when it starts a file's blocks: `--- PATH`, or Aider's bare
    path just before a block. Raises UsageError on a header spelled another way, and on
    a bare path to no file."""
    if line.startswith("--- "):
        return Path(line[4:].strip())
    if line.startswith("===") and marker(line) is None:
        raise UsageError(
            f"line {number}: start a file's blocks with '--- PATH', got {line!r}"
        )
    name = line.strip()
    if not before_block or not name or " " in name or is_fence(line):
        return None
    if not Path(name).is_file():
        raise UsageError(f"line {number}: no such file: {name}")
    return Path(name)


def opens_block(lines: list[tuple[int, str]], at: int) -> bool:
    """Whether the next line from `at` that isn't blank or a fence opens a block."""
    for _, line in lines[at:]:
        if line.strip() and not is_fence(line):
            return marker(line) == OPEN
    return False


def is_fence(line: str) -> bool:
    return line.startswith("```")


def marker(line: str) -> str | None:
    """The marker a line is, bare or with Aider's label and trailing spaces, else None."""
    line = line.rstrip()
    return next((mark for mark, spelled in SPELLINGS.items() if line in spelled), None)


def until(
    lines: list[tuple[int, str]], at: int, end: str, start: int
) -> tuple[str, int]:
    """The lines from `at` up to the `end` marker, joined, and the index after it.
    Raises UsageError, saying how to fix the block, when another marker or the end of
    input comes first."""
    taken: list[str] = []
    for number, line in lines[at:]:
        at += 1
        found = marker(line)
        if found == end:
            return "\n".join(taken), at
        if found == DIVIDER:
            raise UsageError(
                f"line {start}: block has a second {DIVIDER} at line {number}; {HOW_TO_CLOSE}"
            )
        if found == CLOSE:
            raise UsageError(
                f"line {start}: block reaches {CLOSE} at line {number} "
                f"with no {DIVIDER} between old and new text"
            )
        if found == OPEN:
            raise UsageError(
                f"line {start}: block not closed before the next {OPEN} at line {number}; "
                f"{HOW_TO_CLOSE}"
            )
        taken.append(line)
    raise UsageError(f"line {start}: block never closed; {HOW_TO_CLOSE}")


def read(path: Path) -> str:
    """The file's text, line endings as they are. Raises UsageError."""
    try:
        with path.open(encoding="utf-8", newline="") as f:
            return f.read()
    except (OSError, UnicodeDecodeError) as e:
        raise UsageError(f"can't read {path} as text: {e}") from e


def applied(edits: FileEdits, text: str) -> tuple[str, list[str], str]:
    """The file's text with its blocks applied, what went wrong with any that missed, and
    a note naming the blocks that matched only loosely ("" for none). Blocks come with
    \\n line breaks; a file with \\r\\n ones gets those."""
    crlf = "\r\n" in text
    python = is_python(edits.path, text)
    ignoring = PYTHON_LOOSELY if python else LAYOUT_LOOSELY
    problems, loose = [], []
    for block in edits.blocks:
        old, new = (block.old, block.new)
        if crlf:
            old, new = old.replace("\n", "\r\n"), new.replace("\n", "\r\n")
        count = text.count(old)
        if count == 1:
            at = text.index(old)
            text = spliced(text, at, at + len(old), new)
            continue
        spans = []
        if count == 0:
            # the Python tokenizer reads \r\n as \n; the generic lexer keeps strings whole
            spans = loose_spans(block.old, text) if python else layout_spans(old, text)
        if len(spans) == 1:
            text = spliced(text, *spans[0], new)
            loose.append(block.number)
            continue
        first = next(line.strip() for line in block.old.splitlines() if line.strip())
        name = f"{edits.path} block {block.number} ({first!r})"
        if len(spans) > 1:
            at = ", ".join(str(line_of(text, start)) for start, _ in spans)
            problems.append(
                f"{name}: found {len(spans)} times (ignoring {ignoring}), at lines {at}; "
                "add context."
            )
        elif count == 0:
            problems.append(f"{name}: old text not found.\n{closest(block.old, text)}")
        else:
            at = ", ".join(str(n) for n in line_numbers(text, old))
            problems.append(f"{name}: found {count} times, at lines {at}; add context.")
    how = f"across {ignoring}" if python else f"ignoring {ignoring}"
    note = f" (block {', '.join(map(str, loose))} matched {how})" if loose else ""
    return text, problems, note


def is_python(path: Path, text: str) -> bool:
    if path.suffix in (".py", ".pyi"):
        return True
    first = text.split("\n", 1)[0]
    return first.startswith("#!") and (
        "python" in first or ("uv run" in first and "--script" in first)
    )


@dataclass
class Token:
    start: int
    end: int
    depth: int  # brackets open after it
    kind: int  # tokenize's token type
    # Its line ends outside brackets: it ends a statement, or it's a comment on a line of
    # its own. The old text must break the line there, at the same indentation.
    ends_line: bool = False


QUIET = {
    tokenize.NL,
    tokenize.NEWLINE,
    tokenize.INDENT,
    tokenize.DEDENT,
    tokenize.ENCODING,
    tokenize.ENDMARKER,
}
FSTRING_START = getattr(tokenize, "FSTRING_START", None)  # Python 3.12 splits f-strings
FSTRING_END = getattr(tokenize, "FSTRING_END", None)


def tokens(text: str) -> list[Token] | None:
    """Python source's tokens, as `scan` yields them; None when the source doesn't
    tokenize."""
    try:
        return list(scan(text))
    except (tokenize.TokenError, SyntaxError):
        return None


def scan(text: str) -> Iterator[Token]:
    """Python source's tokens as offsets into it, an f-string as one STRING, each yielded
    once it's whole. Raises tokenize.TokenError or SyntaxError where the source stops
    tokenizing, so the tokens before that come out first."""
    lines = [0] + [i + 1 for i, c in enumerate(text) if c == "\n"]

    def offset(position: tuple[int, int]) -> int:
        return lines[position[0] - 1] + position[1]

    last: Token | None = None
    depth, fstrings, opened = 0, 0, 0
    for token in tokenize.generate_tokens(io.StringIO(text, newline="").readline):
        if token.type == FSTRING_START:
            opened = offset(token.start) if fstrings == 0 else opened
            fstrings += 1
        elif fstrings:
            if token.type == FSTRING_END:
                fstrings -= 1
                if fstrings == 0:
                    last = Token(opened, offset(token.end), depth, tokenize.STRING)
                    yield last
        elif token.type == tokenize.NEWLINE and last:
            last.ends_line = True
        elif token.type == tokenize.NL and depth == 0 and last:
            last.ends_line |= last.kind == tokenize.COMMENT
        elif token.type not in QUIET:
            if token.type == tokenize.OP:
                depth += (token.string in "([{") - (token.string in ")]}")
            last = Token(offset(token.start), offset(token.end), depth, token.type)
            yield last


def blank_run(text: str, at: int) -> int:
    """The index past the whitespace (backslash continuations included) starting at `at`."""
    while at < len(text):
        if text[at] in " \t\r\n":
            at += 1
        elif text[at] == "\\" and text.startswith(("\n", "\r\n"), at + 1):
            at += 2
        else:
            break
    return at


def indentation(gap: str) -> str:
    return gap[gap.rfind("\n") + 1 :].replace("\r", "")


def match_end(
    text: str, found: list[Token], k: int, old: str
) -> tuple[int, bool] | None:
    """Where in `text` the old text ends, if it matches from token `k` on ignoring
    formatting that doesn't change the Python, and whether that took more than whitespace:
    a comma or parenthesis only one side has, or a literal spelled another way. Then the
    caller must check that the Python is the same.

    Inside a statement the old text may break a line only inside its own brackets or
    after a backslash, and where the file's line ends outside brackets, the old text's
    must too, at the same indentation. A comment needs a line break after it, and two
    words need a space between them.

    A match starts with a token both sides have, except at the start of a statement,
    where ruff may have put parentheses around the targets of an assignment. Either way
    it takes at least one."""
    at, j, relaxed, taken = k, 0, False, False
    at_statement_start = k == 0 or found[k - 1].ends_line
    # Parentheses open that only the file, or only the old text, has.
    file_open = old_open = 0
    # Since the last token taken, the indentation after the file's last line end, and
    # after the old text's last line break outside its brackets; None for none.
    file_break: str | None = None
    old_break: str | None = None
    while True:
        token = found[at] if at < len(found) else None
        part = text[token.start : token.end] if token else ""
        spelled_end = spelling_end(old, j, token, part) if token else None
        was_at, comment = at, False
        if token and spelled_end and not (j and glued(old[j - 1 : j + 1])):
            if file_break != old_break:
                return None
            file_break = old_break = None
            relaxed |= old[j:spelled_end] != part
            j, at, taken = spelled_end, at + 1, True
            comment = token.kind == tokenize.COMMENT
        elif not (taken or at_statement_start):
            return None
        # What only one side has: first the closing of a parenthesis only it opened,
        # then a comma or an opening parenthesis.
        elif part == ")" and file_open:
            at, file_open, relaxed = at + 1, file_open - 1, True
        elif old[j] == ")" and old_open:
            j, old_open, relaxed = j + 1, old_open - 1, True
        elif old[j] in ",(":
            j, old_open, relaxed = j + 1, old_open + (old[j] == "("), True
        elif part in (",", "("):
            at, file_open, relaxed = at + 1, file_open + (part == "("), True
        else:
            return None
        if at > was_at and found[at - 1].ends_line:
            after = found[at].start if at < len(found) else len(text)
            file_break = indentation(text[found[at - 1].end : after])
        blank_end = blank_run(old, j)
        blank = old[j:blank_end]
        if "\n" in blank.replace("\\\n", ""):
            depth = (found[at - 1].depth if at else 0) - file_open + old_open
            if depth <= 0:
                old_break = indentation(blank)
        elif comment and blank_end < len(old):
            return None  # the old text's comment runs on past the file's
        j = blank_end
        if j == len(old):
            break
    while file_open and at < len(found):  # the file's own parentheses close after
        part = text[found[at].start : found[at].end]
        if part not in (",", ")"):
            break
        file_open -= part == ")"
        at += 1
    if file_open or old_open or not taken:
        return None
    return found[at - 1].end, relaxed


def spelling_end(old: str, at: int, token: Token, part: str) -> int | None:
    """Where the old text's spelling of the file's token (its text `part`) ends, when one
    starts at `at`: the same text, or for a string or number, a literal with the same
    value, however its quotes, escapes, prefix or letter case are written."""
    if old.startswith(part, at):
        return at + len(part)
    if token.kind not in (tokenize.STRING, tokenize.NUMBER):
        return None
    try:
        first = next(scan(old[at:]), None)
    except (tokenize.TokenError, SyntaxError):
        return None
    if first is None or first.kind != token.kind:
        return None
    value = syntax_tree(part)
    same = value is not None and syntax_tree(old[at : at + first.end]) == value
    return at + first.end if same else None


def glued(pair: str) -> bool:
    """Whether two characters are both word characters, so a token boundary between them
    would vanish."""
    return bool(re.fullmatch(r"\w\w", pair))


def syntax_tree(source: str) -> str | None:
    """The syntax tree Python reads from the source, dumped, or None when it doesn't
    parse. A string's u prefix, which changes nothing, is left out."""
    try:
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")  # invalid escapes and the like
            tree = ast.parse(source)
    except (SyntaxError, ValueError, RecursionError):
        return None
    for node in ast.walk(tree):
        if isinstance(node, ast.Constant):
            node.kind = None
    return ast.dump(tree)


def loose_spans(old: str, text: str) -> list[tuple[int, int]]:
    """Where in `text` (Python) the old text occurs, ignoring formatting that doesn't
    change the Python: each match's start and end. An old text that starts indented
    matches only a line that starts with that indentation, which the match takes in. A
    match that took more than whitespace counts only when the file, with the old text in
    its place, parses to the same syntax tree."""
    found = tokens(text)
    old = old.rstrip()
    lead = old[: len(old) - len(old.lstrip(" \t"))]
    body = old[len(lead) :]
    if found is None or not body:
        return []
    matches = []
    for k, token in enumerate(found):
        line = text.rfind("\n", 0, token.start) + 1
        if lead and text[line : token.start] != lead:
            continue
        if (matched := match_end(text, found, k, body)) is not None:
            matches.append((line if lead else token.start, *matched))
    if any(relaxed for _, _, relaxed in matches):
        tree = syntax_tree(text)
        matches = [
            (start, end, relaxed)
            for start, end, relaxed in matches
            if not relaxed
            or tree is not None
            and syntax_tree(text[:start] + old + text[end:]) == tree
        ]
    return [(start, end) for start, end, _ in matches]


PYTHON_LOOSELY = "formatting that doesn't change the Python"
LAYOUT_LOOSELY = "whitespace and trailing commas"
"""What a loose match ignores, in a Python file and in any other."""


@dataclass
class Lexeme:
    start: int
    end: int
    kind: Literal[
        "word", "string", "comment", "mark"
    ]  # a mark: one punctuation character
    text: str

    @property
    def wordish(self) -> bool:
        return self.kind in ("word", "string")


LEXEME = re.compile(
    r"""
    (?P<comment> //[^\n]* | \#[^\n]* | /\*.*?(?:\*/|\Z) )
  | (?P<string>
        r(?P<hashes>\#*)".*?(?:"(?P=hashes)|\Z)
      | (?P<triple>'''|\"\"\").*?(?:(?P=triple)|\Z)
      | "(?:\\.|[^"\\])*(?:"|\Z)
      | `(?:\\.|[^`\\])*(?:`|\Z)
      | '(?:\\.|[^'\\\n])*'
    )
  | (?P<word> \w+ )
  | (?P<mark> \S )
    """,
    re.VERBOSE | re.DOTALL,
)
"""The lexemes of a file in no language in particular. A string in " or `, triple quotes,
or Rust's raw r"..." and r#"..."# may span lines, and runs to the end of the text when it
isn't closed; a ' string stays on its line, else the ' is a mark (an apostrophe, a Rust
lifetime)."""

OPENERS = {"(": ")", "[": "]", "{": "}"}


def lexemes(text: str) -> list[Lexeme]:
    found = []
    for match in LEXEME.finditer(text):
        kind = match.lastgroup
        if kind not in ("comment", "word", "mark"):
            kind = "string"  # the last group to close may be one inside a string's
        body = match.group().rstrip() if kind == "comment" else match.group()
        found.append(Lexeme(match.start(), match.start() + len(body), kind, body))
    return found


@dataclass
class Bracket:
    """A bracket opened inside a layout match."""

    opener: str
    call: bool  # a `(` straight after a name, a `!`, a `>` or a closer: a call's arguments
    commas: int = 0  # at its own level


@dataclass
class Indents:
    """The indentation of the match's first line in the file and in the old text, which
    every later line start outside brackets must keep its shift from."""

    file: str
    old: str

    def keep(self, file: str, old: str) -> bool:
        """Whether a line indented `file` in the file and `old` in the old text sits as
        deep, against the first line, on both sides: tabs and spaces never stand in for
        each other."""
        if file == old and self.file == self.old:
            return True
        uniform = len(set(file + old + self.file + self.old)) <= 1
        return uniform and len(file) - len(old) == len(self.file) - len(self.old)


def gaps_agree(
    file_gap: str,
    old_gap: str,
    a: Lexeme,
    b: Lexeme,
    after: Lexeme | None,
    inside: bool,
) -> bool:
    """Whether the whitespace between lexemes `a` and `b` (`after` follows `b`) may be
    `file_gap` in the file and `old_gap` in the old text. `inside` says whether the
    innermost bracket the match opened is a ( or [.

    On one line a gap must match as it is. Whether there is one may differ next to a
    bracket or comma, or before a method chain's `.`; whether it breaks the line may
    differ inside ( or [, after a mark other than `)]};?!`, or before a closer, a chain's
    `.`, `&&`, `||`, or a `{` after `)`, `]` or `>`. Next to a comment or a backslash, and
    between two words or strings, neither may."""
    if file_gap == old_gap:
        return True
    spaced = bool(file_gap) != bool(old_gap)
    broken = ("\n" in file_gap) != ("\n" in old_gap)
    if not (spaced or broken):
        return "\n" in file_gap  # the indentation after a line break may differ
    if "comment" in (a.kind, b.kind) or "\\" in (a.text, b.text):
        return False
    if a.wordish and b.wordish:
        return False
    chain = (
        b.text == "."
        and after is not None
        and after.kind == "word"
        and after.start == b.end
    )
    if spaced and not (chain or a.text in ",()[]{}" or b.text in ",()[]{}"):
        return False
    doubled = (
        b.text in "&|"
        and after is not None
        and after.text == b.text
        and after.start == b.end
    )
    return (
        not broken
        or inside
        or (a.kind == "mark" and a.text not in ")]};?!")
        or b.text in ")]}"
        or chain
        or doubled
        or (b.text == "{" and a.text in ")]>")
    )


def layout_end(
    text: str,
    found: list[Lexeme],
    k: int,
    old: str,
    wanted: list[Lexeme],
    indents: Indents,
) -> int | None:
    """Where in `text` the old text ends, if its lexemes `wanted` match the file's from
    lexeme `k` on, with gaps between them that `gaps_agree` allows, line starts outside
    brackets that keep their indentation's shift (`indents`), and trailing commas only
    one side has (`trailing_comma`)."""
    i, j = k, 0
    brackets: list[Bracket] = []
    joined = False  # no gap before the current lexeme on either side, and one before it
    while True:
        lexeme = found[i]
        if lexeme.text in OPENERS:
            call = (
                joined
                and lexeme.text == "("
                and (found[i - 1].kind == "word" or found[i - 1].text in ")]!>")
            )
            brackets.append(Bracket(lexeme.text, call))
        elif brackets and lexeme.text == OPENERS[brackets[-1].opener]:
            brackets.pop()
        elif lexeme.text == "," and brackets:
            brackets[-1].commas += 1
        if j + 1 == len(wanted):
            return lexeme.end
        if i + 1 == len(found):
            return None
        file_gap = text[lexeme.end : found[i + 1].start]
        old_gap = old[wanted[j].end : wanted[j + 1].start]
        skipped = skip_comma((text, found, i + 1), (old, wanted, j + 1), brackets)
        if skipped is None:
            return None
        i, j = skipped
        inside = bool(brackets) and brackets[-1].opener != "{"
        after = found[i + 1] if i + 1 < len(found) else None
        if not gaps_agree(file_gap, old_gap, lexeme, found[i], after, inside):
            return None
        line_start = "\n" in file_gap and "\n" in old_gap and not inside
        if line_start and not indents.keep(indentation(file_gap), indentation(old_gap)):
            return None
        joined = not file_gap and not old_gap


Place = tuple[str, list[Lexeme], int]
"""A source, its lexemes, and the index of one of them."""


def skip_comma(
    file: Place, old: Place, brackets: list[Bracket]
) -> tuple[int, int] | None:
    """The indexes of the file's and the old text's next lexemes, as given or past a
    trailing comma only one side has; None when they differ otherwise."""
    (_, found, i), (_, wanted, j) = file, old
    if found[i].text == wanted[j].text:
        return i, j
    if trailing_comma(file, wanted[j].text, brackets):
        return i + 1, j
    if trailing_comma(old, found[i].text, brackets):
        return i, j + 1
    return None


def trailing_comma(place: Place, closer: str, brackets: list[Bracket]) -> bool:
    """Whether the lexeme at `place` is a trailing comma the other side lacks, before
    `closer`: one at the end of its line before the closer, as formatters add when they
    split brackets over lines. In parentheses, only where they hold a call's arguments,
    or another comma, so that `(x,)` never matches `(x)`."""
    source, lexed, at = place
    if lexed[at].text != "," or at + 1 == len(lexed) or lexed[at + 1].text != closer:
        return False
    if "\n" not in source[lexed[at].end : lexed[at + 1].start]:
        return False
    if not brackets or OPENERS[brackets[-1].opener] != closer:
        return False
    return closer != ")" or brackets[-1].call or brackets[-1].commas > 0


def layout_spans(old: str, text: str) -> list[tuple[int, int]]:
    """Where in `text` (any file but Python) the old text occurs, ignoring differences in
    whitespace that can't change what the file means, and trailing commas a formatter
    adds or drops: each match's start and end. An old text that starts indented matches
    only a lexeme that starts its line, and the match takes in the line's indentation,
    however deep; one that starts with a line break matches nothing."""
    old = old.rstrip()
    body = old.lstrip(" \t")
    lead = old[: len(old) - len(body)]
    wanted = lexemes(old)
    if not wanted or body.startswith(("\n", "\r")):
        return []
    found = lexemes(text)
    spans = []
    for k, lexeme in enumerate(found):
        if lexeme.text != wanted[0].text:
            continue
        line = text.rfind("\n", 0, lexeme.start) + 1
        before = text[line : lexeme.start]
        if lead and before.strip():
            continue
        indents = Indents(before[: len(before) - len(before.lstrip(" \t"))], lead)
        if not indents.keep(indents.file, indents.old):
            continue
        if (end := layout_end(text, found, k, old, wanted, indents)) is not None:
            spans.append((line if lead else lexeme.start, end))
    return spans


def spliced(text: str, start: int, end: int, new: str) -> str:
    """The text with new in place of start to end. Deleting whole lines takes the line
    break after them too."""
    if not new and (start == 0 or text[start - 1] == "\n"):
        for newline in ("\r\n", "\n"):
            if text.startswith(newline, end):
                end += len(newline)
                break
    return text[:start] + new + text[end:]


def line_of(text: str, index: int) -> int:
    return text.count("\n", 0, index) + 1


def line_numbers(text: str, part: str) -> list[int]:
    numbers, start = [], 0
    while (index := text.find(part, start)) >= 0:
        numbers.append(line_of(text, index))
        start = index + len(part)
    return numbers


def closest(old: str, text: str) -> str:
    """The run of the file's lines most like `old`, as a diff from it: "-" lines are
    the old text's, "+" lines the file's."""
    wanted = old.splitlines()
    lines = text.splitlines()
    size = min(len(wanted), len(lines))
    if size == 0:
        return "  (the file is empty)"
    best, best_at = 0.0, 0
    for at in range(len(lines) - size + 1):
        window = "\n".join(lines[at : at + size])
        ratio = difflib.SequenceMatcher(None, old, window).ratio()
        if ratio > best:
            best, best_at = ratio, at
    found = lines[best_at : best_at + size]
    diff = difflib.unified_diff(wanted, found, lineterm="", n=len(wanted))
    shown = "\n".join(
        f"  {line}" for line in diff if not line.startswith(("---", "+++", "@@"))
    )
    return f"  closest is lines {best_at + 1}-{best_at + size} ({best:.0%} alike):\n{shown}"


def staged(path: Path, text: str) -> str:
    """A temp file beside the file's real target, holding the new text with the file's
    permissions, ready to rename into place."""
    target = path.resolve()
    fd, temp = tempfile.mkstemp(dir=target.parent, prefix=f".{target.name}.")
    with os.fdopen(fd, "w", encoding="utf-8", newline="") as f:
        f.write(text)
    os.chmod(temp, target.stat().st_mode)
    return temp


def main() -> int:
    if len(sys.argv) > 1:
        asked = sys.argv[1] in ("-h", "--help")
        print(__doc__, file=sys.stdout if asked else sys.stderr)
        return 0 if asked else USAGE
    try:
        files = parse(sys.stdin.read())
        for edits in files:
            if not edits.path.is_file():
                raise UsageError(f"no such file: {edits.path}")
        texts = [read(edits.path) for edits in files]
    except UsageError as e:
        print(f"apply-edits: {e}", file=sys.stderr)
        return USAGE
    results, problems = [], []
    for edits, text in zip(files, texts, strict=True):
        new_text, missed, note = applied(edits, text)
        results.append((edits, new_text, note))
        problems += missed
    if problems:
        print("\n".join(problems) + "\nNothing was written.", file=sys.stderr)
        return MISSED
    temps = []
    try:
        for edits, text, _ in results:
            temps.append((staged(edits.path, text), edits.path.resolve()))
    except OSError as e:
        for temp, _ in temps:
            os.unlink(temp)
        print(f"apply-edits: {e}\nNothing was written.", file=sys.stderr)
        return USAGE
    for (temp, target), (edits, _, note) in zip(temps, results, strict=True):
        os.replace(temp, target)
        count = len(edits.blocks)
        print(f"{edits.path}: {count} edit{'' if count == 1 else 's'}{note}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
