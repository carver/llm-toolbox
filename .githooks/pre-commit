#!/bin/sh
# Agents' commits also run the slower agent-pre-commit (llm-toolbox agent-commit-gate).
if [ -n "${AI_AGENT:-}" ] && [ -z "${AGENT_PRE_COMMIT:-}" ]; then AGENT_PRE_COMMIT=1 "$(dirname "$0")/agent-pre-commit" || exit; fi
# Lint and format-check what's staged, in about a second. Enabled by install.py (core.hooksPath).
# The test suite is too slow for this; agent-pre-commit runs it.
set -e
command -v uv >/dev/null || { echo "pre-commit: needs uv on PATH; install uv: https://docs.astral.sh/uv/" >&2; exit 1; }
tree=$(mktemp -d)
trap 'rm -rf "$tree"' EXIT
# Check the staged snapshot, not the working tree, without touching either.
git checkout-index -a --prefix="$tree/"
cd "$tree"
# uv, not a .venv: the repo is shared by machines whose Pythons differ.
uv_tools="uv run -q --no-project --with-requirements requirements-dev.txt"
$uv_tools ruff check --quiet .
$uv_tools ruff format --check --quiet .
