#!/usr/bin/env python3
"""A Claude Code PreToolUse hook that refuses a Bash call waiting on heavy in the foreground.

heavy waits its turn in a queue every session shares, then for quiet cores, with no
time limit, and a Bash call that waits on it is killed at the tool's own limit. So
the hook refuses a Bash call that runs `heavy -- CMD` unless the call was made with
run_in_background: true, and names the right form: `bgrun --wait -o LOG -- heavy --
CMD` as a background call. Background call or not, it refuses heavy around bgrun
(`heavy -- bgrun ...`), and around git commit and wt-ship, which queue their own
checks and run bare. install.py registers it in ~/.claude/settings.json.

It reads the command as shell words and looks only at what runs: each simple command's
command word, past variable settings, redirections, keywords such as `if` and `do`, and
wrappers such as timeout, nice, env, nohup, sudo and xargs; the script of `bash -c`,
`eval` and a heredoc fed to a shell; $(...) and backticks outside single quotes; and
<(...) and >(...) outside quotes. A word that only mentions heavy (`grep heavy`, a
commit message, a heredoc's body, a comment, a path such as .../heavy-queue-race)
passes. So do `heavy status` and `heavy -h`, which return at once; `bgrun -o LOG --
heavy -- CMD` without --wait, which returns once CMD has started; and a heavy with
HEAVY_DIR or HEAVY_SLOT set in front of it, which uses a queue of its own or runs inside
a job. A command shlex can't parse, such as one with a quote left open, is split without
regard to quotes, which errs toward refusing.

    heavy-gate < hook-input.json    # as Claude Code calls it

Exit status: 0 allowed, 2 refused (the reason on stderr), 1 input that isn't JSON.
"""

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from shellparse import (
    SHELLS,
    bgrun_command,
    command_of,
    commands,
    commit_args,
    is_help,
    prepare,
    reads_stdin,
    shell_script,
)

RIGHT_FORM = (
    "bgrun --wait -o <scratchpad>/LOG -- heavy -- CMD, as a background call "
    "(run_in_background: true)"
)
FOREGROUND = (
    "Refused: heavy waits its turn with no time limit, and a Bash call that waits on it "
    f"is killed at the tool's limit. Run {RIGHT_FORM}.\n"
    "Where a background call can't notify you, drop --wait, then wait with "
    "`waitone --pid PID -t 300` and read LOG."
)
WRONG_ORDER = f"Refused: heavy goes inside bgrun, not around it: {RIGHT_FORM}."
RUN_BARE = "Refused: git commit and wt-ship queue their own checks; run them bare, not under heavy."
# Most specific first: the first that applies is the one printed.
REFUSALS = (RUN_BARE, WRONG_ORDER, FOREGROUND)

# Set in front of heavy, these give it a queue of its own or put it inside a job.
OWN_QUEUE = {"HEAVY_DIR", "HEAVY_SLOT"}


def refusals(command: str, blocks: bool) -> set[str]:
    """The refusals a shell command earns. ``blocks``: the Bash call waits for it."""
    cleaned, substitutions, heredocs = prepare(command)
    found = set()
    for simple in commands(cleaned):
        found |= judge(simple.words, blocks)
    for substitution in substitutions:
        found |= refusals(substitution, blocks)
    for opener, body in heredocs:
        opened = commands(prepare(opener)[0])
        if any(reads_stdin(simple.words) for simple in opened):
            found |= refusals(body, blocks)
    return found


def judge(words: list[str], blocks: bool) -> set[str]:
    """The refusals one simple command earns."""
    words, assigned = command_of(words)
    if not words:
        return set()
    name, args = Path(words[0]).name, words[1:]
    if name in SHELLS:
        script = shell_script(words)
        return refusals(script, blocks) if script is not None else set()
    if name == "eval":
        return refusals(" ".join(args), blocks)
    if name == "bgrun":
        parsed = bgrun_command(args)
        if parsed is None:
            return set()
        waits, rest = parsed
        return judge(rest, blocks and waits)
    if name != "heavy" or assigned & OWN_QUEUE:
        return set()
    queued = heavy_command(args)
    if queued is None:
        return set()
    inner, _ = command_of(queued)
    inner_name = Path(inner[0]).name if inner else ""
    commits = inner_name == "git" and commit_args(inner[1:]) is not None
    if inner_name == "wt-ship" or commits:
        return {RUN_BARE}
    if inner_name == "bgrun":
        return {WRONG_ORDER}
    return {FOREGROUND} if blocks else set()


def heavy_command(args: list[str]) -> list[str] | None:
    """The command heavy queues to run, or None when heavy returns at once: `status`,
    help, or a usage error. An expansion among the arguments, as in `heavy "$@"`, could
    be anything, so heavy counts as queueing it."""
    for i, word in enumerate(args):
        if word == "--":
            return args[i + 1 :] or None
        if is_help(word):
            return None
    return args if any("$" in word for word in args) else None


def main(argv=None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if any(arg in ("-h", "--help") for arg in argv):
        print(__doc__)
        return 0
    try:
        event = json.load(sys.stdin)
    except json.JSONDecodeError as error:
        print(
            f"heavy-gate: the hook input isn't JSON ({error}); it reads the PreToolUse "
            "event Claude Code sends on stdin.",
            file=sys.stderr,
        )
        return 1
    if event.get("tool_name") != "Bash":
        return 0
    tool_input = event.get("tool_input") or {}
    background = tool_input.get("run_in_background") in (True, "true")
    found = refusals(tool_input.get("command") or "", blocks=not background)
    for refusal in REFUSALS:
        if refusal in found:
            print(refusal, file=sys.stderr)
            return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
