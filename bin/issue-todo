#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# ///
"""A GitHub issue's task-list items, across its body and its comments, and ticking one.

`gh issue view N` prints the body without the comments, and `--comments` the comments
without the body, so a to-do list split between them reads as two partial lists.
`show` prints every item in one place; `tick` checks one off where it lives; `open`
prints every open issue's open items, leaving out pull requests and ticked items.
`open --titles` prints one line per open issue instead: its number, its title, how
many open items and sub-issues it has, if any, and who claims it, if anyone. That is
enough to find an issue by its subject, and to see which ones another session holds.
`unticked N...` prints each unticked item as `#N TEXT`, one a line, for a script:
wt-ship lists them for each issue a landing closes.

    issue-todo open
    issue-todo open --titles          # "#16 Site design (3 open items) [claimed by f3f9b997]"
                                      # "#142 Targets (5 sub-issues, 0 closed)"
    issue-todo show 42
    issue-todo read 42 43             # body and every comment, which gh splits in two
    issue-todo unticked 42 43         # each unticked item, as "#42 TEXT", one a line
    issue-todo claim 42               # refuses while another session holds a claim
    issue-todo release 42
    issue-todo claims                 # "#41  5c618940  3h  Beta backups", one a claim
    issue-todo tick 42 "forecast measure" --note "built in 8d5068e"
    issue-todo tick 42 "Add hub" --undo
    issue-todo tick 42 "Add hub" --dropped "moved to #50"   # "- [x] ~~Add hub~~ *dropped: moved to #50*"
    issue-todo tick 42 "Add hub" --dry-run

An item is a list line with a box, `- [ ] text`, `1. [x] text` and the like, outside
fenced code. `tick` finds the one open item (a ticked one with --undo) whose text
contains MATCH, or equals it, in the body or any comment, ticks it, appends ` *NOTE*`,
and writes that body or comment back, unless it changed since it was read. With
--dropped it ticks an item that won't be done, so no count includes it, and strikes
its text through, with the reason after it; --undo on a dropped item clears only its
box, as it leaves a note. No match,
or several, writes nothing and lists the candidates. It calls `gh`, so it acts as
gh's logged-in user, in the current directory's repo unless --repo names one.

`show` and `read` end with the issue's relatives, each section only when it has a line:
`--- parent`, the issue it is a sub-issue of; `--- sub-issues`, in GitHub's order; and
`--- mentions`, each other issue or pull request of the repo that it mentions as `#N`
outside code, in order. Each line gives the state, the count of open items, the title
and any standing claim, such as
`#25 open, 1 open item: Agents offer to post [claimed by f0436b8b]`. A closed issue
or a merged pull request shows no claim, and counts its unticked items as such,
`#96 closed, 1 unticked item: ...`, since one there may be work lost. One in another
repo is `OWNER/REPO#N state: title`, and a parent there just `OWNER/REPO#N`. No issue
is listed twice. One GraphQL call fetches
them all, and only an issue with sub-issues costs one REST call more, so a plan issue
tells which of its steps are done.

Run in a clone of the issue's repo, they then end with `--- landed since #N was
opened (main, origin/main)`: each commit on the default branch, here or on its
remote, committed since the issue was opened, no merge, that mentions `#N` or touches
a path the issue names in backticks (one the clone has, a `path:line` as its path),
oldest first, as `SHA DATE SUBJECT (mentions #N; touches PATH, ...)`, at most 15,
then the `git log` that lists the rest. Work planned from an issue's numbers may
already be done: a fix that landed after the issue was opened shows here. Outside a
clone of the repo, or when git fails, the section is left out.

`claim` and `release` keep a claim in the issue's comments, each with a hidden marker
`<!-- issue-todo claim ID -->` (or `release`), so two sessions don't both take one
issue. ID is the session's name: --as NAME, else $CLAUDE_CODE_SESSION_ID's first 8
characters. `claim` refuses while a claim by another ID stands unreleased.
`claims` lists the claims standing on open issues, one a line, as
`#N  ID  AGE  TITLE`, AGE floored to `45m`, `3h` or `2d`, and prints nothing when
none stands. It costs one GraphQL call per 100 open issues, plus a REST listing for
each issue with over 100 comments.
"""

import argparse
import json
import os
import re
import subprocess
import sys
from collections.abc import Iterator
from dataclasses import dataclass
from datetime import UTC, datetime

BOX = re.compile(r"^(\s*(?:[-*+]|\d+[.)])\s+\[)([ xX])(\]\s+)(.*)$")
FENCE = re.compile(r"^\s*(`{3,}|~{3,})")
WIDTH = 100  # show cuts an item's text to this many characters
# `#N`, but not `owner/repo#N`, `a#N` or an HTML entity's `&#N`.
MENTION = re.compile(r"(?<![\w/&])#(\d+)\b")
INLINE_CODE = re.compile(r"(`+).+?\1", re.DOTALL)  # within one paragraph
PARAGRAPH_BREAK = re.compile(r"\n[ \t]*\n")


@dataclass(frozen=True)
class Item:
    line: int  # its line's index in the markdown, split on "\n"
    done: bool
    text: str


@dataclass(frozen=True)
class Part:
    """The issue's body, or one of its comments: where items live, and where a tick is written."""

    label: str  # "body", or "comment ID AUTHOR DATE"
    path: str  # its REST path, to read it again and to write it back
    markdown: str


def outside_fences(markdown: str) -> Iterator[tuple[int, str]]:
    """Each line of `markdown` outside fenced code, with its index, without its "\\r". A
    fence closes only on a fence of its own character, at least as long."""
    fence = None
    for i, line in enumerate(markdown.split("\n")):
        line = line.removesuffix("\r")
        if m := FENCE.match(line):
            mark = m.group(1)
            if fence is None:
                fence = mark
            elif mark[0] == fence[0] and len(mark) >= len(fence):
                fence = None
        elif fence is None:
            yield i, line


def items(markdown: str) -> list[Item]:
    """The task-list items in `markdown`, in order, leaving out lines in fenced code."""
    return [
        Item(i, m.group(2) != " ", m.group(4))
        for i, line in outside_fences(markdown)
        if (m := BOX.match(line))
    ]


def tick(
    markdown: str,
    item: Item,
    note: str | None,
    undo: bool = False,
    dropped: str | None = None,
) -> str:
    """`markdown` with the item's box ticked (or cleared, with `undo`) and ` *NOTE*`
    after its text. A `dropped` item is ticked with its text struck through and
    ` *dropped: WHY*` after it. The line keeps its ending, "\\r\\n" included."""
    lines = markdown.split("\n")
    line = lines[item.line]
    cr = "\r" if line.endswith("\r") else ""
    m = BOX.match(line.removesuffix("\r"))
    assert m, f"line {item.line} holds no task-list item"
    text = m.group(4)
    if dropped is not None:
        # GitHub closes no ~~ that follows a space.
        text = f"~~{text.rstrip()}~~ *dropped: {dropped}*"
    elif note:
        text += f" *{note}*"
    lines[item.line] = f"{m.group(1)}{' ' if undo else 'x'}{m.group(3)}{text}{cr}"
    return "\n".join(lines)


def reason(text: str) -> str:
    """--dropped's WHY: an item struck with no reason says nothing of why."""
    if not text.strip():
        raise argparse.ArgumentTypeError("give a reason")
    return text.strip()


def short(text: str) -> str:
    return text if len(text) <= WIDTH else text[: WIDTH - 1] + "…"


def gh(*args: str, stdin: str | None = None, check: bool = True) -> str:
    """gh's output; exits with gh's message when it fails, unless `check` is off."""
    r = subprocess.run(
        ["gh", *args], input=stdin, capture_output=True, text=True, check=False
    )
    if r.returncode != 0 and not check and not r.stdout.strip():
        print(
            f"issue-todo: gh {' '.join(args[:2])}: {r.stderr.strip()[-300:]}",
            file=sys.stderr,
        )
    if r.returncode != 0 and check:
        sys.exit(
            f"issue-todo: gh {' '.join(args[:3])} failed: {r.stderr.strip()[-300:]}"
        )
    return r.stdout


def parts(repo: str, number: int) -> tuple[dict, list[Part]]:
    """The issue, and its body and comments as parts, in order."""
    issue = json.loads(gh("api", f"repos/{repo}/issues/{number}"))
    return issue, issue_parts(repo, issue)


def issue_parts(repo: str, issue: dict) -> list[Part]:
    """The issue's body and comments as parts, in order. The issue as GitHub serves it,
    alone or in a listing, carries its comment count, so one with none costs no call."""
    number = issue["number"]
    if issue.get("comments") == 0:  # a missing count fetches them
        comments = []
    else:
        comments = json.loads(
            gh("api", "--paginate", f"repos/{repo}/issues/{number}/comments")
        )
    found = [Part("body", f"repos/{repo}/issues/{number}", issue.get("body") or "")]
    for c in comments:
        label = f"comment {c['id']} {c['user']['login']} {c['created_at'][:10]}"
        found.append(
            Part(label, f"repos/{repo}/issues/comments/{c['id']}", c.get("body") or "")
        )
    return found


def show(repo: str, number: int) -> int:
    issue, found = parts(repo, number)
    print(f"#{issue['number']} {issue['title']} ({issue['state']})")
    for part in found:
        listed = items(part.markdown)
        if not listed:
            continue
        print(part.label)
        for i, item in enumerate(listed, 1):
            print(f"  [{'x' if item.done else ' '}] {i}  {short(item.text)}")
    print_related(repo, issue, found)
    print_landed(repo, issue, found)
    return 0


def prose(markdown: str) -> str:
    """`markdown` without its fenced code blocks and inline code spans. A code span
    ends at its paragraph's end, so a stray backtick hides nothing past it."""
    text = "\n".join(line for _, line in outside_fences(markdown))
    return "\n\n".join(INLINE_CODE.sub("", p) for p in PARAGRAPH_BREAK.split(text))


def mentions(markdown: str) -> list[int]:
    """The issue numbers `markdown` mentions as `#N`, in order of first mention, leaving
    out code and another repo's `owner/repo#N`."""
    return list(dict.fromkeys(int(n) for n in MENTION.findall(prose(markdown))))


def lookup(repo: str, numbers: list[int]) -> dict[int, str] | None:
    """A line for each of `numbers` that names an issue or pull request in `repo`: its
    state, its unticked items if it has any ("open" while it is open), its title, and,
    while it is open, the claims standing on it. One
    GraphQL call fetches them all. None when the call fails; a number that names
    nothing is left out."""
    owner, name = repo.split("/", 1)
    fields = "state title body comments(first: 100) { nodes { body } }"
    asked = " ".join(
        f"m{n}: issueOrPullRequest(number: {n}) "
        f"{{ ... on Issue {{ {fields} }} ... on PullRequest {{ {fields} }} }}"
        for n in numbers
    )
    query = f"query {{ repository(owner: {json.dumps(owner)}, name: {json.dumps(name)}) {{ {asked} }} }}"
    # A number that names nothing makes gh exit 1, with the rest of the answer intact.
    out = gh("api", "graphql", "-f", f"query={query}", check=False)
    try:
        found = json.loads(out)["data"]["repository"]
    except (ValueError, KeyError, TypeError):
        return None
    lines = {}
    for n in numbers:
        node = found.get(f"m{n}")
        if not node:
            continue
        comments = [c.get("body") or "" for c in node["comments"]["nodes"]]
        texts = [node.get("body") or ""] + comments
        n_open = sum(not item.done for text in texts for item in items(text))
        # On a closed issue an unticked item is no work in progress, maybe work lost,
        # and a claim no longer holds anything.
        is_open = node["state"] == "OPEN"
        kind = "open" if is_open else "unticked"
        count = f", {n_open} {kind} item{'s' if n_open > 1 else ''}" if n_open else ""
        who = claimed_by(comments) if is_open else ""
        lines[n] = f"#{n} {node['state'].lower()}{count}: {node['title']}{who}"
    return lines


def repo_of(api_url: str) -> str:
    """`OWNER/REPO` of a REST URL such as `https://api.github.com/repos/o/r/issues/4`."""
    return "/".join(api_url.split("/repos/", 1)[1].split("/")[:2])


def sub_issues(repo: str, issue: dict) -> list[dict]:
    """The issue's sub-issues, in GitHub's order. Its summary says how many, so an
    issue with none costs no call."""
    number = issue["number"]
    if not (issue.get("sub_issues_summary") or {}).get("total"):
        return []
    out = gh(
        "api", "--paginate", f"repos/{repo}/issues/{number}/sub_issues", check=False
    )
    try:
        return json.loads(out)
    except ValueError:
        print(f"issue-todo: couldn't list #{number}'s sub-issues", file=sys.stderr)
        return []


GITHUB_REMOTE = re.compile(
    r"^(?:https://github\.com/|git@github\.com:|ssh://git@github\.com/)"
    r"([^/]+/[^/]+?)(?:\.git)?/?$",
    re.IGNORECASE,
)
# A word in backticks: a path, when the clone has it.
NAMED_PATH = re.compile(r"`([^`\s]+)`")
LANDED_LINES = 15


def github_repo(url: str) -> str | None:
    """The OWNER/REPO a GitHub remote URL names, lowercased; None for another host."""
    match = GITHUB_REMOTE.match(url.strip())
    return match.group(1).lower() if match else None


def git(*args: str) -> str | None:
    """A git command's output in the current directory, or None when it fails."""
    try:
        done = subprocess.run(
            ["git", *args], check=False, capture_output=True, text=True
        )
    except OSError:
        return None
    return done.stdout if done.returncode == 0 else None


def clone_refs(repo: str) -> list[str]:
    """The current directory's default branch and its remote's, when the directory is
    a clone of `repo`: each that exists, the local branch first. None of them in a
    clone of another repo, outside any, or in a shallow clone, which lacks commits."""
    if (git("rev-parse", "--is-shallow-repository") or "").strip() == "true":
        return []
    for remote in (git("remote") or "").split():
        if github_repo(git("remote", "get-url", remote) or "") != repo.lower():
            continue
        head = git("symbolic-ref", "--short", f"refs/remotes/{remote}/HEAD") or ""
        branch = head.strip().split("/", 1)[1] if "/" in head else "main"
        return [
            ref
            for ref in (branch, f"{remote}/{branch}")
            if git("rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}") is not None
        ]
    return []


def named_paths(markdown: str, refs: list[str]) -> list[str]:
    """The paths `markdown` names in backticks that exist at a tip of `refs`, as a file
    or a folder, in order of first mention; a `path:line` counts as its path."""
    paths: list[str] = []
    for token in NAMED_PATH.findall(markdown):
        path = re.sub(r":\d+(?:-\d+)?$", "", token).removeprefix("./").rstrip("/")
        # An empty one names the root tree, which every tip has, and an empty
        # pathspec makes the whole `git log` fail.
        if not path or path in paths:
            continue
        if any(git("cat-file", "-e", f"{ref}:{path}") is not None for ref in refs):
            paths.append(path)
    return paths


def mention(number: int) -> str:
    """The extended regex for a commit message that mentions #`number` of this repo:
    not #`number`0, nor another repo's OWNER/REPO#`number`."""
    return rf"(^|[^/[:alnum:]_])#{number}([^0-9]|$)"


def logged(*args: str) -> Iterator[tuple[tuple[int, str], list[str]]]:
    """Each commit `git log ARGS` lists, as its committer time and `SHA DATE SUBJECT`
    line, with the file names `--name-only` adds after it, if any."""
    out = git("log", "--format=%x00%ct %h %cs %s", *args) or ""
    for entry in out.split("\0")[1:]:
        head, *files = entry.strip("\n").split("\n")
        time, line = head.split(" ", 1)
        yield (int(time), line), files


def landed_commits(
    number: int, opened: str, refs: list[str], paths: list[str]
) -> list[tuple[str, str]]:
    """Each commit of `refs` committed since `opened`, no merge, that mentions
    #`number` or touches one of `paths`: its `SHA DATE SUBJECT` line and why it counts,
    oldest first."""
    since = ["--no-merges", f"--since={opened}"]
    why: dict[tuple[int, str], list[str]] = {}
    if paths:
        # From the top, as named_paths checked them, wherever this runs.
        top = [f":(top){path}" for path in paths]
        for commit, files in logged(*since, "--name-only", *refs, "--", *top):
            touched = [
                p for p in paths if any(f == p or f.startswith(p + "/") for f in files)
            ]
            why[commit] = ["touches " + ", ".join(touched[:3])]
    for commit, _ in logged(*since, "-E", f"--grep={mention(number)}", *refs):
        why.setdefault(commit, []).insert(0, f"mentions #{number}")
    return [(line, "; ".join(why[(time, line)])) for time, line in sorted(why)]


def print_landed(repo: str, issue: dict, found: list[Part]) -> None:
    """The commits on the default branch, here or on its remote, committed since the
    issue was opened, that mention it or touch a path it names in backticks, oldest
    first, at most LANDED_LINES. Nothing outside a clone of `repo`."""
    number, opened = issue["number"], issue.get("created_at")
    refs = clone_refs(repo) if opened else []
    if not refs:
        return
    paths = named_paths("\n".join(part.markdown for part in found), refs)
    commits = landed_commits(number, opened, refs, paths)
    if not commits:
        return
    print(f"--- landed since #{number} was opened ({', '.join(refs)})")
    for line, why in commits[:LANDED_LINES]:
        print(f"{line} ({why})")
    if len(commits) > LANDED_LINES:
        log = f"git log --no-merges --since={opened}"
        where = " ".join(refs)
        rest = f"{log} -E '--grep={mention(number)}' {where}"
        if paths:
            rest += f", and {log} {where} -- {' '.join(paths)}"
        print(f"... and {len(commits) - LANDED_LINES} more: {rest}")


def print_related(repo: str, issue: dict, found: list[Part]) -> None:
    """The issue's parent, its sub-issues, and the issues and pull requests `found`
    mentions, each under its own heading, with no issue listed twice. One GraphQL call
    looks up all of them in `repo`; one elsewhere gets the line REST gave."""
    number = issue["number"]
    parent_url = issue.get("parent_issue_url") or ""
    parent = int(parent_url.rsplit("/", 1)[1]) if parent_url else None
    parent_here = parent if parent and repo_of(parent_url) == repo else None
    subs = sub_issues(repo, issue)
    family = [parent_here] if parent_here else []
    family += [s["number"] for s in subs if repo_of(s["repository_url"]) == repo]
    mention = [
        n
        for n in mentions("\n".join(part.markdown for part in found))
        if n != number and n not in family
    ]
    asked = family + mention
    lines = lookup(repo, asked) if asked else {}
    if lines is None:
        print(
            f"issue-todo: couldn't look up the issues #{number} mentions, its parent "
            "or its sub-issues; "
            "`gh auth status` checks gh's login, and the issue above is complete",
            file=sys.stderr,
        )
        lines = {}
    if parent:
        print("--- parent")
        prefix = "" if parent_here else repo_of(parent_url)
        print(lines.get(parent, f"{prefix}#{parent}"))
    if subs:
        print("--- sub-issues")
        for s in subs:
            elsewhere = repo_of(s["repository_url"])
            fallback = f"#{s['number']} {s['state']}: {s['title']}"
            if elsewhere != repo:
                print(elsewhere + fallback)
            else:
                print(lines.get(s["number"], fallback))
    shown = [lines[n] for n in mention if n in lines]
    if shown:
        print("--- mentions")
        print("\n".join(shown))


def read(repo: str, numbers: list[int]) -> int:
    """Each issue's title, state, body and every comment, each with author and date."""
    for n, number in enumerate(numbers):
        issue = json.loads(gh("api", f"repos/{repo}/issues/{number}"))
        if n:
            print()
        print(f"#{issue['number']} {issue['title']} ({issue['state']})")
        author = (issue.get("user") or {}).get("login", "?")
        print(f"--- body {author} {(issue.get('created_at') or '')[:10]}".rstrip())
        print((issue.get("body") or "").rstrip())
        found = issue_parts(repo, issue)
        for part in found[1:]:
            print(f"--- {part.label}")
            print(part.markdown.rstrip())
        print_related(repo, issue, found)
        print_landed(repo, issue, found)
    return 0


def unticked(repo: str, numbers: list[int]) -> int:
    """Each unticked item of each issue, as `#N TEXT`."""
    for number in numbers:
        for part in parts(repo, number)[1]:
            for item in items(part.markdown):
                if not item.done:
                    print(f"#{number} {item.text}")
    return 0


CLAIM = re.compile(r"<!-- issue-todo (claim|release) (\S+) -->")
NAME = re.compile(r"\S+")  # what CLAIM reads back


def claims(comments: list[tuple[str, str]]) -> dict[str, str]:
    """The sessions holding a claim, with each claim's time, from `comments` in order,
    each as (body, time): a claim stands until a later release by the same ID."""
    held = {}
    for body, date in comments:
        for kind, session in CLAIM.findall(body):
            if kind == "claim":
                held.setdefault(session, date)
            else:
                held.pop(session, None)
    return held


def holders(repo: str, number: int) -> dict[str, str]:
    """The sessions holding a claim on the issue, with each claim's time, as GitHub
    gives it (`2026-10-25T08:04:00Z`)."""
    comments = json.loads(
        gh("api", "--paginate", f"repos/{repo}/issues/{number}/comments")
    )
    return claims([(c.get("body") or "", c["created_at"]) for c in comments])


def minute(time: str) -> str:
    """GitHub's `2026-10-25T08:04:00Z` as `2026-10-25 08:04`."""
    return time[:16].replace("T", " ")


def age(time: str) -> str:
    """How long ago GitHub's `time` was, floored: `45m` under an hour, `3h` under a
    day, else `2d`."""
    then = datetime.strptime(time, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=UTC)
    minutes = max(0, int((datetime.now(UTC) - then).total_seconds() // 60))
    if minutes < 60:
        return f"{minutes}m"
    if minutes < 24 * 60:
        return f"{minutes // 60}h"
    return f"{minutes // (24 * 60)}d"


def claimed_by(bodies: list[str]) -> str:
    """` [claimed by ID, ...]` for the claims standing in the comment `bodies`, or ""."""
    held = claims([(body, "") for body in bodies])
    return f" [claimed by {', '.join(held)}]" if held else ""


def post_comment(repo: str, number: int, body: str) -> None:
    gh(
        "api",
        "-X",
        "POST",
        f"repos/{repo}/issues/{number}/comments",
        "--input",
        "-",
        stdin=json.dumps({"body": body}),
    )


def claim(repo: str, number: int, session: str) -> int:
    held = holders(repo, number)
    if session in held:
        print(
            f"#{number} is already claimed by {session}, since {minute(held[session])}"
        )
        return 0
    if held:
        for other, since in held.items():
            print(
                f"issue-todo: #{number} is claimed by session {other} "
                f"since {minute(since)}, "
                "and not released",
                file=sys.stderr,
            )
        return 1
    post_comment(
        repo,
        number,
        f"Taking this (session {session}); `issue-todo release {number}` frees it.\n"
        f"<!-- issue-todo claim {session} -->",
    )
    print(f"#{number} claimed by {session}")
    return 0


def release(repo: str, number: int, session: str) -> int:
    if session not in holders(repo, number):
        print(
            f"issue-todo: {session} has no claim on #{number} to release",
            file=sys.stderr,
        )
        return 1
    post_comment(
        repo,
        number,
        f"Released (session {session}).\n<!-- issue-todo release {session} -->",
    )
    print(f"#{number} released by {session}")
    return 0


def open_issues(repo: str) -> list[dict]:
    """The repo's open issues, as GitHub lists them, without the pull requests."""
    listing = json.loads(
        gh("api", "--paginate", f"repos/{repo}/issues?state=open&per_page=100")
    )
    return [i for i in listing if "pull_request" not in i]


def show_open(repo: str) -> int:
    done = []  # the open issues with no open item
    for issue in open_issues(repo):
        by_part = [
            (part, [item for item in items(part.markdown) if not item.done])
            for part in issue_parts(repo, issue)
        ]
        with_open = [(part, open_) for part, open_ in by_part if open_]
        if not with_open:
            done.append(f"#{issue['number']}")
            continue
        who = ", ".join(a["login"] for a in issue.get("assignees") or [])
        print(f"#{issue['number']} {issue['title']}" + (f" [{who}]" if who else ""))
        for part, open_ in with_open:
            print(f"  {part.label}")
            for item in open_:
                print(f"    [ ] {short(item.text)}")
    if done:
        print(f"no open items: {' '.join(done)}")
    return 0


COMMENTS_PER_ISSUE = 100  # the most GraphQL serves in one connection


def list_claims(repo: str) -> int:
    """Each open issue's standing claims, as `#N  ID  AGE  TITLE`. One GraphQL call
    per 100 open issues; an issue with more comments than it served gets them all
    through REST."""
    owner, name = repo.split("/", 1)
    after = "null"
    while True:
        query = (
            f"query {{ repository(owner: {json.dumps(owner)}, name: {json.dumps(name)}) "
            f"{{ issues(states: OPEN, first: 100, after: {after}) "
            "{ pageInfo { hasNextPage endCursor } nodes { number title "
            f"comments(first: {COMMENTS_PER_ISSUE}) "
            "{ totalCount nodes { body createdAt } } } } } }"
        )
        out = gh("api", "graphql", "-f", f"query={query}")
        try:
            issues = json.loads(out)["data"]["repository"]["issues"]
        except (ValueError, KeyError, TypeError):
            sys.exit(
                f"issue-todo: gh api graphql gave no open issues for {repo}; "
                "`gh auth status` checks gh's login"
            )
        for issue in issues["nodes"]:
            comments = issue["comments"]
            if comments["totalCount"] > len(comments["nodes"]):
                held = holders(repo, issue["number"])
            else:
                held = claims(
                    [(c.get("body") or "", c["createdAt"]) for c in comments["nodes"]]
                )
            for session, since in held.items():
                print(f"#{issue['number']}  {session}  {age(since)}  {issue['title']}")
        if not issues["pageInfo"]["hasNextPage"]:
            return 0
        after = json.dumps(issues["pageInfo"]["endCursor"])


def show_titles(repo: str) -> int:
    """One line per open issue, with its count of open items and its claimants."""
    for issue in open_issues(repo):
        found = issue_parts(repo, issue)
        n = sum(not item.done for part in found for item in items(part.markdown))
        counts = [f"{n} open item{'s' if n > 1 else ''}"] if n else []
        summary = issue.get("sub_issues_summary") or {}
        if summary.get("total"):
            total = summary["total"]
            counts.append(
                f"{total} sub-issue{'s' if total > 1 else ''}, "
                f"{summary.get('completed', 0)} closed"
            )
        count = f" ({'; '.join(counts)})" if counts else ""
        who = claimed_by([part.markdown for part in found[1:]])
        print(f"#{issue['number']} {issue['title']}{count}{who}")
    return 0


def tick_one(
    repo: str,
    number: int,
    match: str,
    note: str | None,
    undo: bool,
    dry_run: bool,
    dropped: str | None = None,
) -> int:
    _, found = parts(repo, number)
    every = [(part, item) for part in found for item in items(part.markdown)]
    candidates = [(p, i) for p, i in every if match in i.text and i.done == undo]
    exact = [(p, i) for p, i in candidates if i.text == match]
    if len(exact) == 1:
        candidates = exact
    if len(candidates) != 1:
        state = "ticked" if undo else "open"
        print(
            f"issue-todo: {len(candidates)} {state} items match {match!r}",
            file=sys.stderr,
        )
        for part, item in candidates:
            print(f"  {part.label}: {short(item.text)}", file=sys.stderr)
        other = sum(match in i.text and i.done != undo for _, i in every)
        if not candidates and other:
            flag = "tick it without --undo" if undo else "--undo clears it"
            items_do = "item matches" if other == 1 else "items match"
            print(
                f"  {other} {'open' if undo else 'ticked'} {items_do}; {flag}",
                file=sys.stderr,
            )
        return 1
    part, item = candidates[0]
    new = tick(part.markdown, item, note, undo, dropped)
    if not dry_run:
        if (json.loads(gh("api", part.path)).get("body") or "") != part.markdown:
            print(
                f"issue-todo: {part.label} changed since it was read; run again",
                file=sys.stderr,
            )
            return 1
        gh(
            "api",
            "-X",
            "PATCH",
            part.path,
            "--input",
            "-",
            stdin=json.dumps({"body": new}),
        )
    print(
        f"{part.label}{' (dry run)' if dry_run else ''}:\n{new.split('\n')[item.line]}"
    )
    return 0


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="issue-todo",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    where = argparse.ArgumentParser(add_help=False)
    where.add_argument("--repo", help="OWNER/REPO; default: the current directory's")
    common = argparse.ArgumentParser(add_help=False, parents=[where])
    common.add_argument("number", type=int, help="the issue's number")
    sub = p.add_subparsers(dest="cmd", required=True)
    what = (
        "every open issue's open items, by issue (number, title, assignees) and by "
        "body or comment, then the open issues with none"
    )
    o = sub.add_parser("open", parents=[where], help=what, description=what)
    o.add_argument(
        "--titles",
        action="store_true",
        help="one line per open issue instead: number, title, count of open items, "
        "and the sessions holding a claim",
    )
    what = "every task-list item in the issue's body and comments, numbered within each"
    sub.add_parser("show", parents=[common], help=what, description=what)
    what = (
        "tick the one open item whose text contains MATCH (or equals it, when several "
        "contain it), appending --note, and write its body or comment back"
    )
    t = sub.add_parser("tick", parents=[common], help=what, description=what)
    t.add_argument("match", help="text the item contains (case-sensitive)")
    t.add_argument("--note", help="appended to the item, in italics")
    t.add_argument(
        "--undo",
        action="store_true",
        help="clear a ticked item instead; a dropped one keeps its strike and reason",
    )
    t.add_argument(
        "--dropped",
        metavar="WHY",
        type=reason,
        help="tick it as not done: strike its text through and append *dropped: WHY*;"
        " takes neither --note nor --undo",
    )
    t.add_argument(
        "--dry-run", action="store_true", help="print the new line, write nothing"
    )
    what = "each unticked item of each issue, as `#N TEXT`, one a line"
    u = sub.add_parser("unticked", parents=[where], help=what, description=what)
    u.add_argument("numbers", type=int, nargs="+", metavar="number")
    what = "each issue's title, state, body and every comment, with author and date"
    r = sub.add_parser("read", parents=[where], help=what, description=what)
    r.add_argument("numbers", type=int, nargs="+", metavar="number")
    for name, what in (
        ("claim", "claim the issue for this session, unless another holds it"),
        ("release", "release this session's claim on the issue"),
    ):
        c = sub.add_parser(name, parents=[common], help=what, description=what)
        c.add_argument(
            "--as",
            dest="name",
            help="the claimant's name (default: $CLAUDE_CODE_SESSION_ID's first 8 characters)",
        )
    what = (
        "each claim standing on an open issue, one a line, with its issue's number "
        "and title, the session and its age; one GraphQL call per 100 open issues"
    )
    sub.add_parser("claims", parents=[where], help=what, description=what)
    args = p.parse_args(argv)
    if args.cmd == "tick" and args.dropped is not None and (args.note or args.undo):
        t.error("--dropped takes neither --note nor --undo")
    session = ""
    if args.cmd in ("claim", "release"):
        session = args.name or os.environ.get("CLAUDE_CODE_SESSION_ID", "")[:8]
        if not session:
            p.error(f"{args.cmd} needs --as NAME outside a Claude Code session")
        if not NAME.fullmatch(session):
            p.error(f"a claimant's name is one word, without spaces: {session!r}")
    repo = (
        args.repo
        or gh("repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner").strip()
    )
    commands = {
        "open": lambda: show_titles(repo) if args.titles else show_open(repo),
        "show": lambda: show(repo, args.number),
        "unticked": lambda: unticked(repo, args.numbers),
        "read": lambda: read(repo, args.numbers),
        "claim": lambda: claim(repo, args.number, session),
        "release": lambda: release(repo, args.number, session),
        "claims": lambda: list_claims(repo),
        "tick": lambda: tick_one(
            repo,
            args.number,
            args.match,
            args.note,
            args.undo,
            args.dry_run,
            args.dropped,
        ),
    }
    return commands[args.cmd]()


if __name__ == "__main__":
    sys.exit(main())
