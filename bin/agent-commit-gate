#!/usr/bin/env python3
"""Claude Code PreToolUse hook: before the agent commits, run the repo's agent-only check.

A repo keeps its fast checks in the ordinary git pre-commit hook, which every
committer runs. Checks too slow for that (the full test suite, say) go in an
executable named `agent-pre-commit` beside it, in whatever directory git takes
hooks from (`core.hooksPath`, else .git/hooks). Git never runs that file; this
gate does, for each `git commit` in a Bash command the agent is about to run.

A failing check blocks the command (exit 2) and shows the agent the tail of its
output. A repo without the file, and every command that is not a commit, pass
through untouched. install.py registers the gate in ~/.claude/settings.json.

The gate runs before the command, so it checks what is staged then. A command
that also stages (`git add ... && git commit`, `git commit -a`, `git commit
PATHS`) would commit changes the check never saw, or be blocked for a state it
was about to fix. In a repo with a check, such a command is blocked up front:
stage in one command, commit in the next.

    agent-commit-gate < hook-input.json    # as Claude Code calls it
    agent-commit-gate --run [DIR]          # run DIR's check by hand (default: .)
"""

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

HOOK_NAME = "agent-pre-commit"
TAIL_LINES = 40
SEPARATORS = re.compile(r"&&|\|\||[;|\n]")
REDIRECT = re.compile(r"^\d*[<>]")
# Subcommands that change the index whatever their arguments.
STAGING = {"add", "stage", "rm", "mv", "reset", "update-index"}
# git commit options that take the next word as their value.
COMMIT_SHORT_VALUE = set("mFCct")
COMMIT_LONG_VALUE = {
    "--message",
    "--file",
    "--author",
    "--date",
    "--reuse-message",
    "--reedit-message",
    "--fixup",
    "--squash",
    "--cleanup",
    "--template",
    "--trailer",
}


def git_calls(command, cwd):
    """(directory, subcommand, arguments, quoted) for each git call in a shell command,
    following `cd DIR` and `git -C DIR`. Arguments stop at the first redirection
    (`<<'EOF'`, `2>&1`). `quoted` is False when the segment's quoting didn't parse, as
    when a quoted message runs over several lines; its arguments are then rough.
    A heredoc body splits into harmless segments; at worst a line of it that reads like a
    git call is counted."""
    here = Path(cwd)
    for segment in SEPARATORS.split(command):
        quoted = True
        try:
            words = shlex.split(segment)
        except ValueError:
            words, quoted = segment.split(), False
        if len(words) >= 2 and words[0] == "cd":
            here = here / os.path.expanduser(words[1])
            continue
        if not words or Path(words[0]).name != "git":
            continue
        rest, where = words[1:], here
        while rest and rest[0].startswith("-"):
            flag = rest.pop(0)
            if flag == "-C" and rest:
                where = where / os.path.expanduser(rest.pop(0))
            elif flag == "-c" and rest:
                rest.pop(0)
        if rest:
            args = []
            for word in rest[1:]:
                if REDIRECT.match(word):
                    break
                args.append(word)
            yield where, rest[0], args, quoted


def commit_dirs(command, cwd):
    """The directories each `git commit` in a shell command runs in."""
    found = [
        where
        for where, sub, args, _ in git_calls(command, cwd)
        if sub == "commit" and not {"-h", "--help"} & set(args)
    ]
    return list(dict.fromkeys(found))


def commit_stages(args, quoted=True):
    """What a `git commit` stages itself: -a/--all, or paths given on the command line.
    With rough arguments (quoted False), only options before the first quote count, and
    no paths: a message's words would read as paths."""
    if not quoted:
        options = []
        for word in args:
            if word[:1] in "\"'" or not word.startswith("-"):
                break
            options.append(word.split('"', 1)[0].split("'", 1)[0])
        return [s for s in commit_stages(options) if s != "git commit PATHS"]
    staged, i = [], 0
    while i < len(args):
        word = args[i]
        if word == "--":
            if args[i + 1 :]:
                staged.append("git commit PATHS")
            break
        if word.startswith("--"):
            name = word.split("=", 1)[0]
            if name == "--all":
                staged.append("git commit -a")
            elif name == "--pathspec-from-file":
                staged.append("git commit PATHS")
            if "=" not in word and name in COMMIT_LONG_VALUE:
                i += 1
        elif word.startswith("-") and len(word) > 1:
            for j, letter in enumerate(word[1:]):
                if letter == "a":
                    staged.append("git commit -a")
                if letter in COMMIT_SHORT_VALUE:
                    i += j == len(word) - 2  # the value is the next word
                    break  # or the rest of this one
        else:
            staged.append("git commit PATHS")
        i += 1
    return staged


def staging(command):
    """Each operation in a shell command that changes what is staged, in order."""
    found = []
    for _, sub, args, quoted in git_calls(command, "."):
        if sub in STAGING:
            found.append(f"git {sub}")
        elif sub == "restore" and ({"--staged", "-S"} & set(args)):
            found.append("git restore --staged")
        elif sub == "apply" and ({"--cached", "--index"} & set(args)):
            found.append("git apply --cached")
        elif sub == "commit":
            found += commit_stages(args, quoted)
    return list(dict.fromkeys(found))


def agent_hook(repo):
    """The repo's agent-pre-commit if it exists and is executable, else None."""
    run = subprocess.run(
        ["git", "-C", str(repo), "rev-parse", "--show-toplevel", "--git-path", "hooks"],
        capture_output=True,
        text=True,
        check=False,
    )
    if run.returncode:
        return None
    top, hooks = run.stdout.splitlines()
    hook = Path(repo, hooks) / HOOK_NAME
    return (Path(top), hook) if hook.is_file() and os.access(hook, os.X_OK) else None


def check(repo):
    """Run the repo's check; returns (passed, message for the agent)."""
    found = agent_hook(repo)
    if not found:
        return True, ""
    top, hook = found
    run = subprocess.run(
        [str(hook)], cwd=top, capture_output=True, text=True, check=False
    )
    if run.returncode == 0:
        return True, ""
    tail = "\n".join((run.stdout + run.stderr).splitlines()[-TAIL_LINES:])
    return False, (
        f"Commit blocked: {hook} exited {run.returncode}. Fix what it reports, then commit again.\n"
        f"{tail}"
    )


def main(argv=None):
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--run",
        nargs="?",
        const=".",
        metavar="DIR",
        help="run DIR's check now, outside a hook",
    )
    args = parser.parse_args(argv)
    if args.run:
        passed, message = check(Path(args.run))
        print(
            message or f"{args.run}: passed, or has no {HOOK_NAME}",
            file=sys.stderr if message else sys.stdout,
        )
        return 0 if passed else 1
    event = json.load(sys.stdin)
    if event.get("tool_name") != "Bash":
        return 0
    command = event.get("tool_input", {}).get("command", "")
    repos = commit_dirs(command, event.get("cwd") or os.getcwd())
    staged = staging(command) if repos else []
    for repo in repos:
        if staged and agent_hook(repo):
            print(
                f"Commit blocked: this command also stages ({', '.join(staged)}), but the "
                "check runs before the command, on what is staged now, so it would not see "
                "what this commit records. Stage in its own command first, then commit.",
                file=sys.stderr,
            )
            return 2
        passed, message = check(repo)
        if not passed:
            print(message, file=sys.stderr)
            return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
