#!/usr/bin/env python3
"""Keep /build's bookkeeping: the base commit, the refactor base and the repo fingerprint.

    build-state start [--base REV]
                            record the base (HEAD, or an earlier REV) and the repo's
                            fingerprint
    build-state refactor    record the refactor base (HEAD), before applying review fixes
    build-state show        print the recorded bases
    build-state finish      fold fixups into the commits they fix, check the fingerprint,
                            print the commits since the base and the test files
                            changed since the refactor base. It runs no
                            agent-pre-commit: wt-ship checks each commit when it
                            lands
    build-state review-prompt BRIEF
                            write the review subagent's prompt for the commit at HEAD
                            to build-review-prompt.md in the git dir, and print a short
                            prompt that points the reviewer at it. The file holds the
                            base, the commits, the brief as its spec, the standards
                            sources, and code-review's standards section and its
                            Standards and Spec briefs, copied verbatim from its
                            SKILL.md (fails when they can't be found there); on stderr,
                            a nudge to write a CODING_STANDARDS.md when the repo has none.
                            When the repo has an agent-pre-commit, which wt-ship runs
                            on every commit when it lands, the file tells the
                            reviewer to run only the tests a finding needs, not the
                            whole suite
    build-state reword SHA [FILE]
                            replace commit SHA's message with FILE's text (stdin
                            without FILE), keeping every tree; refuses with
                            uncommitted changes, merges after SHA, or SHA pushed

The state lives in the worktree's git dir, as build-state.json, beside the review
prompt; finish removes both.

finish folds only fixup!, squash! and amend! commits (`git commit --fixup=SHA`), each
into the commit it names, with an autosquash rebase onto the base. Every other commit
stays as it is, in order, so logically separate commits stay separate. It refuses
uncommitted changes and leftover conflict markers since the base. On a conflict it aborts
the rebase, and when the folded tree differs from the tree before, it resets to that;
either way the branch is as it was. A fix conflicts when a commit after the one it
names changed the same lines, so finish then names the last commit before the fix to
change its conflicting files, which the fix was made on top of, and how to point the
fix at it with reword.

finish runs no check. A fold, finish's own or one done by hand, puts each fix into an
earlier commit, and a fix folded into an earlier commit than the code it needs leaves
that commit broken while HEAD passes; wt-ship finds it, since it checks every commit it
lands that has no pass on agent-commit-gate's record (`wt-ship -h`), and a fold's new
tree has none.

The fingerprint is every ref except the work branch and its upstream, the stash, and the
branches checked out in other linked worktrees at start or at finish, which other sessions
move (a symbolic ref, such as origin/HEAD, counts by the ref it points to), and every entry
of the repo's config. A tag counts only when it points, at start or now, at a commit the
fold may rewrite (after the base it folds from, in HEAD's history), or when where it
pointed at start can no longer be read: a tag CI made on main, which a fetch brings in,
doesn't. When either changed since start, finish names the refs and config
keys (never config values: a remote URL can hold a token), exits 1 and keeps the state,
before folding anything. A fix commit left unfolded (its target is older than the base)
also fails finish. It does not push.

On a detached HEAD, as in a worktree that will land on main, there is no work branch.
There the build's target is the branch the main worktree has checked out, when it's
behind or ahead of the base; otherwise every branch at the base. A target counts
locally and on every remote (refs/heads/X, refs/remotes/*/X). Another session's merge
or push moves it, so a moved target doesn't fail finish: it finishes as usual, then
says "X moved since start: rebase onto it" while HEAD lacks one of its commits.
"""

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import commitcheck

# tests/x.py, test/x.py, spec/x.rb, test_x.py, x_test.go, x.test.ts, x.spec.js
TEST_FILE = re.compile(
    r"(^|/)(tests?|spec)/|(^|/)test_[^/]*$|_test\.[^/]+$|\.(test|spec)\.[^/]+$"
)
# The subjects of commits that finish folds into the commits they name.
FIXES = ("fixup! ", "squash! ", "amend! ")


def git(*args: str, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], capture_output=True, text=True, check=check)


def state_file() -> Path:
    return (
        Path(git("rev-parse", "--absolute-git-dir").stdout.strip()) / "build-state.json"
    )


def head() -> str:
    return git("rev-parse", "HEAD").stdout.strip()


def work_refs() -> list[str]:
    """The checked-out branch and its upstream, which the build itself moves (a push moves
    the upstream); empty on a detached HEAD."""
    refs = [git("symbolic-ref", "-q", "HEAD", check=False).stdout.strip()]
    refs.append(
        git("rev-parse", "--symbolic-full-name", "@{u}", check=False).stdout.strip()
    )
    return [ref for ref in refs if ref]


def branch_name(ref: str) -> str | None:
    """X for refs/heads/X or refs/remotes/REMOTE/X; None for any other ref."""
    if ref.startswith("refs/heads/"):
        return ref.removeprefix("refs/heads/")
    if ref.startswith("refs/remotes/"):
        return ref.removeprefix("refs/remotes/").partition("/")[2] or None
    return None


def main_tree_branch() -> str | None:
    """The branch the main worktree has checked out; None when it's detached."""
    first = git("worktree", "list", "--porcelain").stdout.split("\n\n")[0]
    for line in first.splitlines():
        if line.startswith("branch "):
            return line.removeprefix("branch refs/heads/")
    return None


def ancestor(older: str, newer: str) -> bool:
    return git("merge-base", "--is-ancestor", older, newer, check=False).returncode == 0


def target_branches(base: str) -> list[str]:
    """The branches a detached build will land on: the main worktree's branch when it's
    behind or ahead of the base, else every branch at the base, local or remote."""
    main = main_tree_branch()
    if main and (ancestor(base, main) or ancestor(main, base)):
        return [main]
    listed = git("for-each-ref", "--format=%(refname) %(objectname)").stdout
    return sorted(
        {
            name
            for ref, commit in (line.split() for line in listed.splitlines())
            if commit == base and (name := branch_name(ref)) and name != "HEAD"
        }
    )


def rewritten_base(targets: set[str]) -> tuple[str, str] | None:
    """When another session rewrote the branch a build lands on (a rebase, an amended
    tip) and HEAD was rebased onto the new one, the recorded base is in neither, and a
    fold from it would replay the branch's own commits. This is that branch and where
    HEAD meets it now: a landing branch, or, for a build on a named branch, which has
    none, the branch's upstream. None if HEAD meets none of them."""
    upstream = git(
        "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}", check=False
    ).stdout.strip()
    for branch, ref in [
        *((name, f"refs/heads/{name}") for name in sorted(targets)),
        *([(upstream, upstream)] if upstream else []),
    ]:
        meet = git("merge-base", "HEAD", ref, check=False).stdout.strip()
        if meet:
            return branch, meet
    return None


def behind(branch: str) -> bool:
    """Whether HEAD lacks a commit of the branch, local or any remote's."""
    listed = git(
        "for-each-ref", "--format=%(refname)", "refs/heads", "refs/remotes"
    ).stdout
    return any(
        branch_name(ref) == branch and not ancestor(ref, "HEAD")
        for ref in listed.splitlines()
    )


def other_worktree_branches() -> set[str]:
    """The branches checked out in linked worktrees other than this one: other sessions
    commit there. The main worktree's branch isn't one; a detached build lands on it."""
    here = git("rev-parse", "--show-toplevel").stdout.strip()
    trees = git("worktree", "list", "--porcelain").stdout.split("\n\n")[1:]
    branches = set()
    for tree in trees:
        lines = tree.splitlines()
        path = next((ln[9:] for ln in lines if ln.startswith("worktree ")), None)
        if path and os.path.realpath(path) != os.path.realpath(here):
            branches.update(
                ln.removeprefix("branch refs/heads/")
                for ln in lines
                if ln.startswith("branch ")
            )
    return branches


def fingerprint(work: list[str]) -> dict[str, dict[str, str]]:
    """Every ref but the work refs and the stash, and every config entry with its values
    hashed: a value, such as a remote URL, can hold a token."""
    common = git("rev-parse", "--git-common-dir").stdout.strip()
    listed = git("config", "--file", f"{common}/config", "--list").stdout
    values: dict[str, list[str]] = {}
    for entry in listed.splitlines():
        key, _, value = entry.partition("=")
        values.setdefault(key, []).append(value)
    config = {
        key: hashlib.sha1("\n".join(found).encode()).hexdigest()[:12]
        for key, found in values.items()
    }
    # A symbolic ref (origin/HEAD) counts by what it points to, not the commit that
    # resolves to: a push moves origin/main, and with it what origin/HEAD resolves to.
    listed = git("for-each-ref", "--format=%(refname) %(objectname) %(symref)").stdout
    refs = {}
    for line in listed.splitlines():
        name, commit, *target = line.split()
        refs[name] = f"-> {target[0]}" if target else commit
    ignored = {*work, "refs/stash"}
    return {
        "config": config,
        "refs": {n: s for n, s in refs.items() if n not in ignored},
    }


def on_work_commit(name: str, before: str | None, work: set[str]) -> bool:
    """Whether tag `name`, as it was at start (`before`) or is now, points at one of the
    `work` commits, which the fold may rewrite, leaving the tag on the old commit. A start
    value that no longer resolves, as a deleted annotated tag's pruned object doesn't,
    counts: where it pointed can't be told. Any other tag, such as one CI made on main
    and a fetch brought in, the fold can't touch."""

    def peeled(ref: str) -> str:
        found = git("rev-parse", "-q", "--verify", f"{ref}^{{commit}}", check=False)
        return found.stdout.strip()

    if before and not peeled(before):
        return True
    return any(peeled(ref) in work for ref in (name, before) if ref)


def changes(
    before: dict[str, dict[str, str]], after: dict[str, dict[str, str]]
) -> list[str]:
    """The config keys and ref names that differ, without their values."""
    return sorted(
        f"{kind} {name}"
        for kind in ("config", "refs")
        for name in before[kind].keys() | after[kind].keys()
        if before[kind].get(name) != after[kind].get(name)
    )


def load(path: Path) -> dict | None:
    if not path.exists():
        print("No build is open here: run `build-state start` first.", file=sys.stderr)
        return None
    return json.loads(path.read_text())


def save(path: Path, state: dict) -> None:
    path.write_text(json.dumps(state, indent=2) + "\n")


def start(args: argparse.Namespace) -> int:
    path = state_file()
    if path.exists() and not args.force:
        base = load(path)["base"]
        print(
            f"A build is already open, from base {base}: finish it, or start --force.",
            file=sys.stderr,
        )
        return 1
    work = work_refs()
    if args.base is None:
        base = head()
    else:
        found = git(
            "rev-parse", "--verify", "-q", f"{args.base}^{{commit}}", check=False
        )
        if found.returncode != 0:
            return fail(f"No commit {args.base}.")
        base = found.stdout.strip()
        if not ancestor(base, "HEAD"):
            return fail(
                f"{args.base} isn't an ancestor of HEAD, so it can't be the base."
            )
    targets = [] if work else target_branches(base)
    save(
        path,
        {
            "base": base,
            "work_refs": work,
            "targets": targets,
            "others": sorted(other_worktree_branches()),
            "fingerprint": fingerprint(work),
        },
    )
    print(f"base {base}")
    return 0


def refactor(args: argparse.Namespace) -> int:
    path = state_file()
    if (state := load(path)) is None:
        return 1
    state["refactor_base"] = head()
    save(path, state)
    print(f"refactor base {state['refactor_base']}")
    return 0


def show(args: argparse.Namespace) -> int:
    if (state := load(state_file())) is None:
        return 1
    print(f"base {state['base']}")
    if "refactor_base" in state:
        print(f"refactor base {state['refactor_base']}")
    return 0


def fail(*lines: str) -> int:
    print("\n".join(lines), file=sys.stderr)
    return 1


def conflict_markers(base: str) -> list[str]:
    """`file:line` for each leftover conflict marker the commits since the base add."""
    check = git("diff", "--check", base, "HEAD", check=False).stdout
    return [
        line.removesuffix(": leftover conflict marker")
        for line in check.splitlines()
        if line.endswith(": leftover conflict marker")
    ]


def fold_fixups(base: str) -> bool:
    """Autosquash onto the base; on failure, abort and say why."""
    # ":" accepts the todo list as is, and a squash! commit's combined message.
    env = os.environ | {"GIT_SEQUENCE_EDITOR": ":", "GIT_EDITOR": ":"}
    rebase = subprocess.run(
        ["git", "rebase", "-q", "-i", "--autosquash", base],
        env=env,
        capture_output=True,
        text=True,
        check=False,
    )
    if rebase.returncode == 0:
        return True
    hint = conflict_hint(base)
    git("rebase", "--abort", check=False)
    fail(
        # git's hints say to resolve the conflict and continue, but the rebase is over.
        *(
            line
            for line in (rebase.stdout + rebase.stderr).splitlines()
            if not line.startswith("hint: ")
        ),
        "Folding the fixups failed; the branch is as it was.",
        *hint,
    )
    return False


def conflict_hint(base: str) -> list[str]:
    """For a fold stopped at a fix that conflicts: the later commit it was made on top
    of, and how to point the fix at that commit. Empty when it stopped elsewhere or the
    commit the fix names is the last before it to change those files."""
    stopped = git("rev-parse", "--verify", "--quiet", "REBASE_HEAD", check=False)
    unmerged = git("diff", "--no-relative", "--name-only", "-z", "--diff-filter=U")
    files = [name for name in unmerged.stdout.split("\0") if name]
    if stopped.returncode != 0 or not files:
        return []
    fix = stopped.stdout.strip()
    subject = git("log", "-1", "--format=%s", fix).stdout.strip()
    kind = next((kind for kind in FIXES if subject.startswith(kind)), None)
    if kind is None:
        return []
    named = subject
    while named.startswith(FIXES):
        named = named.partition(" ")[2]
    log = git(
        *("log", "--format=%H %s", f"{base}..{fix}~1", "--"),
        *(f":(top,literal){file}" for file in files),
    ).stdout
    # The newest commit before the fix to change its files, other fixes aside: the fix
    # was made on top of it, so it applies there.
    later = next(
        (
            line
            for line in log.splitlines()
            if not line.partition(" ")[2].startswith(FIXES)
        ),
        "",
    )
    sha, _, later_subject = later.partition(" ")
    if not sha or later_subject == named or sha.startswith(named):
        return []
    point = (
        f"  echo 'fixup! {sha[:12]}' | build-state reword {fix[:12]}"
        if kind == "fixup! "
        else f"  `build-state reword {fix[:12]}` with the subject `{kind}{sha[:12]}`,"
        " and the rest of its message as it is"
    )
    return [
        (
            f"{fix[:12]} {subject} conflicts in {', '.join(files)}, which {sha[:12]}"
            f" {later_subject}"
        ),
        "changed after the commit the fix names. Point the fix at that commit and run",
        "finish again:",
        point,
        f"Or keep it as a commit of its own: reword it without `{kind.strip()}`.",
    ]


def report_tests(refactor_base: str) -> None:
    changed = git("diff", "--name-only", refactor_base, "HEAD").stdout.splitlines()
    if tests := [name for name in changed if TEST_FILE.search(name)]:
        print(f"\nTest files changed since the refactor base ({refactor_base[:12]});")
        print("each change must trace to a review finding:")
        print(git("diff", "--stat", refactor_base, "HEAD", "--", *tests).stdout, end="")


def finish(args: argparse.Namespace) -> int:
    path = state_file()
    if (state := load(path)) is None:
        return 1
    base = state["base"]
    if git("status", "--porcelain", "--untracked-files=no").stdout:
        return fail("There are uncommitted changes: commit or stash them first.")
    targets = set(state.get("targets", []))
    others = set(state.get("others", [])) | other_worktree_branches()
    found = None if ancestor(base, "HEAD") else rewritten_base(targets)
    # The commits the fold may rewrite, from where it will start.
    work = set(git("rev-list", f"{found[1] if found else base}..HEAD").stdout.split())
    moved, moved_targets = [], set()
    for change in changes(state["fingerprint"], fingerprint(state["work_refs"])):
        kind, _, name = change.partition(" ")
        before = state["fingerprint"]["refs"].get(name)
        if name.startswith("refs/tags/") and not on_work_commit(name, before, work):
            continue
        branch = branch_name(name) if kind == "refs" else None
        if branch in targets:
            moved_targets.add(branch)
        elif branch not in others:
            moved.append(change)
    if moved:
        return fail(
            "The repo changed outside the work branch since start:",
            *(f"  {name}" for name in moved),
        )
    if not ancestor(base, "HEAD"):
        if found is None:
            return fail(
                f"The base {base[:12]} isn't in HEAD's history, and HEAD meets no branch",
                "this build lands on, so there's nothing to fold onto. Find the commit",
                "the work starts after and run `build-state start --base COMMIT --force`.",
            )
        branch, base = found
        print(
            f"The base {state['base'][:12]} isn't in HEAD's history: {branch} was rewritten"
            f" since start. Folding from {base[:12]}, where HEAD meets {branch}.",
            flush=True,
        )
    if markers := conflict_markers(base):
        return fail(
            "Leftover conflict markers since the base: resolve them (`conflicts -h`).",
            "A file that holds markers on purpose, such as a test fixture, sets",
            "conflict-marker-size in .gitattributes (`git help attributes`).",
            *(f"  {marker}" for marker in markers),
        )
    before = head()
    if not fold_fixups(base):
        return 1
    if (
        git("rev-parse", "HEAD^{tree}").stdout
        != git("rev-parse", f"{before}^{{tree}}").stdout
    ):
        git("reset", "-q", "--hard", before)
        return fail(
            "Folding the fixups changed the tree, so the branch is back as it was:",
            f"  {before}. Fold them by hand and compare with `git diff {before[:12]}`.",
        )
    print(git("log", "--oneline", "--reverse", f"{base}..HEAD").stdout, end="")
    subjects = git("log", "--format=%s", f"{base}..HEAD").stdout.splitlines()
    if unfolded := [subject for subject in subjects if subject.startswith(FIXES)]:
        return fail(
            "These fix commits before the base, so they weren't folded:",
            *(f"  {subject}" for subject in unfolded),
        )
    if "refactor_base" in state:
        report_tests(state["refactor_base"])
    for branch in sorted(moved_targets):
        if behind(branch):
            print(f"{branch} moved since start: rebase onto it")
    path.unlink()
    (path.parent / REVIEW_FILE).unlink(missing_ok=True)
    return 0


CODE_REVIEW = Path.home() / ".agents/skills/code-review/SKILL.md"
GLOBAL_STANDARDS = "~/.agents/skills/coding/standards.md"
REPO_STANDARDS = ("CODING_STANDARDS.md", "CONTRIBUTING.md", "AGENTS.md", "CLAUDE.md")
BRIEF_LINE = re.compile(r'^- The brief: "(.*)"\s*$')
HEADING = re.compile(r"^(#|\*\*)")
AXIS_HEADING = re.compile(r"^\*\*(Standards|Spec) sub-agent prompt\*\*")
SOURCES_HEADING = "### 3. Identify the standards sources"
# The full prompt goes to this file beside the state, and the pointer below to stdout,
# so the agent that spawns the reviewer neither reads nor retypes the whole prompt.
REVIEW_FILE = "build-review-prompt.md"
POINTER = """\
Your instructions for this review are in {path}. Read that whole file first, then \
follow it. Report only: edit no files and make no commits.
"""
# In the review prompt when the repo has an agent check.
CHECKED_AT_LANDING = """
wt-ship runs the repo's agent check, agent-pre-commit, on every commit it lands that \
has no pass on record, so don't run the whole test suite: run the tests a finding \
needs, and `mutate-check` to see whether a test catches a break.
"""
REVIEW_PROMPT = """\
Review the changes in {top} since {base}, up to {sha}. Report only: edit no files and \
make no commits.

Diff: `git diff {base}...{sha}`. Commits:
{commits}
Read the files as of that commit, with `git show {sha}:PATH`: the work tree can move on \
while you review.

Spec: {brief}. Read it in full.

You may run the repo's own build and check commands; writing outputs git ignores is \
fine. Run tools at the versions the repo pins (its hooks, pre-commit config or lock \
files), not whatever `uvx` or `PATH` gives: another version reports what the repo's \
checks don't. To see whether a test catches a break, use `mutate-check -- CMD` \
(`mutate-check -h`), which puts the code back, rather than a scripted edit. To see how \
the code behaves on a case, run the tests that reach it, a few at a time, through \
`heavy --quick -- CMD` as a foreground call with the Bash timeout at 600000; judge a \
case no test reaches from the code.
{checked_at_landing}
Run two separate reviews and report them under the headings `## Standards` and `## Spec`. \
Don't merge or rerank findings across the two.

## Standards

Standards sources: {sources}, and any other file in the repo that documents how code \
should be written. A repo's own standards win where they conflict with the global ones. \
Apply the smell baseline and its rules, from code-review's SKILL.md, verbatim:

{sources_section}

Brief, verbatim: "{standards}"

## Spec

Brief, verbatim: "{spec}"
"""


def code_review_briefs(text: str) -> dict[str, str]:
    """code-review's Standards and Spec briefs, verbatim: each is the quoted `- The
    brief:` line under its `**<Axis> sub-agent prompt**` heading, before the next
    heading of any kind."""
    briefs, axis = {}, None
    for line in text.splitlines():
        if HEADING.match(line):
            axis = (heading := AXIS_HEADING.match(line)) and heading.group(1)
        elif axis and (brief := BRIEF_LINE.match(line)):
            briefs[axis] = brief.group(1)
            axis = None
    return briefs


def section(text: str, heading: str) -> str:
    """The section under `heading`, without it, up to the next heading of its level or
    higher."""
    level = len(heading.split(" ", 1)[0])
    body = text.split(heading, 1)[1].split("\n")
    kept = []
    for line in body[1:]:
        hashes = len(line) - len(line.lstrip("#"))
        if 0 < hashes <= level and line[hashes : hashes + 1] == " ":
            break
        kept.append(line)
    return "\n".join(kept).strip()


def review_prompt(args: argparse.Namespace) -> int:
    if (state := load(state_file())) is None:
        return 1
    if not args.brief.is_file():
        return fail(f"No brief at {args.brief}.")
    skill = args.skill or CODE_REVIEW
    if not skill.is_file():
        return fail(f"{skill} not found: is code-review installed?")
    text = skill.read_text()
    briefs = code_review_briefs(text)
    missing = [
        f"the {axis} brief" for axis in ("Standards", "Spec") if axis not in briefs
    ]
    if SOURCES_HEADING not in text:
        missing.append(f"the heading {SOURCES_HEADING!r}")
    if missing:
        return fail(
            f"No {' or '.join(missing)} in {skill}: code-review's layout changed,",
            "so update review_prompt in build-state.",
        )
    base, sha = state["base"], head()
    top = Path(git("rev-parse", "--show-toplevel").stdout.strip())
    if not (top / "CODING_STANDARDS.md").is_file():
        print(
            f"build-state: {top} has no CODING_STANDARDS.md. Consider writing one: the rules a "
            "reviewer holds this repo's code to, beside the global standards.",
            file=sys.stderr,
        )
    sources = [
        GLOBAL_STANDARDS,
        *(str(top / n) for n in REPO_STANDARDS if (top / n).is_file()),
    ]
    prompt_file = state_file().parent / REVIEW_FILE
    prompt_file.write_text(
        REVIEW_PROMPT.format(
            top=top,
            base=base,
            sha=sha,
            commits=git("log", "--oneline", "--reverse", f"{base}..{sha}").stdout,
            brief=args.brief.resolve(),
            checked_at_landing=(
                CHECKED_AT_LANDING
                if commitcheck.runnable(commitcheck.hook_path())
                else ""
            ),
            sources=", ".join(sources),
            sources_section=section(text, SOURCES_HEADING),
            standards=briefs["Standards"],
            spec=briefs["Spec"],
        )
    )
    print(POINTER.format(path=prompt_file), end="")
    return 0


# The sequence editor a reword's rebase runs: turns the named commit's `pick` into `reword`
REWORD_TODO = """\
import sys
from pathlib import Path
todo, sha = Path(sys.argv[1]), sys.argv[2]
lines = todo.read_text().splitlines(keepends=True)
for i, line in enumerate(lines):
    words = line.split()
    if words[:1] == ["pick"] and sha.startswith(words[1]):
        lines[i] = "reword" + line[len("pick"):]
todo.write_text("".join(lines))
"""


def reword(args: argparse.Namespace) -> int:
    message = args.file.read_text() if args.file else sys.stdin.read()
    if not message.strip():
        return fail("No message: give it in FILE or on stdin.")
    git_dir = Path(git("rev-parse", "--absolute-git-dir").stdout.strip())
    if any((git_dir / name).exists() for name in ("rebase-merge", "rebase-apply")):
        return fail("A rebase is in progress: finish or abort it before rewording.")
    if git("status", "--porcelain", "--untracked-files=no").stdout.strip():
        return fail("Uncommitted changes: commit or stash them before rewording.")
    sha = git(
        "rev-parse", "--verify", "--quiet", f"{args.sha}^{{commit}}", check=False
    ).stdout.strip()
    if not sha or not ancestor(sha, "HEAD"):
        return fail(f"{args.sha} isn't in HEAD's history.")
    if git("branch", "-r", "--contains", sha).stdout.strip():
        return fail(
            f"{args.sha} is already pushed: rewording it would rewrite shared history."
        )
    parent = git(
        "rev-parse", "--verify", "--quiet", f"{sha}~1", check=False
    ).stdout.strip()
    if git(
        "rev-list", "--merges", f"{parent}..HEAD" if parent else "HEAD"
    ).stdout.strip():
        return fail(
            f"Merges after {args.sha}: a rebase would flatten them, so reword by hand."
        )
    subject = git("log", "-1", "--format=%s", sha).stdout.strip()
    later = git("log", "--format=%s", f"{sha}..HEAD").stdout.splitlines()
    names = {f"{kind}! {subject}" for kind in ("fixup", "squash", "amend")}
    if naming := [s for s in later if s in names]:
        return fail(
            f"A later commit, {naming[0]!r}, names this one by its subject, which rewording would",
            "break: fold it first (build-state finish), then reword.",
        )
    count = int(git("rev-list", "--count", f"{sha}..HEAD").stdout)
    before = head()
    with tempfile.TemporaryDirectory() as scratch:
        text, editor = Path(scratch, "message"), Path(scratch, "todo.py")
        text.write_text(message)
        editor.write_text(REWORD_TODO)
        env = os.environ | {
            "GIT_SEQUENCE_EDITOR": f'"{sys.executable}" "{editor}" "$@" {sha} #',
            "GIT_EDITOR": f'cp "{text}"',
        }
        rebase = subprocess.run(
            [
                "git",
                # whole command words in the todo, and a message kept as given, # lines too
                *(
                    "-c",
                    "rebase.abbreviateCommands=false",
                    "-c",
                    "commit.cleanup=whitespace",
                ),
                *("rebase", "-q", "-i", "--no-autosquash", parent or "--root"),
            ],
            env=env,
            capture_output=True,
            text=True,
            check=False,
        )
    if rebase.returncode != 0:
        git(
            "rebase", "--abort", check=False
        )  # ours: reword refused to start during another
        return fail("git rebase failed, and was aborted:", rebase.stderr.strip())
    reworded = git("log", "-1", "--format=%B", f"HEAD~{count}").stdout
    if reworded.strip() != message.strip():
        git("reset", "-q", "--keep", before)
        return fail(
            f"The rebase didn't reword {args.sha}; HEAD is back at {before[:12]}."
        )
    print(f"Reworded {sha[:12]}; HEAD is now {head()[:12]}.")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    commands = parser.add_subparsers(dest="command", required=True)
    start_command = commands.add_parser(
        "start", help="record the base and the repo fingerprint"
    )
    start_command.add_argument(
        "--force", action="store_true", help="replace a build that is still open"
    )
    start_command.add_argument(
        "--base", metavar="REV", help="record REV as the base instead of HEAD"
    )
    start_command.set_defaults(run=start)
    commands.add_parser("refactor", help="record the refactor base").set_defaults(
        run=refactor
    )
    commands.add_parser("show", help="print the recorded bases").set_defaults(run=show)
    commands.add_parser(
        "finish", help="fold fixups, check the fingerprint, list the commits"
    ).set_defaults(run=finish)
    prompt_command = commands.add_parser(
        "review-prompt",
        help="write the review subagent's prompt to a file and print a pointer to it",
    )
    prompt_command.add_argument("brief", type=Path, help="the build's brief file")
    prompt_command.add_argument(
        "--skill",
        type=Path,
        help=f"code-review's SKILL.md, for its two briefs (default {CODE_REVIEW})",
    )
    prompt_command.set_defaults(run=review_prompt)
    reword_command = commands.add_parser("reword", help="replace a commit's message")
    reword_command.add_argument("sha", metavar="SHA")
    reword_command.add_argument("file", nargs="?", type=Path, metavar="FILE")
    reword_command.set_defaults(run=reword)
    args = parser.parse_args(argv)
    return args.run(args)


if __name__ == "__main__":
    sys.exit(main())
