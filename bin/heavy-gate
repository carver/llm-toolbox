#!/usr/bin/env python3
"""A Claude Code PreToolUse hook that refuses a Bash call waiting on heavy in the
foreground.

heavy waits its turn in a queue every session shares, then for quiet cores, with no
time limit, and a Bash call that waits on it is killed at the tool's own limit. So
the hook refuses a Bash call that runs `heavy -- CMD` unless the call was made with
run_in_background: true, and names the right form: `bgrun --wait -o LOG -- heavy --
CMD` as a background call. `heavy --few-seconds -- CMD`, a run of seconds that waits for
the running job and the queue's front, may run in the foreground, and the refusal
names it too; heavy stops such a run past 60 s (HEAVY_QUICK_MAX), so anything longer
goes through bgrun. That wait can pass the Bash tool's default limit of two minutes, so the
hook refuses a foreground call that runs it unless the call's own timeout is the
tool's longest, 600000 ms; a `timeout` command around heavy doesn't count.
Background call or not, it refuses heavy around bgrun (`heavy -- bgrun ...`), and
around git commit and wt-ship, which queue their own checks and run bare, and heavy
without --long around `mutate-check --diff`, which runs its command once per mutant and
would hold the normal lane, ahead of every commit's checks, for minutes; the refusal
names `bgrun --wait -o LOG -- heavy --long -- mutate-check --diff ...` as a background
call. It looks for --diff among mutate-check's options, the words before its `--`, and
counts an expansion there as --diff; inside heavy, a shell's -c script counts too. A
mutate-check of edits, `--edits FILE` or blocks on stdin, runs once and goes under heavy
like any other command. install.py
registers it in ~/.claude/settings.json.

It also refuses a hand-rolled timing without a bound, background call or not: `time`
(the keyword or /usr/bin/time), hyperfine or `perf stat` under heavy without --alone,
and hyperfine outside heavy. Such numbers carry whatever else runs on the cores, and a
comparison of more than a minute or two belongs to heavy-bench, which the refusal
names. A `timeout` around the timing or inside it bounds it, as do hyperfine's --runs
and --max-runs and heavy's --few-seconds, which heavy stops at 60 s. A bounded timing
outside --alone passes with a note beside the call saying timings belong under heavy
--alone. A `time` outside heavy, such as `time gh api ...`, passes without one: agents
time one-off commands that way often, and nothing queues behind them. Nor does it
judge a heavy whose options hold an expansion, which could be --alone, or a timing
inside a script file, which it can't see. A subagent's call (the event has an agent_id)
gets the same verdict, but its refusal names the blocking form, plain bgrun in the
foreground and then waitone, since a subagent doesn't end its turn to wait for a job
(subagent-wait-gate).

It reads the command as shell words and looks only at what runs: each simple command's
command word, past variable settings, redirections, keywords such as `if` and `do`, and
wrappers such as timeout, nice, env, nohup, sudo and xargs; the script of `bash -c`,
`eval` and a heredoc fed to a shell; $(...) and backticks outside single quotes; and
<(...) and >(...) outside quotes. A word that only mentions heavy (`grep heavy`, a
commit message, a heredoc's body, a comment, a path such as .../heavy-queue-race)
passes. So do `heavy status` and `heavy -h`, which return at once; `bgrun -o LOG --
heavy -- CMD` without --wait, which returns once CMD has started; and a heavy with
HEAVY_DIR or HEAVY_SLOT set in front of it, which uses a queue of its own or runs inside
a job. A command shlex can't parse, such as one with a quote left open, is split without
regard to quotes, which errs toward refusing.

    heavy-gate < hook-input.json    # as Claude Code calls it

Exit status: 0 allowed (a note, when there is one, on stdout as the hook's JSON), 2
refused (the reason on stderr, ending with a sentence saying nothing in the command
ran), 1 input that isn't JSON.
"""

import json
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import refused
from shellparse import (
    SHELLS,
    bgrun_command,
    command_of,
    commands,
    commit_args,
    is_help,
    prepare,
    reads_stdin,
    shell_script,
    unwrap,
)

RIGHT_FORM = (
    "bgrun --wait -o <scratchpad>/LOG -- heavy -- CMD, as a background call "
    "(run_in_background: true)"
)
FOREGROUND = (
    "Refused: heavy waits its turn with no time limit, and a Bash call that waits on it "
    f"is killed at the tool's limit. Run {RIGHT_FORM}. Only a run of seconds, such as "
    "a few tests, may run in the foreground, as heavy --few-seconds -- CMD with the "
    "call's timeout at 600000; heavy stops one past 60 s.\n"
    "Where a background call can't notify you, drop --wait, then wait with "
    "`waitone --pid PID -t 300` and read LOG."
)
WRONG_ORDER = f"Refused: heavy goes inside bgrun, not around it: {RIGHT_FORM}."
RUN_BARE = "Refused: git commit and wt-ship queue their own checks; run them bare, not under heavy."
MUTATE_LONG = (
    "Refused: mutate-check --diff runs its command once per mutant and holds a lane "
    "for minutes, so it goes in the long lane, beside the commit checks rather than "
    "ahead of them: run bgrun --wait -o <scratchpad>/LOG -- heavy --long -- "
    "mutate-check --diff ..., as a background call (run_in_background: true)."
)
LONGEST_TIMEOUT_MS = 600000
# heavy's flag for seconds of work, and the old name it still takes.
QUICK_FLAGS = ("--few-seconds", "--quick")
LONG_FLAGS = ("--long",)
QUICK_TIMEOUT = (
    "Refused: heavy --few-seconds can wait minutes at the queue's front, past this "
    "call's time limit (two minutes by default). Set the Bash tool's timeout parameter to "
    f"{LONGEST_TIMEOUT_MS} (ms; a timeout command doesn't count), or run the call in the "
    "background (run_in_background: true)."
)
UNBOUNDED_TIMING = (
    "Refused: a timing under plain heavy or outside heavy carries whatever else runs "
    "on its cores, and this one has no bound. To compare commands, run bgrun --wait -o "
    "<scratchpad>/LOG -- heavy-bench ... bare, never inside heavy, as a background call "
    "(run_in_background: true; heavy-bench -h): each run is its own heavy --alone job, "
    "the variants interleaved. A single short timing goes under heavy --alone, with a "
    "`timeout N` around it or hyperfine's --runs N."
)
# Not a refusal: the note an allowed call gets beside it.
PLAIN_TIMING = (
    "heavy-gate: this call times a command outside heavy --alone, so its numbers carry "
    "whatever else ran on its cores. Time it again under heavy --alone for a figure "
    "worth quoting; a comparison that takes more than a minute or two in all goes to "
    "heavy-bench, started bare with bgrun (heavy-bench -h)."
)
# Most specific first: the first that applies is the one printed.
REFUSALS = (
    RUN_BARE,
    WRONG_ORDER,
    MUTATE_LONG,
    UNBOUNDED_TIMING,
    FOREGROUND,
    QUICK_TIMEOUT,
)
# A subagent's prompt cache lasts five minutes, and its parent spends a turn on each of
# its stops, so it blocks on the job rather than wait for a background call's
# notification; its Bash calls go to the background after 180 s.
SUBAGENT_FORM = (
    "bgrun -o <scratchpad>/LOG -- heavy -- CMD in the foreground, which prints the "
    "job's PID at once, then `waitone --pid PID -t 170`, again until it exits (a "
    "subagent's Bash call goes to the background after 180 s), and read LOG"
)
SUBAGENT = {
    FOREGROUND: (
        "Refused: heavy waits its turn with no time limit, and a Bash call that waits on "
        f"it is killed at the tool's limit. In a subagent, run {SUBAGENT_FORM}. Only a "
        "run of seconds, such as a few tests, may run in the foreground, as heavy "
        f"--few-seconds -- CMD with the call's timeout at {LONGEST_TIMEOUT_MS}; heavy"
        " stops one past 60 s."
    ),
    WRONG_ORDER: f"Refused: heavy goes inside bgrun, not around it: {SUBAGENT_FORM}.",
    MUTATE_LONG: (
        "Refused: mutate-check --diff runs its command once per mutant and holds a lane "
        "for minutes, so it goes in the long lane, beside the commit checks rather than "
        "ahead of them. In a subagent, run bgrun -o <scratchpad>/LOG -- heavy --long -- "
        "mutate-check --diff ... in the foreground, which prints the job's PID at once, "
        "then `waitone --pid PID -t 170`, again until it exits, and read LOG."
    ),
    UNBOUNDED_TIMING: (
        "Refused: a timing under plain heavy or outside heavy carries whatever else "
        "runs on its cores, and this one has no bound. To compare commands, run bgrun "
        "-o <scratchpad>/LOG -- heavy-bench ... bare, never inside heavy, in the "
        "foreground, which prints the job's PID at once, then `waitone --pid PID -t "
        "170`, again until it exits (heavy-bench -h): each run is its own heavy --alone "
        "job, the variants interleaved. A single short timing goes under heavy --alone, "
        "with a `timeout N` around it or hyperfine's --runs N."
    ),
    QUICK_TIMEOUT: (
        "Refused: heavy --few-seconds can wait minutes at the queue's front, past this "
        "call's time limit (two minutes by default). Set the Bash tool's timeout "
        "parameter to "
        f"{LONGEST_TIMEOUT_MS} (ms; a timeout command doesn't count), or run "
        f"{SUBAGENT_FORM}."
    ),
}

# Set in front of heavy, these give it a queue of its own or put it inside a job.
OWN_QUEUE = {"HEAVY_DIR", "HEAVY_SLOT"}
ALONE_FLAGS = ("--alone",)
# hyperfine's options that cap its runs: -r 3, -r3, --runs 3, --runs=3, and -M for
# --max-runs, also behind its short flags that take no value, as in -Nr3. --min-runs
# and --warmup cap nothing.
RUN_CAP = re.compile(r"-[Ni]*[rM]\d*|--(runs|max-runs)(=.*)?")


def refusals(command: str, blocks: bool) -> set[str]:
    """The refusals a shell command earns. ``blocks``: the Bash call waits for it."""
    cleaned, substitutions, heredocs = prepare(command)
    found = set()
    for simple in commands(cleaned):
        found |= judge(simple.words, blocks)
    for substitution in substitutions:
        found |= refusals(substitution, blocks)
    for opener, body in heredocs:
        opened = commands(prepare(opener)[0])
        if any(reads_stdin(simple.words) for simple in opened):
            found |= refusals(body, blocks)
    return found


def judge(words: list[str], blocks: bool, bounded: bool = False) -> set[str]:
    """The refusals one simple command earns, and PLAIN_TIMING for the note.
    ``bounded``: a `timeout` outside it limits its run."""
    words, assigned, wrappers = unwrap(words)
    if not words:
        return set()
    bounded = bounded or "timeout" in wrappers
    name, args = Path(words[0]).name, words[1:]
    if name in SHELLS:
        script = shell_script(words)
        return refusals(script, blocks) if script is not None else set()
    if name == "eval":
        return refusals(" ".join(args), blocks)
    if name == "bgrun":
        parsed = bgrun_command(args)
        if parsed is None:
            return set()
        waits, rest = parsed
        return judge(rest, blocks and waits, bounded)
    if name == "hyperfine":
        return timing_verdict(timings(words, bounded))
    if name != "heavy" or assigned & OWN_QUEUE:
        return set()
    queued = heavy_command(args)
    if queued is None:
        return set()
    inner, _ = command_of(queued)
    inner_name = Path(inner[0]).name if inner else ""
    commits = inner_name == "git" and commit_args(inner[1:]) is not None
    if inner_name == "wt-ship" or commits:
        return {RUN_BARE}
    if inner_name == "bgrun":
        return {WRONG_ORDER}
    found = set()
    if not asks(args, LONG_FLAGS) and mutates_a_diff(queued):
        found.add(MUTATE_LONG)
    if not asks(args, ALONE_FLAGS) and not expands(options_of(args)):
        # heavy stops a --few-seconds run at 60 s.
        quick = asks(args, QUICK_FLAGS)
        found |= timing_verdict(timings(queued, bounded or quick))
    if blocks:
        found.add(QUICK_TIMEOUT if asks(args, QUICK_FLAGS) else FOREGROUND)
    return found


def timing_verdict(bounds: list[bool]) -> set[str]:
    """What the timings a command runs, each given as whether its run is bounded, earn:
    a refusal for any unbounded one, else the note."""
    if not bounds:
        return set()
    return {PLAIN_TIMING} if all(bounds) else {UNBOUNDED_TIMING}


def timings(words: list[str], bounded: bool) -> list[bool]:
    """Each timing a simple command runs, as whether its run is bounded: `time` (the
    keyword or /usr/bin/time), hyperfine and `perf stat`, itself or in a shell's -c
    script. A `timeout` around a timing or inside it bounds it, as does a --runs or
    --max-runs cap on hyperfine; ``bounded``, something outside the command."""
    inner, _, wrappers = unwrap(words)
    if not inner:
        return []
    bounded = bounded or "timeout" in wrappers
    name, args = Path(inner[0]).name, inner[1:]
    if name == "hyperfine":
        if any(is_help(word) or word in ("-V", "--version") for word in args):
            return []
        return [bounded or any(RUN_CAP.fullmatch(word) for word in args)]
    perf_stat = (name, args[:1]) == ("perf", ["stat"])
    found = [bounded] if "time" in wrappers or perf_stat else []
    if name in SHELLS:
        script = shell_script(inner)
        if script is not None:
            found += script_timings(script, bounded)
    return found


def script_timings(script: str, bounded: bool) -> list[bool]:
    """``timings`` for each command of a shell script, its command substitutions
    included."""
    cleaned, substitutions, _ = prepare(script)
    found = []
    for simple in commands(cleaned):
        found += timings(simple.words, bounded)
    for substitution in substitutions:
        found += script_timings(substitution, bounded)
    return found


def mutates_a_diff(words: list[str]) -> bool:
    """Whether a command heavy queues runs `mutate-check --diff`, itself or in a shell's
    -c script. mutate-check takes its options whole, never abbreviated or as --diff=, so
    --diff is the exact word among the words before its `--`; an expansion there could
    be --diff, so it counts as one. `mutate-check -h` returns at once."""
    words, _ = command_of(words)
    if not words:
        return False
    name, args = Path(words[0]).name, words[1:]
    if name in SHELLS:
        script = shell_script(words)
        return script is not None and script_mutates_a_diff(script)
    if name != "mutate-check" or args[:1] in (["-h"], ["--help"]):
        return False
    options = args[: args.index("--")] if "--" in args else args
    return any(word == "--diff" or "$" in word for word in options)


def script_mutates_a_diff(script: str) -> bool:
    """Whether a shell script runs `mutate-check --diff`, in its own commands or its
    command substitutions."""
    cleaned, substitutions, _ = prepare(script)
    return any(mutates_a_diff(simple.words) for simple in commands(cleaned)) or any(
        map(script_mutates_a_diff, substitutions)
    )


def heavy_command(args: list[str]) -> list[str] | None:
    """The command heavy queues to run, or None when heavy returns at once: `status`,
    help, or a usage error. An expansion among the arguments, as in `heavy "$@"`, could
    be anything, so heavy counts as queueing it."""
    for i, word in enumerate(args):
        if word == "--":
            return args[i + 1 :] or None
        if is_help(word):
            return None
    return args if any("$" in word for word in args) else None


def options_of(args: list[str]) -> list[str]:
    """heavy's options: the words before its `--`."""
    return args[: args.index("--")] if "--" in args else []


def expands(words: list[str]) -> bool:
    """Whether any word holds an expansion, which could be any option."""
    return any("$" in word for word in words)


def asks(args: list[str], flags: tuple[str, ...]) -> bool:
    """Whether heavy's options ask for one of flags, whole or abbreviated as heavy's
    parser accepts."""
    return any(
        len(word) > 2 and any(flag.startswith(word) for flag in flags)
        for word in options_of(args)
    )


def has_longest_timeout(timeout) -> bool:
    """Whether the Bash call's timeout, in ms, is the tool's longest. Claude Code sends
    a number; a numeric string counts too, and anything else counts as no timeout."""
    try:
        return float(timeout) >= LONGEST_TIMEOUT_MS
    except (TypeError, ValueError, OverflowError):
        return False


def main(argv=None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if any(arg in ("-h", "--help") for arg in argv):
        print(__doc__)
        return 0
    try:
        event = json.load(sys.stdin)
    except json.JSONDecodeError as error:
        print(
            f"heavy-gate: the hook input isn't JSON ({error}); it reads the PreToolUse "
            "event Claude Code sends on stdin.",
            file=sys.stderr,
        )
        return 1
    if event.get("tool_name") != "Bash":
        return 0
    tool_input = event.get("tool_input") or {}
    background = tool_input.get("run_in_background") in (True, "true")
    found = refusals(tool_input.get("command") or "", blocks=not background)
    if has_longest_timeout(tool_input.get("timeout")):
        found.discard(QUICK_TIMEOUT)
    for refusal in REFUSALS:
        if refusal in found:
            if event.get("agent_id"):
                refusal = SUBAGENT.get(refusal, refusal)
            print(f"{refusal} {refused.ending(event)}", file=sys.stderr)
            return 2
    if PLAIN_TIMING in found:
        output = {"hookEventName": "PreToolUse", "additionalContext": PLAIN_TIMING}
        print(json.dumps({"hookSpecificOutput": output}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
