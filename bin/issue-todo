#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# ///
"""A GitHub issue's task-list items, across its body and its comments, and ticking one.

`gh issue view N` prints the body without the comments, and `--comments` the comments
without the body, so a to-do list split between them reads as two partial lists.
`show` prints every item in one place; `tick` checks one off where it lives; `open`
prints every open issue's open items, leaving out pull requests and ticked items.
`open --titles` prints one line per open issue instead: its number, its title, and how
many open items it has, if any. That is enough to find an issue by its subject.
`unticked N...` prints each unticked item as `#N TEXT`, one a line, for a script:
wt-ship lists them for each issue a landing closes.

    issue-todo open
    issue-todo open --titles          # a line like "#16 Site design (3 open items)"
    issue-todo show 42
    issue-todo read 42 43             # body and every comment, which gh splits in two
    issue-todo unticked 42 43         # each unticked item, as "#42 TEXT", one a line
    issue-todo claim 42               # refuses while another session holds a claim
    issue-todo release 42
    issue-todo tick 42 "forecast measure" --note "built in 8d5068e"
    issue-todo tick 42 "Add hub" --undo
    issue-todo tick 42 "Add hub" --dry-run

An item is a list line with a box, `- [ ] text`, `1. [x] text` and the like, outside
fenced code. `tick` finds the one open item (a ticked one with --undo) whose text
contains MATCH, or equals it, in the body or any comment, ticks it, appends ` *NOTE*`,
and writes that body or comment back, unless it changed since it was read. No match,
or several, writes nothing and lists the candidates. It calls `gh`, so it acts as
gh's logged-in user, in the current directory's repo unless --repo names one.

`show` and `read` end with a `--- mentions` section: each issue or pull request of the
repo that the issue mentions as `#N` outside code, in order, with its state, its count
of open items and its title, such as `#25 open, 1 open item: Agents offer to post`. One
GraphQL call fetches them all, so a plan issue tells which of its steps are done.

`claim` and `release` keep a claim in the issue's comments, each with a hidden marker
`<!-- issue-todo claim ID -->` (or `release`), so two sessions don't both take one
issue. ID is the session's name: --as NAME, else $CLAUDE_CODE_SESSION_ID's first 8
characters. `claim` refuses while a claim by another ID stands unreleased.
"""

import argparse
import json
import os
import re
import subprocess
import sys
from collections.abc import Iterator
from dataclasses import dataclass

BOX = re.compile(r"^(\s*(?:[-*+]|\d+[.)])\s+\[)([ xX])(\]\s+)(.*)$")
FENCE = re.compile(r"^\s*(`{3,}|~{3,})")
WIDTH = 100  # show cuts an item's text to this many characters
# `#N`, but not `owner/repo#N`, `a#N` or an HTML entity's `&#N`.
MENTION = re.compile(r"(?<![\w/&])#(\d+)\b")
INLINE_CODE = re.compile(r"(`+).+?\1", re.DOTALL)  # within one paragraph
PARAGRAPH_BREAK = re.compile(r"\n[ \t]*\n")


@dataclass(frozen=True)
class Item:
    line: int  # its line's index in the markdown, split on "\n"
    done: bool
    text: str


@dataclass(frozen=True)
class Part:
    """The issue's body, or one of its comments: where items live, and where a tick is written."""

    label: str  # "body", or "comment ID AUTHOR DATE"
    path: str  # its REST path, to read it again and to write it back
    markdown: str


def outside_fences(markdown: str) -> Iterator[tuple[int, str]]:
    """Each line of `markdown` outside fenced code, with its index, without its "\\r". A
    fence closes only on a fence of its own character, at least as long."""
    fence = None
    for i, line in enumerate(markdown.split("\n")):
        line = line.removesuffix("\r")
        if m := FENCE.match(line):
            mark = m.group(1)
            if fence is None:
                fence = mark
            elif mark[0] == fence[0] and len(mark) >= len(fence):
                fence = None
        elif fence is None:
            yield i, line


def items(markdown: str) -> list[Item]:
    """The task-list items in `markdown`, in order, leaving out lines in fenced code."""
    return [
        Item(i, m.group(2) != " ", m.group(4))
        for i, line in outside_fences(markdown)
        if (m := BOX.match(line))
    ]


def tick(markdown: str, item: Item, note: str | None, undo: bool = False) -> str:
    """`markdown` with the item's box ticked (or cleared, with `undo`) and ` *NOTE*`
    after its text. The line keeps its ending, "\\r\\n" included."""
    lines = markdown.split("\n")
    line = lines[item.line]
    cr = "\r" if line.endswith("\r") else ""
    m = BOX.match(line.removesuffix("\r"))
    assert m, f"line {item.line} holds no task-list item"
    text = m.group(4) + (f" *{note}*" if note else "")
    lines[item.line] = f"{m.group(1)}{' ' if undo else 'x'}{m.group(3)}{text}{cr}"
    return "\n".join(lines)


def short(text: str) -> str:
    return text if len(text) <= WIDTH else text[: WIDTH - 1] + "…"


def gh(*args: str, stdin: str | None = None, check: bool = True) -> str:
    """gh's output; exits with gh's message when it fails, unless `check` is off."""
    r = subprocess.run(
        ["gh", *args], input=stdin, capture_output=True, text=True, check=False
    )
    if r.returncode != 0 and not check and not r.stdout.strip():
        print(
            f"issue-todo: gh {' '.join(args[:2])}: {r.stderr.strip()[-300:]}",
            file=sys.stderr,
        )
    if r.returncode != 0 and check:
        sys.exit(
            f"issue-todo: gh {' '.join(args[:3])} failed: {r.stderr.strip()[-300:]}"
        )
    return r.stdout


def parts(repo: str, number: int) -> tuple[dict, list[Part]]:
    """The issue, and its body and comments as parts, in order."""
    issue = json.loads(gh("api", f"repos/{repo}/issues/{number}"))
    return issue, issue_parts(repo, issue)


def issue_parts(repo: str, issue: dict) -> list[Part]:
    """The issue's body and comments as parts, in order. The issue as GitHub serves it,
    alone or in a listing, carries its comment count, so one with none costs no call."""
    number = issue["number"]
    if issue.get("comments") == 0:  # a missing count fetches them
        comments = []
    else:
        comments = json.loads(
            gh("api", "--paginate", f"repos/{repo}/issues/{number}/comments")
        )
    found = [Part("body", f"repos/{repo}/issues/{number}", issue.get("body") or "")]
    for c in comments:
        label = f"comment {c['id']} {c['user']['login']} {c['created_at'][:10]}"
        found.append(
            Part(label, f"repos/{repo}/issues/comments/{c['id']}", c.get("body") or "")
        )
    return found


def show(repo: str, number: int) -> int:
    issue, found = parts(repo, number)
    print(f"#{issue['number']} {issue['title']} ({issue['state']})")
    for part in found:
        listed = items(part.markdown)
        if not listed:
            continue
        print(part.label)
        for i, item in enumerate(listed, 1):
            print(f"  [{'x' if item.done else ' '}] {i}  {short(item.text)}")
    print_mentions(repo, issue["number"], found)
    return 0


def prose(markdown: str) -> str:
    """`markdown` without its fenced code blocks and inline code spans. A code span
    ends at its paragraph's end, so a stray backtick hides nothing past it."""
    text = "\n".join(line for _, line in outside_fences(markdown))
    return "\n\n".join(INLINE_CODE.sub("", p) for p in PARAGRAPH_BREAK.split(text))


def mentions(markdown: str) -> list[int]:
    """The issue numbers `markdown` mentions as `#N`, in order of first mention, leaving
    out code and another repo's `owner/repo#N`."""
    return list(dict.fromkeys(int(n) for n in MENTION.findall(prose(markdown))))


def mentioned(repo: str, numbers: list[int]) -> list[str] | None:
    """A line for each of `numbers` that names an issue or pull request in `repo`: its
    state, its open items if it has any, and its title. One GraphQL call fetches them
    all. None when the call fails; a number that names nothing is left out."""
    owner, name = repo.split("/", 1)
    fields = "state title body comments(first: 100) { nodes { body } }"
    asked = " ".join(
        f"m{n}: issueOrPullRequest(number: {n}) "
        f"{{ ... on Issue {{ {fields} }} ... on PullRequest {{ {fields} }} }}"
        for n in numbers
    )
    query = f"query {{ repository(owner: {json.dumps(owner)}, name: {json.dumps(name)}) {{ {asked} }} }}"
    # A number that names nothing makes gh exit 1, with the rest of the answer intact.
    out = gh("api", "graphql", "-f", f"query={query}", check=False)
    try:
        found = json.loads(out)["data"]["repository"]
    except (ValueError, KeyError, TypeError):
        return None
    lines = []
    for n in numbers:
        node = found.get(f"m{n}")
        if not node:
            continue
        texts = [node.get("body") or ""] + [
            c.get("body") or "" for c in node["comments"]["nodes"]
        ]
        n_open = sum(not item.done for text in texts for item in items(text))
        count = f", {n_open} open item{'s' if n_open > 1 else ''}" if n_open else ""
        lines.append(f"#{n} {node['state'].lower()}{count}: {node['title']}")
    return lines


def print_mentions(repo: str, number: int, found: list[Part]) -> None:
    """The issues and pull requests that `found` mentions, under `--- mentions`."""
    numbers = [
        n for n in mentions("\n".join(part.markdown for part in found)) if n != number
    ]
    if not numbers:
        return
    lines = mentioned(repo, numbers)
    if lines is None:
        print(
            f"issue-todo: couldn't look up the issues #{number} mentions; "
            "`gh auth status` checks gh's login, and the issue above is complete",
            file=sys.stderr,
        )
    elif lines:
        print("--- mentions")
        print("\n".join(lines))


def read(repo: str, numbers: list[int]) -> int:
    """Each issue's title, state, body and every comment, each with author and date."""
    for n, number in enumerate(numbers):
        issue = json.loads(gh("api", f"repos/{repo}/issues/{number}"))
        if n:
            print()
        print(f"#{issue['number']} {issue['title']} ({issue['state']})")
        author = (issue.get("user") or {}).get("login", "?")
        print(f"--- body {author} {(issue.get('created_at') or '')[:10]}".rstrip())
        print((issue.get("body") or "").rstrip())
        found = issue_parts(repo, issue)
        for part in found[1:]:
            print(f"--- {part.label}")
            print(part.markdown.rstrip())
        print_mentions(repo, issue["number"], found)
    return 0


def unticked(repo: str, numbers: list[int]) -> int:
    """Each unticked item of each issue, as `#N TEXT`."""
    for number in numbers:
        for part in parts(repo, number)[1]:
            for item in items(part.markdown):
                if not item.done:
                    print(f"#{number} {item.text}")
    return 0


CLAIM = re.compile(r"<!-- issue-todo (claim|release) (\S+) -->")
NAME = re.compile(r"\S+")  # what CLAIM reads back


def holders(repo: str, number: int) -> dict[str, str]:
    """The sessions holding a claim on the issue, with each claim's date."""
    held = {}
    comments = json.loads(
        gh("api", "--paginate", f"repos/{repo}/issues/{number}/comments")
    )
    for comment in comments:
        for kind, session in CLAIM.findall(comment.get("body") or ""):
            if kind == "claim":
                held.setdefault(session, comment["created_at"][:16].replace("T", " "))
            else:
                held.pop(session, None)
    return held


def post_comment(repo: str, number: int, body: str) -> None:
    gh(
        "api",
        "-X",
        "POST",
        f"repos/{repo}/issues/{number}/comments",
        "--input",
        "-",
        stdin=json.dumps({"body": body}),
    )


def claim(repo: str, number: int, session: str) -> int:
    held = holders(repo, number)
    if session in held:
        print(f"#{number} is already claimed by {session}, since {held[session]}")
        return 0
    if held:
        for other, since in held.items():
            print(
                f"issue-todo: #{number} is claimed by session {other} since {since}, "
                "and not released",
                file=sys.stderr,
            )
        return 1
    post_comment(
        repo,
        number,
        f"Taking this (session {session}); `issue-todo release {number}` frees it.\n"
        f"<!-- issue-todo claim {session} -->",
    )
    print(f"#{number} claimed by {session}")
    return 0


def release(repo: str, number: int, session: str) -> int:
    if session not in holders(repo, number):
        print(
            f"issue-todo: {session} has no claim on #{number} to release",
            file=sys.stderr,
        )
        return 1
    post_comment(
        repo,
        number,
        f"Released (session {session}).\n<!-- issue-todo release {session} -->",
    )
    print(f"#{number} released by {session}")
    return 0


def open_issues(repo: str) -> list[dict]:
    """The repo's open issues, as GitHub lists them, without the pull requests."""
    listing = json.loads(
        gh("api", "--paginate", f"repos/{repo}/issues?state=open&per_page=100")
    )
    return [i for i in listing if "pull_request" not in i]


def show_open(repo: str) -> int:
    done = []  # the open issues with no open item
    for issue in open_issues(repo):
        by_part = [
            (part, [item for item in items(part.markdown) if not item.done])
            for part in issue_parts(repo, issue)
        ]
        with_open = [(part, open_) for part, open_ in by_part if open_]
        if not with_open:
            done.append(f"#{issue['number']}")
            continue
        who = ", ".join(a["login"] for a in issue.get("assignees") or [])
        print(f"#{issue['number']} {issue['title']}" + (f" [{who}]" if who else ""))
        for part, open_ in with_open:
            print(f"  {part.label}")
            for item in open_:
                print(f"    [ ] {short(item.text)}")
    if done:
        print(f"no open items: {' '.join(done)}")
    return 0


def show_titles(repo: str) -> int:
    """One line per open issue, with its count of open items."""
    for issue in open_issues(repo):
        n = sum(
            not item.done
            for part in issue_parts(repo, issue)
            for item in items(part.markdown)
        )
        count = f" ({n} open item{'s' if n > 1 else ''})" if n else ""
        print(f"#{issue['number']} {issue['title']}{count}")
    return 0


def tick_one(
    repo: str, number: int, match: str, note: str | None, undo: bool, dry_run: bool
) -> int:
    _, found = parts(repo, number)
    every = [(part, item) for part in found for item in items(part.markdown)]
    candidates = [(p, i) for p, i in every if match in i.text and i.done == undo]
    exact = [(p, i) for p, i in candidates if i.text == match]
    if len(exact) == 1:
        candidates = exact
    if len(candidates) != 1:
        state = "ticked" if undo else "open"
        print(
            f"issue-todo: {len(candidates)} {state} items match {match!r}",
            file=sys.stderr,
        )
        for part, item in candidates:
            print(f"  {part.label}: {short(item.text)}", file=sys.stderr)
        other = sum(match in i.text and i.done != undo for _, i in every)
        if not candidates and other:
            flag = "tick it without --undo" if undo else "--undo clears it"
            items_do = "item matches" if other == 1 else "items match"
            print(
                f"  {other} {'open' if undo else 'ticked'} {items_do}; {flag}",
                file=sys.stderr,
            )
        return 1
    part, item = candidates[0]
    new = tick(part.markdown, item, note, undo)
    if not dry_run:
        if (json.loads(gh("api", part.path)).get("body") or "") != part.markdown:
            print(
                f"issue-todo: {part.label} changed since it was read; run again",
                file=sys.stderr,
            )
            return 1
        gh(
            "api",
            "-X",
            "PATCH",
            part.path,
            "--input",
            "-",
            stdin=json.dumps({"body": new}),
        )
    print(
        f"{part.label}{' (dry run)' if dry_run else ''}:\n{new.split('\n')[item.line]}"
    )
    return 0


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="issue-todo",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    where = argparse.ArgumentParser(add_help=False)
    where.add_argument("--repo", help="OWNER/REPO; default: the current directory's")
    common = argparse.ArgumentParser(add_help=False, parents=[where])
    common.add_argument("number", type=int, help="the issue's number")
    sub = p.add_subparsers(dest="cmd", required=True)
    what = (
        "every open issue's open items, by issue (number, title, assignees) and by "
        "body or comment, then the open issues with none"
    )
    o = sub.add_parser("open", parents=[where], help=what, description=what)
    o.add_argument(
        "--titles",
        action="store_true",
        help="one line per open issue instead: number, title, count of open items",
    )
    what = "every task-list item in the issue's body and comments, numbered within each"
    sub.add_parser("show", parents=[common], help=what, description=what)
    what = (
        "tick the one open item whose text contains MATCH (or equals it, when several "
        "contain it), appending --note, and write its body or comment back"
    )
    t = sub.add_parser("tick", parents=[common], help=what, description=what)
    t.add_argument("match", help="text the item contains (case-sensitive)")
    t.add_argument("--note", help="appended to the item, in italics")
    t.add_argument("--undo", action="store_true", help="clear a ticked item instead")
    t.add_argument(
        "--dry-run", action="store_true", help="print the new line, write nothing"
    )
    what = "each unticked item of each issue, as `#N TEXT`, one a line"
    u = sub.add_parser("unticked", parents=[where], help=what, description=what)
    u.add_argument("numbers", type=int, nargs="+", metavar="number")
    what = "each issue's title, state, body and every comment, with author and date"
    r = sub.add_parser("read", parents=[where], help=what, description=what)
    r.add_argument("numbers", type=int, nargs="+", metavar="number")
    for name, what in (
        ("claim", "claim the issue for this session, unless another holds it"),
        ("release", "release this session's claim on the issue"),
    ):
        c = sub.add_parser(name, parents=[common], help=what, description=what)
        c.add_argument(
            "--as",
            dest="name",
            help="the claimant's name (default: $CLAUDE_CODE_SESSION_ID's first 8 characters)",
        )
    args = p.parse_args(argv)
    session = ""
    if args.cmd in ("claim", "release"):
        session = args.name or os.environ.get("CLAUDE_CODE_SESSION_ID", "")[:8]
        if not session:
            p.error(f"{args.cmd} needs --as NAME outside a Claude Code session")
        if not NAME.fullmatch(session):
            p.error(f"a claimant's name is one word, without spaces: {session!r}")
    repo = (
        args.repo
        or gh("repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner").strip()
    )
    commands = {
        "open": lambda: show_titles(repo) if args.titles else show_open(repo),
        "show": lambda: show(repo, args.number),
        "unticked": lambda: unticked(repo, args.numbers),
        "read": lambda: read(repo, args.numbers),
        "claim": lambda: claim(repo, args.number, session),
        "release": lambda: release(repo, args.number, session),
        "tick": lambda: tick_one(
            repo, args.number, args.match, args.note, args.undo, args.dry_run
        ),
    }
    return commands[args.cmd]()


if __name__ == "__main__":
    sys.exit(main())
