#!/usr/bin/env python3
"""Keep /build's bookkeeping: the base commit, the refactor base and the repo fingerprint.

    build-state start       record the base (HEAD) and the repo's fingerprint
    build-state refactor    record the refactor base (HEAD), before applying review fixes
    build-state show        print the recorded bases
    build-state finish      fold fixups into the commits they fix, check the fingerprint,
                            print the commits since the base and the test files changed
                            since the refactor base
    build-state review-prompt BRIEF
                            print the review subagent's prompt: the base, the commits,
                            the brief as its spec, the standards sources, and
                            code-review's Standards and Spec briefs, copied verbatim
                            from its SKILL.md (fails when they can't be found there)

The state lives in the worktree's git dir, as build-state.json; finish removes it.

finish folds only fixup!, squash! and amend! commits (`git commit --fixup=SHA`), each
into the commit it names, with an autosquash rebase onto the base. Every other commit
stays as it is, in order, so logically separate commits stay separate. It refuses
uncommitted changes, and on a conflict aborts the rebase and leaves the branch as it was.

The fingerprint is every ref except the work branch and its upstream (a symbolic ref, such
as origin/HEAD, by the ref it points to), and every entry
of the repo's config. When either changed since start, finish names the refs and config
keys (never config values: a remote URL can hold a token), exits 1 and keeps the state,
before folding anything. A fix commit left unfolded (its target is older than the base)
also fails finish. It does not push.

On a detached HEAD, as in a worktree that will land on main, there is no work branch.
There the build's target is the branch the main worktree has checked out, when it's
behind or ahead of the base; otherwise every branch at the base. A target counts
locally and on every remote (refs/heads/X, refs/remotes/*/X). Another session's merge
or push moves it, so a moved target doesn't fail finish: it finishes as usual, then
says "X moved since start: rebase onto it" while HEAD lacks one of its commits.
"""

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path

# tests/x.py, test/x.py, spec/x.rb, test_x.py, x_test.go, x.test.ts, x.spec.js
TEST_FILE = re.compile(
    r"(^|/)(tests?|spec)/|(^|/)test_[^/]*$|_test\.[^/]+$|\.(test|spec)\.[^/]+$"
)


def git(*args: str, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], capture_output=True, text=True, check=check)


def state_file() -> Path:
    return (
        Path(git("rev-parse", "--absolute-git-dir").stdout.strip()) / "build-state.json"
    )


def head() -> str:
    return git("rev-parse", "HEAD").stdout.strip()


def work_refs() -> list[str]:
    """The checked-out branch and its upstream, which the build itself moves (a push moves
    the upstream); empty on a detached HEAD."""
    refs = [git("symbolic-ref", "-q", "HEAD", check=False).stdout.strip()]
    refs.append(
        git("rev-parse", "--symbolic-full-name", "@{u}", check=False).stdout.strip()
    )
    return [ref for ref in refs if ref]


def branch_name(ref: str) -> str | None:
    """X for refs/heads/X or refs/remotes/REMOTE/X; None for any other ref."""
    if ref.startswith("refs/heads/"):
        return ref.removeprefix("refs/heads/")
    if ref.startswith("refs/remotes/"):
        return ref.removeprefix("refs/remotes/").partition("/")[2] or None
    return None


def main_tree_branch() -> str | None:
    """The branch the main worktree has checked out; None when it's detached."""
    first = git("worktree", "list", "--porcelain").stdout.split("\n\n")[0]
    for line in first.splitlines():
        if line.startswith("branch "):
            return line.removeprefix("branch refs/heads/")
    return None


def ancestor(older: str, newer: str) -> bool:
    return git("merge-base", "--is-ancestor", older, newer, check=False).returncode == 0


def target_branches(base: str) -> list[str]:
    """The branches a detached build will land on: the main worktree's branch when it's
    behind or ahead of the base, else every branch at the base, local or remote."""
    main = main_tree_branch()
    if main and (ancestor(base, main) or ancestor(main, base)):
        return [main]
    listed = git("for-each-ref", "--format=%(refname) %(objectname)").stdout
    return sorted(
        {
            name
            for ref, commit in (line.split() for line in listed.splitlines())
            if commit == base and (name := branch_name(ref)) and name != "HEAD"
        }
    )


def behind(branch: str) -> bool:
    """Whether HEAD lacks a commit of the branch, local or any remote's."""
    listed = git(
        "for-each-ref", "--format=%(refname)", "refs/heads", "refs/remotes"
    ).stdout
    return any(
        branch_name(ref) == branch and not ancestor(ref, "HEAD")
        for ref in listed.splitlines()
    )


def fingerprint(work: list[str]) -> dict[str, dict[str, str]]:
    """Every ref but the work refs, and every config entry with its values hashed: a
    value, such as a remote URL, can hold a token."""
    common = git("rev-parse", "--git-common-dir").stdout.strip()
    listed = git("config", "--file", f"{common}/config", "--list").stdout
    values: dict[str, list[str]] = {}
    for entry in listed.splitlines():
        key, _, value = entry.partition("=")
        values.setdefault(key, []).append(value)
    config = {
        key: hashlib.sha1("\n".join(found).encode()).hexdigest()[:12]
        for key, found in values.items()
    }
    # A symbolic ref (origin/HEAD) counts by what it points to, not the commit that
    # resolves to: a push moves origin/main, and with it what origin/HEAD resolves to.
    listed = git("for-each-ref", "--format=%(refname) %(objectname) %(symref)").stdout
    refs = {}
    for line in listed.splitlines():
        name, commit, *target = line.split()
        refs[name] = f"-> {target[0]}" if target else commit
    return {"config": config, "refs": {n: s for n, s in refs.items() if n not in work}}


def changes(
    before: dict[str, dict[str, str]], after: dict[str, dict[str, str]]
) -> list[str]:
    """The config keys and ref names that differ, without their values."""
    return sorted(
        f"{kind} {name}"
        for kind in ("config", "refs")
        for name in before[kind].keys() | after[kind].keys()
        if before[kind].get(name) != after[kind].get(name)
    )


def load(path: Path) -> dict | None:
    if not path.exists():
        print("No build is open here: run `build-state start` first.", file=sys.stderr)
        return None
    return json.loads(path.read_text())


def save(path: Path, state: dict) -> None:
    path.write_text(json.dumps(state, indent=2) + "\n")


def start(args: argparse.Namespace) -> int:
    path = state_file()
    if path.exists() and not args.force:
        base = load(path)["base"]
        print(
            f"A build is already open, from base {base}: finish it, or start --force.",
            file=sys.stderr,
        )
        return 1
    base, work = head(), work_refs()
    targets = [] if work else target_branches(base)
    save(
        path,
        {
            "base": base,
            "work_refs": work,
            "targets": targets,
            "fingerprint": fingerprint(work),
        },
    )
    print(f"base {base}")
    return 0


def refactor(args: argparse.Namespace) -> int:
    path = state_file()
    if (state := load(path)) is None:
        return 1
    state["refactor_base"] = head()
    save(path, state)
    print(f"refactor base {state['refactor_base']}")
    return 0


def show(args: argparse.Namespace) -> int:
    if (state := load(state_file())) is None:
        return 1
    print(f"base {state['base']}")
    if "refactor_base" in state:
        print(f"refactor base {state['refactor_base']}")
    return 0


def fail(*lines: str) -> int:
    print("\n".join(lines), file=sys.stderr)
    return 1


def fold_fixups(base: str) -> bool:
    """Autosquash onto the base; on failure, abort and say why."""
    # ":" accepts the todo list as is, and a squash! commit's combined message.
    env = os.environ | {"GIT_SEQUENCE_EDITOR": ":", "GIT_EDITOR": ":"}
    rebase = subprocess.run(
        ["git", "rebase", "-q", "-i", "--autosquash", base],
        env=env,
        capture_output=True,
        text=True,
        check=False,
    )
    if rebase.returncode == 0:
        return True
    git("rebase", "--abort", check=False)
    fail(
        rebase.stdout + rebase.stderr,
        "Folding the fixups failed; the branch is as it was.",
    )
    return False


def report_tests(refactor_base: str) -> None:
    changed = git("diff", "--name-only", refactor_base, "HEAD").stdout.splitlines()
    if tests := [name for name in changed if TEST_FILE.search(name)]:
        print(f"\nTest files changed since the refactor base ({refactor_base[:12]});")
        print("each change must trace to a review finding:")
        print(git("diff", "--stat", refactor_base, "HEAD", "--", *tests).stdout, end="")


def finish(args: argparse.Namespace) -> int:
    path = state_file()
    if (state := load(path)) is None:
        return 1
    base = state["base"]
    if git("status", "--porcelain", "--untracked-files=no").stdout:
        return fail("There are uncommitted changes: commit or stash them first.")
    targets = set(state.get("targets", []))
    moved, moved_targets = [], set()
    for change in changes(state["fingerprint"], fingerprint(state["work_refs"])):
        kind, _, name = change.partition(" ")
        if kind == "refs" and branch_name(name) in targets:
            moved_targets.add(branch_name(name))
        else:
            moved.append(change)
    if moved:
        return fail(
            "The repo changed outside the work branch since start:",
            *(f"  {name}" for name in moved),
        )
    if not fold_fixups(base):
        return 1
    print(git("log", "--oneline", "--reverse", f"{base}..HEAD").stdout, end="")
    subjects = git("log", "--format=%s", f"{base}..HEAD").stdout.splitlines()
    fixes = ("fixup! ", "squash! ", "amend! ")
    if unfolded := [subject for subject in subjects if subject.startswith(fixes)]:
        return fail(
            "These fix commits before the base, so they weren't folded:",
            *(f"  {subject}" for subject in unfolded),
        )
    if "refactor_base" in state:
        report_tests(state["refactor_base"])
    for branch in sorted(moved_targets):
        if behind(branch):
            print(f"{branch} moved since start: rebase onto it")
    path.unlink()
    return 0


CODE_REVIEW = Path.home() / ".agents/skills/code-review/SKILL.md"
GLOBAL_STANDARDS = "~/.agents/skills/coding/standards.md"
REPO_STANDARDS = ("CODING_STANDARDS.md", "CONTRIBUTING.md", "AGENTS.md", "CLAUDE.md")
BRIEF_LINE = re.compile(r'^- The brief: "(.*)"\s*$')
HEADING = re.compile(r"^(#|\*\*)")
AXIS_HEADING = re.compile(r"^\*\*(Standards|Spec) sub-agent prompt\*\*")
SOURCES_HEADING = "### 3. Identify the standards sources"
REVIEW_PROMPT = """\
Review the changes in {top} since {base}. Report only: edit no files and make no commits.

Diff: `git diff {base}...HEAD`. Commits:
{commits}
Spec: {brief}. Read it in full.

Run two separate reviews and report them under the headings `## Standards` and `## Spec`. \
Don't merge or rerank findings across the two.

## Standards

Standards sources: {sources}, and any other file in the repo that documents how code \
should be written. A repo's own standards win where they conflict with the global ones. \
Read `{sources_heading}` in {skill} for the smell baseline and its rules, and apply it.

Brief, verbatim: "{standards}"

## Spec

Brief, verbatim: "{spec}"
"""


def code_review_briefs(text: str) -> dict[str, str]:
    """code-review's Standards and Spec briefs, verbatim: each is the quoted `- The
    brief:` line under its `**<Axis> sub-agent prompt**` heading, before the next
    heading of any kind."""
    briefs, axis = {}, None
    for line in text.splitlines():
        if HEADING.match(line):
            axis = (heading := AXIS_HEADING.match(line)) and heading.group(1)
        elif axis and (brief := BRIEF_LINE.match(line)):
            briefs[axis] = brief.group(1)
            axis = None
    return briefs


def review_prompt(args: argparse.Namespace) -> int:
    if (state := load(state_file())) is None:
        return 1
    if not args.brief.is_file():
        return fail(f"No brief at {args.brief}.")
    skill = args.skill or CODE_REVIEW
    if not skill.is_file():
        return fail(f"{skill} not found: is code-review installed?")
    text = skill.read_text()
    briefs = code_review_briefs(text)
    missing = [
        f"the {axis} brief" for axis in ("Standards", "Spec") if axis not in briefs
    ]
    if SOURCES_HEADING not in text:
        missing.append(f"the heading {SOURCES_HEADING!r}")
    if missing:
        return fail(
            f"No {' or '.join(missing)} in {skill}: code-review's layout changed,",
            "so update review_prompt in build-state.",
        )
    base = state["base"]
    top = Path(git("rev-parse", "--show-toplevel").stdout.strip())
    sources = [
        GLOBAL_STANDARDS,
        *(str(top / n) for n in REPO_STANDARDS if (top / n).is_file()),
    ]
    print(
        REVIEW_PROMPT.format(
            top=top,
            base=base,
            commits=git("log", "--oneline", "--reverse", f"{base}..HEAD").stdout,
            brief=args.brief.resolve(),
            sources=", ".join(sources),
            sources_heading=SOURCES_HEADING,
            skill=skill,
            standards=briefs["Standards"],
            spec=briefs["Spec"],
        ),
        end="",
    )
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    commands = parser.add_subparsers(dest="command", required=True)
    start_command = commands.add_parser(
        "start", help="record the base and the repo fingerprint"
    )
    start_command.add_argument(
        "--force", action="store_true", help="replace a build that is still open"
    )
    start_command.set_defaults(run=start)
    commands.add_parser("refactor", help="record the refactor base").set_defaults(
        run=refactor
    )
    commands.add_parser("show", help="print the recorded bases").set_defaults(run=show)
    commands.add_parser(
        "finish", help="fold fixups, check the fingerprint, list the commits"
    ).set_defaults(run=finish)
    prompt_command = commands.add_parser(
        "review-prompt", help="print the review subagent's prompt"
    )
    prompt_command.add_argument("brief", type=Path, help="the build's brief file")
    prompt_command.add_argument(
        "--skill",
        type=Path,
        help=f"code-review's SKILL.md, for its two briefs (default {CODE_REVIEW})",
    )
    prompt_command.set_defaults(run=review_prompt)
    args = parser.parse_args(argv)
    return args.run(args)


if __name__ == "__main__":
    sys.exit(main())
