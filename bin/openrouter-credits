#!/usr/bin/env python3
"""Print an OpenRouter account's credits: bought, used and left.

The API key comes from OPENROUTER_API_KEY, else from a .env file in the current
directory (or --env-file). The key is never printed.

    openrouter-credits
    openrouter-credits --env-file ../project/.env
"""

import argparse
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

URL = "https://openrouter.ai/api/v1/credits"
VARIABLE = "OPENROUTER_API_KEY"


def fetch_credits(key: str) -> dict:
    """The account's /api/v1/credits data: total_credits and total_usage, in dollars."""
    request = urllib.request.Request(URL, headers={"Authorization": f"Bearer {key}"})
    with urllib.request.urlopen(request, timeout=20) as response:
        return json.load(response)["data"]


def key_from(env_file: Path) -> str | None:
    """The key from the environment, else from ``env_file``'s OPENROUTER_API_KEY= line."""
    if key := os.environ.get(VARIABLE, "").strip():
        return key
    if not env_file.is_file():
        return None
    for line in env_file.read_text().splitlines():
        name, _, value = line.strip().removeprefix("export ").partition("=")
        if name.strip() == VARIABLE:
            return value.strip().strip("\"'") or None
    return None


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--env-file",
        type=Path,
        default=Path(".env"),
        help="where to look for the key when it isn't in the environment (default ./.env)",
    )
    args = parser.parse_args(argv)
    key = key_from(args.env_file)
    if not key:
        print(
            f"No {VARIABLE} in the environment or in {args.env_file}.", file=sys.stderr
        )
        return 1
    try:
        data = fetch_credits(key)
        bought, used = data["total_credits"], data["total_usage"]
    except urllib.error.HTTPError as error:
        print(f"OpenRouter answered HTTP {error.code} for {URL}.", file=sys.stderr)
        return 1
    except (
        OSError,
        ValueError,
        KeyError,
        TypeError,
    ) as error:  # its text can quote the key
        print(
            f"Couldn't read OpenRouter credits: {type(error).__name__}.",
            file=sys.stderr,
        )
        return 1
    print(
        f"OpenRouter credits: ${bought:.2f} bought, ${used:.2f} used, ${bought - used:.2f} left"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
