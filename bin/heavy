#!/usr/bin/env python3
"""Run a CPU-heavy command when it's its turn and its cores are quiet.

    heavy -- CMD [ARGS...]           a build, a test suite, anything heavy
    heavy --long -- CMD [ARGS...]    a long run, such as a local mutants shard
    heavy --share -- CMD [ARGS...]   a build with no time limits: it may share a lane
    heavy --alone -- CMD [ARGS...]   a timing: no job shares its lane
    heavy status                     each lane's jobs and how busy its cores are

Every session on this VM shares two lanes, each running one job at a time at full
priority, first come first served. A long job runs on the last quarter of the cores;
while one runs or waits, a normal job gets the rest, and otherwise all of them, so a
commit's checks never wait behind a long run. (With fewer than 4 cores, a long job
takes the normal lane.) The head of a lane starts once its cores have stayed under
half busy at every one-second sample for 10 seconds, however long that takes: work
outside the queue holds it up, and `heavy status` shows how busy the cores are. A job
that arrives to a free lane, nobody waiting, starts at the first quiet sample. CMD then
runs in the foreground, pinned to those cores (CARGO_BUILD_JOBS set to match), with
this call's environment, folder, terminal and output, and heavy exits with its status.
Commit checks join the queue on their own, through agent-commit-gate, and so does
wt-ship's --check.

A lane holds one more job when its holder leaves cores idle. The first waiter in line
that asks to (--share) and fits starts beside the holder at nice 10, so the holder
keeps about 90% of any core both want, and the sharer can run several times slower
than alone. So share only work with no wall-clock limits, such as a build: many test
suites have them, from the runner (pytest-timeout, nextest's slow-timeout) or in the
tests themselves (a wait with a deadline), and fail on a busy core for no fault of the
code. Commit checks never share. A waiter fits when 4 GiB of memory are free and
either:
  - heavy has seen both commands exit 0 before, and the waiter's usual cores plus the
    holder's (its usual or its last 10 seconds, whichever is more) come to at most
    three quarters of the holder's cores; or
  - the holder's cores have averaged under 30% busy for 90 seconds.
The sharer runs on the holder's cores, first in line for the OOM killer, with
CARGO_BUILD_JOBS at the cores the holder leaves of that three quarters. It stays
niced to the end, since only root can undo a nice. A job run with --alone never
shares, and no job shares beside it: time things with it.

A command's usual cores come from its last 5 runs that exited 0: the most CPU time
any of them used per second of its run, counting CMD and the processes it waited for.
Every worktree of a repo shares one history, in HEAVY_DIR/history.json.

While it waits, heavy prints a line on stderr when what it waits on changes. When it
joins a lane that already holds two jobs, or has headed its lane for
HEAVY_STALL_SECONDS without quiet cores, it suggests getting build and test results
from GitHub instead: push a topic branch and open a PR (never main).

A command that fails while /proc/vmstat's oom_kill count rises hears on stderr that the
out-of-memory killer may have taken one of its processes, and to run it again if the
failure looks odd.

A heavy started inside a job (HEAVY_SLOT names the job's slot) runs at once, so a
check that calls heavy never waits on itself. A job whose process has ended is
cleared from the queue. Stopping heavy (SIGINT, SIGTERM, SIGHUP) stops CMD's process
group, with SIGKILL after HEAVY_GRACE seconds, and frees its place; CMD also gets
SIGTERM should heavy die.

heavy takes the queue's lock for a moment at each look, and a Ctrl-Z that comes while
it holds it stops heavy only once it lets go. A heavy that has waited
FIFO_LOCK_SECONDS for the lock names the process holding it on stderr, and when that
process is stopped, how to continue it.

Environment:
  HEAVY_DIR            the queue's folder (default /tmp/heavy)
  HEAVY_QUIET_SECONDS  how long the cores must stay quiet (default 10)
  HEAVY_POLL           seconds per sample (default 1)
  HEAVY_SHARE_SECONDS  how long a holder must idle before anyone shares (default 90)
  HEAVY_STALL_SECONDS  how long a head waits before suggesting a PR (default 600)
  HEAVY_GRACE          seconds CMD gets to stop before SIGKILL (default 5)
  FIFO_LOCK_SECONDS    seconds of waiting for the queue's lock before naming its
                       holder (default 5; the tests shorten it)
  HEAVY_BUSY           a file whose number stands in for how busy the cores are (tests)
  HEAVY_MEMINFO        a file that stands in for /proc/meminfo (tests)
  HEAVY_VMSTAT         a file that stands in for /proc/vmstat (tests)
  HEAVY_CORES_USED     a number that stands in for the cores a run used (tests)
  HEAVY_SLOT           set for CMD, to the slot it holds

Exit status: CMD's own; 2 a usage error; 125 heavy couldn't use its queue; 126 CMD
couldn't be run (a folder, or not executable); 127 CMD wasn't found; 128+N stopped
by signal N.
"""

import argparse
import ctypes
import os
import shlex
import signal
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import heavyqueue

STOPS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)
PR_SET_PDEATHSIG = 1


class Stopped(Exception):
    def __init__(self, signum):
        self.signum = signum


def on_signal(signum, _frame):
    raise Stopped(signum)


def die_with_heavy():
    """In CMD, before it starts: get SIGTERM should heavy die, even by SIGKILL."""
    ctypes.CDLL(None, use_errno=True).prctl(PR_SET_PDEATHSIG, signal.SIGTERM)


def hand_terminal(group):
    """Make group the terminal's foreground group, so CMD can read it; a CMD stopped
    for reading before the handover (SIGTTIN) is continued."""
    old = signal.signal(signal.SIGTTOU, signal.SIG_IGN)
    try:
        os.tcsetpgrp(sys.stdin.fileno(), group)
    except OSError:
        pass
    finally:
        signal.signal(signal.SIGTTOU, old)
    try:
        os.killpg(group, signal.SIGCONT)
    except ProcessLookupError:
        pass


def stop(proc):
    """Stop CMD's process group: TERM, then KILL after HEAVY_GRACE seconds. Further
    signals are ignored meanwhile, so a second Ctrl-C can't cut the KILL short."""
    for sig in STOPS:
        signal.signal(sig, signal.SIG_IGN)
    grace = heavyqueue.knob("HEAVY_GRACE", 5)
    for sig, wait in ((signal.SIGTERM, grace), (signal.SIGKILL, None)):
        try:
            os.killpg(proc.pid, sig)
            os.killpg(proc.pid, signal.SIGCONT)  # a stopped group can't act on TERM
        except ProcessLookupError:
            return
        try:
            proc.wait(timeout=wait)
            return
        except subprocess.TimeoutExpired:
            continue


def run(command, long, alone, share):
    with heavyqueue.turn(
        long=long, command=shlex.join(command), alone=alone, share=share
    ) as job:
        job.pin()  # CMD inherits this process's cores
        terminal = sys.stdin.isatty()
        try:
            # heavy runs no threads, so preexec_fn is safe here.
            proc = subprocess.Popen(
                command,
                env=job.env,
                process_group=0,
                preexec_fn=die_with_heavy,  # noqa: PLW1509
            )
        except FileNotFoundError:
            print(f"heavy: no command {command[0]} to run.", file=sys.stderr)
            return 127
        except OSError as error:
            print(f"heavy: can't run {command[0]}: {error.strerror}.", file=sys.stderr)
            return 126
        if terminal:
            hand_terminal(proc.pid)
        try:
            code = proc.wait()
        except Stopped:
            stop(proc)
            raise
        finally:
            if terminal:
                hand_terminal(os.getpgrp())
        job.exited(code)
        return 128 - code if code < 0 else code


def main(argv=None):
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--long", action="store_true", help="a long run: a quarter of the cores"
    )
    beside = parser.add_mutually_exclusive_group()
    beside.add_argument(
        "--alone",
        action="store_true",
        help="never share a lane, as for a timing: no job runs beside this one",
    )
    beside.add_argument(
        "--share",
        action="store_true",
        help="may start beside a lane's holder, at nice 10, for work without time"
        " limits",
    )
    parser.add_argument(
        "command", nargs=argparse.REMAINDER, help="status, or -- CMD [ARGS...]"
    )
    args = parser.parse_args(argv)
    if args.command == ["status"]:
        print(heavyqueue.status())
        return 0
    if args.command[:1] != ["--"] or len(args.command) < 2:
        parser.error("expected `status` or `-- CMD [ARGS...]`")
    for sig in STOPS:
        signal.signal(sig, on_signal)
    try:
        return run(args.command[1:], args.long, args.alone, args.share)
    except Stopped as stopped:
        return 128 + stopped.signum
    except heavyqueue.QueueError as error:
        print(
            f"heavy: can't use its queue ({error}). Fix or remove it, then run again.",
            file=sys.stderr,
        )
        return 125


if __name__ == "__main__":
    sys.exit(main())
