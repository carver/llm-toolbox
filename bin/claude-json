#!/usr/bin/env python3
"""Run one headless Claude call and print its schema-shaped JSON answer.

Reads the prompt on stdin, runs `claude -p --json-schema`, and prints the
reply's structured_output as one line of JSON on stdout. For scripts and cron
jobs that want typed data back from Claude.

Every call bills the Claude subscription: ANTHROPIC_API_KEY is removed from
the child's environment, because `claude -p` prefers it over the login.
(`claude --bare` is no substitute; it reads only the API key.)

The call is locked down for prompts that carry untrusted text. By default it
gets no tools, no user/project/local settings or hooks, no MCP servers, no
saved session, and runs in an empty temporary directory so no CLAUDE.md loads.
--tools opts named tools back in and pre-approves them.

The schema constrains shape, not meaning. Validate the fields in your code.

Exit status: 0 success, 1 the call failed (message on stderr), 2 usage error.
"""

import argparse
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

FAILED, USAGE = 1, 2


class CallFailed(Exception):
    pass


def load_schema(text: str) -> dict:
    """The schema from JSON text or from a path to a JSON file."""
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        pass
    path = Path(text)
    if not path.is_file():
        raise ValueError(f"--schema is neither JSON nor a file: {text[:80]!r}")
    return json.loads(path.read_text())


def claude_command(args: argparse.Namespace, schema: dict) -> list[str]:
    cmd = [
        "claude", "-p",
        "--model", args.model,
        "--output-format", "json",
        "--json-schema", json.dumps(schema),
        "--tools", args.tools,
        "--setting-sources", "",
        "--strict-mcp-config",
        "--no-session-persistence",
    ]
    if args.tools:
        cmd += ["--allowedTools", args.tools]
    if args.system_prompt is not None:
        cmd += ["--system-prompt", args.system_prompt]
    if args.max_budget_usd is not None:
        cmd += ["--max-budget-usd", args.max_budget_usd]
    return cmd


def call(cmd: list[str], prompt: str, timeout: float) -> dict:
    env = {k: v for k, v in os.environ.items() if k != "ANTHROPIC_API_KEY"}
    with tempfile.TemporaryDirectory(prefix="claude-json-") as empty_dir:
        try:
            proc = subprocess.run(cmd, input=prompt, capture_output=True, text=True,
                                  env=env, cwd=empty_dir, timeout=timeout)
        except subprocess.TimeoutExpired:
            raise CallFailed(f"claude timed out after {timeout:g}s")
        except OSError as err:
            raise CallFailed(f"claude did not start: {err}")
    if proc.returncode != 0:
        raise CallFailed(f"claude exited {proc.returncode}: {proc.stderr.strip()[:500]}")
    try:
        reply = json.loads(proc.stdout)
    except json.JSONDecodeError:
        raise CallFailed(f"claude printed non-JSON: {proc.stdout[:200]!r}")
    output = reply.get("structured_output")
    if reply.get("is_error") or not isinstance(output, dict):
        detail = reply.get("subtype") if reply.get("is_error") else str(reply.get("result"))[:300]
        raise CallFailed(f"claude returned no structured output: {detail}")
    return output


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="claude-json", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("-s", "--schema", required=True, help="JSON Schema, as JSON text or a path to a .json file")
    parser.add_argument("-m", "--model", default="sonnet", help="model alias or id (default %(default)s)")
    parser.add_argument("--tools", default="", metavar="LIST",
                        help="comma-separated built-in tools to enable and pre-approve, e.g. WebFetch,WebSearch "
                             "(default: none)")
    parser.add_argument("--system-prompt", metavar="TEXT",
                        help="replace Claude Code's system prompt; cuts about 6k input tokens per call")
    parser.add_argument("--max-budget-usd", metavar="USD", help="stop the call past this spend")
    parser.add_argument("-t", "--timeout", type=float, default=600, metavar="SECONDS",
                        help="kill the call after this long (default %(default)g)")
    args = parser.parse_args(argv)

    try:
        schema = load_schema(args.schema)
    except (ValueError, OSError) as err:
        parser.error(str(err))
    prompt = sys.stdin.read()
    if not prompt.strip():
        parser.error("empty prompt on stdin")

    try:
        output = call(claude_command(args, schema), prompt, args.timeout)
    except CallFailed as err:
        print(f"claude-json: {err}", file=sys.stderr)
        return FAILED
    print(json.dumps(output))
    return 0


if __name__ == "__main__":
    sys.exit(main())
