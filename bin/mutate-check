#!/usr/bin/env python3
"""Break code briefly and see whether a command catches it, then put the code back.

  mutate-check -- uv run pytest -q tests/test_watch.py -k seen_before <<'EDITS'
  --- src/app/watch.py
  <<<<<<< SEARCH
                  and p.listing.id not in sketchy
  =======
  >>>>>>> REPLACE
  EDITS

  mutate-check [--timeout SECONDS] -- CMD...

Pick a heredoc delimiter that isn't a line of the blocks: a line EOF in the text ends
<<'EOF' early, and the shell runs the rest as commands.

Stdin holds apply-edits blocks (`apply-edits -h` shows the format), which apply-edits
applies all or nothing. Then the command runs, and every file the blocks name is put
back byte for byte, also when mutate-check is stopped by Ctrl-C, SIGTERM or SIGHUP.

A failure counts as a catch only when tests ran. A mutation that stops the build (a Rust
`error: could not compile` or `error[E...]`, as unused code under `-D warnings` does),
or pytest exiting 2, 4 or 5 (collection errors, usage, no tests), is inconclusive: no
test judged it. So is a command that runs past --timeout (default 600 seconds), which
is stopped: a hang isn't a catch.

Prints one line, with up to 3 of the command's pytest `E ` lines or Rust `error` lines
when it failed, or its last line of output when there are none; never the whole output.

Exit status: 0 the command failed, so the mutation was caught; 1 it passed, so the
tests miss it; 2 usage error or blocks that didn't apply (the command didn't run);
3 inconclusive: the build failed, no tests ran, or the command hung; 128+N stopped by
signal N.
"""

import importlib.machinery
import importlib.util
import math
import os
import re
import signal
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path
from types import FrameType, ModuleType

CAUGHT, MISSED, USAGE, INCONCLUSIVE = 0, 1, 2, 3
DEFAULT_TIMEOUT = 600.0
# pytest's statuses when no test judged anything: interrupted or collection errors,
# a usage error, no tests collected.
PYTEST_NOTHING_RAN = {2, 4, 5}
BIN = Path(__file__).resolve().parent
SHOWN_ERRORS = 3
STOP_SIGNALS = {signal.SIGINT, signal.SIGTERM, signal.SIGHUP}


class UsageError(Exception):
    pass


class Stopped(Exception):
    def __init__(self, signum: int) -> None:
        self.signum = signum


def apply_edits() -> ModuleType:
    """bin/apply-edits as a module, for its parser: the one place the format lives."""
    path = str(BIN / "apply-edits")
    loader = importlib.machinery.SourceFileLoader("apply_edits", path)
    spec = importlib.util.spec_from_loader("apply_edits", loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


FORMAT = apply_edits()


@dataclass(frozen=True)
class Original:
    content: bytes
    mode: int


def snapshot(paths: list[Path]) -> dict[Path, Original]:
    """The files' bytes and permissions, by their real paths."""
    originals = {}
    for path in paths:
        target = path.resolve()
        if target.is_file():
            originals[target] = Original(target.read_bytes(), target.stat().st_mode)
    return originals


def restore(originals: dict[Path, Original]) -> list[str]:
    """Put each file back as it was, through a temp file beside it so a crash can't leave
    half of one, also when the command deleted it. Signals wait until it's done. Returns
    what couldn't be put back."""
    signal.pthread_sigmask(signal.SIG_BLOCK, STOP_SIGNALS)
    failed = []
    for target, original in originals.items():
        try:
            fd, temp = tempfile.mkstemp(dir=target.parent, prefix=f".{target.name}.")
            with os.fdopen(fd, "wb") as f:
                f.write(original.content)
            os.chmod(temp, original.mode)
            os.replace(temp, target)
        except OSError as e:
            failed.append(f"mutate-check: couldn't put back {target}: {e}")
    return failed


class TimedOut(Exception):
    pass


def run(command: list[str], timeout: float) -> tuple[int, str]:
    """The command's exit status and output. Stopped, or past `timeout` seconds (then
    raising TimedOut), it stops the command too, killing it if it ignores SIGTERM for 5
    seconds ($MUTATE_CHECK_GRACE, which the tests shorten)."""
    # Read before the command starts, so a bad value stops here rather than mid-stop
    grace = float(os.environ.get("MUTATE_CHECK_GRACE", "5"))
    # Its own process group, so stopping it stops what it started, such as the test
    # binaries cargo runs, too.
    child = subprocess.Popen(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    try:
        output, _ = child.communicate(timeout=timeout)
    except Stopped:
        stop_child(child, grace)
        raise
    except subprocess.TimeoutExpired as e:
        stop_child(child, grace)
        raise TimedOut from e
    return child.returncode, output.decode(errors="replace")


def stop_child(child: subprocess.Popen[bytes], grace: float) -> None:
    """Stop the command's process group: SIGTERM, then SIGKILL once `grace` seconds
    pass, or at once when the command has gone but left children behind."""
    signal_group(child, signal.SIGTERM)
    try:
        child.wait(timeout=grace)
    except subprocess.TimeoutExpired:
        pass
    signal_group(child, signal.SIGKILL)
    child.wait()


def signal_group(child: subprocess.Popen[bytes], signum: signal.Signals) -> None:
    try:
        os.killpg(child.pid, signum)
    except ProcessLookupError:
        pass


RUST_BUILD_FAILED = re.compile(r"error: could not compile|error\[E\d+\]")
# A lint that `-D warnings` makes an error: the mutation left an item unused.
RUST_UNUSED = re.compile(
    r"is never (used|read|constructed)|unused `|unused (variable|import)|does not need to be mutable"
)
# A compile error's own line: `error: ...` or `error[E0308]: ...`, or with
# --message-format=short `src/lib.rs:4:5: error: ...`.
RUST_ERROR = re.compile(r"^error(\[E\d+\])?: |^\S+:\d+:\d+: error")
# cargo's and nextest's lines that only say the build failed, after the cause.
RUST_FAILED_ONLY = re.compile(r"^error: (could not compile|command `)")
UNUSED_HINT = (
    "  hint: the mutation left code unused, which -D warnings refuses; keep it used,"
    " such as with `let _ = &name;`, or mutate a condition instead of removing a call"
)
# A cargo or nextest summary line: tests ran, so a failure is theirs.
TESTS_RAN = re.compile(r"^test result: |^\s*Summary \[")


def build_errors(output: str) -> list[str]:
    """Rust's compile errors, when the build failed before any test ran."""
    lines = output.splitlines()
    if any(TESTS_RAN.search(line) for line in lines):
        return []
    if not any(RUST_BUILD_FAILED.match(line) for line in lines):
        return []
    # Each error and the `-->` line that places it, causes first, then cargo's lines
    # that only say the build failed, so the cap on lines shown keeps the cause.
    causes, failed = [], []
    for index, line in enumerate(lines):
        if not RUST_ERROR.match(line):
            continue
        if RUST_FAILED_ONLY.match(line):
            failed.append(line)
            continue
        causes.append(line)
        place = lines[index + 1].strip() if index + 1 < len(lines) else ""
        if place.startswith("-->"):
            causes.append(f"  {place}")
    return causes + failed


def runs_pytest(command: list[str]) -> bool:
    return any(Path(arg).name == "pytest" or arg.endswith("pytest") for arg in command)


def summary(output: str) -> list[str]:
    """Up to SHOWN_ERRORS of pytest's `E ` lines, else the last non-empty line."""
    lines = output.splitlines()
    errors = [line for line in lines if line.startswith("E ")]
    if errors:
        return errors[:SHOWN_ERRORS]
    last = next((line for line in reversed(lines) if line.strip()), None)
    return [last] if last is not None else []


def stop(signum: int, _frame: FrameType | None) -> None:
    raise Stopped(signum)


def mutated_run(edits: str, command: list[str], timeout: float) -> tuple[int, str]:
    """Apply the edits, run the command, and give its status and output. Raises
    Stopped, and UsageError when the edits don't apply or the command won't start."""
    applied = subprocess.run(
        [str(BIN / "apply-edits")],
        input=edits,
        text=True,
        capture_output=True,
        check=False,
    )
    if applied.returncode != 0:
        raise UsageError(applied.stderr.rstrip())
    try:
        return run(command, timeout)
    except OSError as e:
        raise UsageError(f"mutate-check: can't run {command[0]}: {e}") from e


def main() -> int:
    args = sys.argv[1:]
    if args[:1] in (["-h"], ["--help"]):
        print(__doc__)
        return 0
    timeout = DEFAULT_TIMEOUT
    if args[:1] == ["--timeout"]:
        try:
            timeout = float(args[1])
        except (IndexError, ValueError):
            timeout = 0.0
        if not (math.isfinite(timeout) and timeout > 0):
            print("mutate-check: --timeout takes a number of seconds", file=sys.stderr)
            return USAGE
        args = args[2:]
    if args[:1] != ["--"] or len(args) < 2:
        print(f"mutate-check: give the command after --\n{__doc__}", file=sys.stderr)
        return USAGE
    edits = sys.stdin.read()
    try:
        files = FORMAT.parse(edits)
    except FORMAT.UsageError as e:
        print(f"apply-edits: {e}", file=sys.stderr)
        return USAGE
    originals = snapshot([f.path for f in files])
    for signum in STOP_SIGNALS:
        signal.signal(signum, stop)
    status: int | None = None
    try:
        code, output = mutated_run(edits, args[1:], timeout)
    except UsageError as e:
        print(e, file=sys.stderr)
        status = USAGE
    except TimedOut:
        print(
            f"mutate-check: inconclusive: the command hung past {timeout:g} seconds"
            " and was stopped; a hang isn't a catch"
        )
        status = INCONCLUSIVE
    except Stopped as e:
        print(f"mutate-check: stopped by signal {e.signum}", file=sys.stderr)
        status = 128 + e.signum
    finally:
        failed = restore(originals)
    if failed:
        print("\n".join(failed), file=sys.stderr)
        return USAGE
    if status is not None:
        return status
    if code == 0:
        print("mutate-check: not caught: the command passed with the mutation")
        return MISSED
    errors = build_errors(output)
    if errors or (runs_pytest(args[1:]) and code in PYTEST_NOTHING_RAN):
        print(
            f"mutate-check: inconclusive: the command exited {code} before any test"
            " judged the mutation"
        )
        for line in (errors or summary(output))[:SHOWN_ERRORS]:
            print(f"  {line}")
        if any(RUST_UNUSED.search(line) for line in errors):
            print(UNUSED_HINT)
        return INCONCLUSIVE
    print(f"mutate-check: caught: the command exited {code}")
    for line in summary(output):
        print(f"  {line}")
    return CAUGHT


if __name__ == "__main__":
    sys.exit(main())
