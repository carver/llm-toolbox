#!/usr/bin/env python3
"""Time commands against each other in short heavy --alone jobs, interleaved.

    heavy-bench --out DIR [--rounds N] [--warmup] [--prepare CMD] [--no-rerun] \\
        NAME[@REV]=CMD [NAME[@REV]=CMD ...]

Each run of a variant's CMD (`sh -c CMD`, in this folder) is its own
`heavy --alone` job, so heavy's queue holds one of this bench's jobs at a time and
other sessions' jobs go between its runs, where one long benchmark job would hold
the queue for all of it. Runs go round by round, each round every variant in the
order given, so a drift in the machine (a cache warming, another session's load)
falls on every variant alike. --warmup runs each variant once first, untimed.
Run it bare, not inside `heavy`: inside a job, heavy runs each run at once and
measures nothing, so heavy-bench refuses. A bench takes minutes, so start it with
`bgrun -o LOG -- heavy-bench ...` and wait for it as for any background job.

--prepare CMD runs before each run, outside heavy and untimed, with BENCH_VARIANT
set to the variant's name, to reset what a run left behind; one that fails stops
the bench. To time a build after an edit, have it change the file's bytes, not
`touch` it: a compile cache such as sccache keys on contents, and serves an
unchanged file's build from its cache in a second.

A variant named NAME@REV runs, and its --prepare runs, in a worktree of the
current repo detached at REV, made before the first run beside the main tree as
`<repo>-wt-bench-NAME` and removed at the end, also when the bench is stopped; so
`old@HEAD~1=CMD new@HEAD=CMD` times a change against its parent. A REV git can't
resolve, a path already taken, or a folder outside any repo is a usage error, before
anything runs. A worktree builds from cold, so give the bench --warmup.

Each run may write its parts' timings to the file BENCH_TIMINGS names, a line each:
a name of one word and its seconds (`clippy 9.4`); other lines are left out. They go
in the row's parts column as `name=seconds` joined by commas, and the table gives
each variant's mean of each part over its counted runs. A command that writes such a
file under a variable of its own can be pointed at it, as a commit check that writes
CHECK_TIMINGS is with `CHECK_TIMINGS="$BENCH_TIMINGS" CMD`.

heavy reports what other work used the job's cores while it ran (`heavy -h`). A run
past HEAVY_ALONE_OUTSIDE cores of it on average (0.5) is flagged and run once more
at once, unless --no-rerun; both rows are kept. A warmup run is never rerun.

Each run's output goes to DIR/NAME-ROUND.log (-ATTEMPT added for a rerun), and its
row to DIR/results.tsv as it ends: variant, round, attempt, wall seconds (from
heavy, so time spent in the queue doesn't count; `-` when heavy gave no measure,
and the run counts for nothing), user and sys seconds (CMD's, plus
heavy's own, which polls once a second while it waits its turn), outside
CPU-seconds, exit status, flagged, the machine's speed at the run's start and end
(heavy's speed factors, `-` before it knows the usual speed), parts. A run at a low
speed is neither flagged nor rerun, since a throttled spell can outlast the whole
bench and would flag every run; the columns show which runs it slowed. DIR must not
hold results already, so
a stopped bench's rows are never overwritten. At the end a table sums up each
variant over its runs that were measured and neither flagged nor failed.

Stopping it (SIGINT, SIGTERM, SIGHUP) stops the run's heavy job, which frees its
place in the queue, then prints the table of what it measured; so does a run that
ends by one of those signals, as when Ctrl-C at a terminal reaches CMD.

Environment:
  HEAVY_ALONE_OUTSIDE  heavy's threshold for a run's outside load, in cores
                       (default 0.5)
  BENCH_VARIANT        set for --prepare, to the variant about to run
  BENCH_TIMINGS        set for each run, to the file its parts' timings go to
  HEAVY_SLOT           set inside a heavy job, where heavy-bench refuses to run

Exit status: 0 every timed run exited 0; 1 a run or a prepare failed; 2 a usage
error; 128+N stopped by signal N.
"""

import argparse
import os
import re
import signal
import statistics
import subprocess
import sys
import tempfile
from pathlib import Path

HEAVY = Path(__file__).resolve().parent / "heavy"
FIELDS = [
    "variant",
    "round",
    "attempt",
    "wall",
    "user",
    "sys",
    "outside",
    "exit",
    "flagged",
    "start_speed",
    "end_speed",
    "parts",
]
# A part's name holds neither `=` nor `,`, the parts column's own separators.
PART = re.compile(r"([^\s=,]+)\s+(\d+(?:\.\d+)?)")
STOPS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)
STOPPED_BY = {128 + sig for sig in STOPS}


class Stopped(Exception):
    def __init__(self, signum):
        self.signum = signum


def variants(specs, parser):
    """Each variant's command, and the REV of those named NAME@REV."""
    found, revs = {}, {}
    for spec in specs:
        name, _, command = spec.partition("=")
        name, at, rev = name.partition("@")
        # With no `=`, the command partition finds is empty.
        # NAME@ with no REV fails as an unknown commit, in bench_trees.
        if not name or not command:
            parser.error(f"expected NAME=CMD or NAME@REV=CMD, got {spec!r}")
        if name in found:
            parser.error(f"variant {name!r} named twice")
        found[name] = command
        if at:
            revs[name] = rev
    if not found:
        parser.error("give at least one NAME=CMD")
    return found, revs


def git(*args, cwd=None):
    """git's stdout, or None when it fails."""
    done = subprocess.run(
        ["git", *args], cwd=cwd, capture_output=True, text=True, check=False
    )
    return done.stdout.strip() if done.returncode == 0 else None


def bench_trees(revs, parser):
    """Each NAME@REV variant's worktree path, beside the current repo's main tree,
    once its REV resolves and the path is free: else a usage error."""
    common = git("rev-parse", "--path-format=absolute", "--git-common-dir")
    if revs and common is None:
        parser.error("a NAME@REV variant needs a git repo here, and git finds none")
    trees = {}
    for name, rev in revs.items():
        if git("rev-parse", "--verify", "--quiet", f"{rev}^{{commit}}") is None:
            parser.error(f"variant {name}: git can't resolve {rev!r} to a commit")
        main = Path(common).parent
        tree = main.parent / f"{main.name}-wt-bench-{name}"
        if tree.exists():
            parser.error(f"variant {name}: {tree} is taken; remove it or rename")
        trees[name] = tree
    return trees


def add_trees(trees, revs):
    """Add each worktree at its REV; False, saying why, when git can't."""
    for name, tree in trees.items():
        done = subprocess.run(
            ["git", "worktree", "add", "-q", "--detach", str(tree), revs[name]],
            capture_output=True,
            text=True,
            check=False,
        )
        if done.returncode != 0:
            why = (done.stderr.strip().splitlines() or ["no reason given"])[-1]
            print(
                f"heavy-bench: git couldn't add {tree} at {revs[name]}: {why}",
                file=sys.stderr,
            )
            return False
    return True


def remove_trees(trees):
    """Remove the worktrees, with stop signals ignored, so none is left half done."""
    for sig in STOPS:
        signal.signal(sig, signal.SIG_IGN)
    for tree in trees.values():
        if tree.exists():
            git("worktree", "remove", "--force", str(tree))


def parts(path):
    """The `name=seconds` pairs of the parts a run wrote, joined by commas."""
    found = (PART.fullmatch(line.strip()) for line in path.read_text().splitlines())
    return ",".join(f"{m[1]}={m[2]}" for m in found if m)


def limit(parser):
    """heavy's HEAVY_ALONE_OUTSIDE, which a value that isn't a number makes a usage
    error here: heavy would measure nothing for any run."""
    text = os.environ.get("HEAVY_ALONE_OUTSIDE", "0.5")
    try:
        return float(text)
    except ValueError:
        parser.error(f"HEAVY_ALONE_OUTSIDE is {text!r}, not a number of cores")


def timed(command, log, cwd=None):
    """Run command as a heavy --alone job, in `cwd`: (exit, wall, user, sys, outside,
    speeds, parts), wall None when heavy wrote no report, speeds the machine's speed
    factors at its start and end as heavy wrote them (`-` unknown). A stop signal
    meanwhile goes on to heavy, which stops CMD and frees its place; the run then ends
    with heavy's 128+N."""
    with (
        tempfile.NamedTemporaryFile("r", prefix="heavy-bench-") as report,
        tempfile.NamedTemporaryFile("r", prefix="heavy-bench-parts-") as timings,
    ):
        env = os.environ | {
            "HEAVY_ALONE_REPORT": report.name,
            "BENCH_TIMINGS": timings.name,
        }
        with log.open("w") as out:
            proc = subprocess.Popen(
                [str(HEAVY), "--alone", "--", "sh", "-c", command],
                env=env,
                cwd=cwd,
                stdout=out,
                stderr=subprocess.STDOUT,
            )
            forward = {
                sig: signal.signal(sig, lambda signum, _: proc.send_signal(signum))
                for sig in STOPS
            }
            try:
                _, status, used = os.wait4(proc.pid, 0)
            finally:
                for sig, old in forward.items():
                    signal.signal(sig, old)
        code = os.waitstatus_to_exitcode(status)
        code = 128 - code if code < 0 else code
        words = Path(report.name).read_text().split()
        written = parts(Path(timings.name))
    measured = len(words) >= 3
    wall, _, outside = (float(w) for w in words[:3]) if measured else (None, 0.0, 0.0)
    speeds = (words[3:5] + ["-", "-"])[:2] if measured else ["-", "-"]
    return code, wall, used.ru_utime, used.ru_stime, outside, speeds, written


def counted(row):
    """Whether a timed run counts in the table: measured, and neither flagged nor
    failed. A run heavy gave no measure for has "-" for its wall."""
    return row["flagged"] == "0" and row["exit"] == "0" and row["wall"] != "-"


class Bench:
    def __init__(self, out, prepare, rerun, limit, folders):
        """`folders`: where each NAME@REV variant runs; the rest run here."""
        self.out, self.prepare, self.rerun, self.limit = out, prepare, rerun, limit
        self.trees = folders
        self.rows = []
        out.mkdir(parents=True, exist_ok=True)
        self.tsv = out / "results.tsv"
        self.tsv.write_text("\t".join(FIELDS) + "\n")

    def run(self, name, command, round_):
        """Run one variant's round, rerunning a flagged timed run once; False when a
        prepare failed. Raises Stopped when the run was stopped by a signal."""
        attempts = 2 if self.rerun and round_ != "warmup" else 1
        cwd = self.trees.get(name)
        for attempt in range(1, attempts + 1):
            if self.prepare:
                env = os.environ | {"BENCH_VARIANT": name}
                done = subprocess.run(
                    ["sh", "-c", self.prepare], env=env, cwd=cwd, check=False
                )
                if done.returncode != 0:
                    print(
                        f"heavy-bench: --prepare exited {done.returncode} before {name}"
                        f" round {round_}; stopping.",
                        file=sys.stderr,
                    )
                    return False
            suffix = "" if attempt == 1 else f"-{attempt}"
            log = self.out / f"{name}-{round_}{suffix}.log"
            code, wall, user, sys_, outside, speeds, written = timed(command, log, cwd)
            if wall is None and code not in STOPPED_BY:
                print(
                    f"heavy-bench: heavy gave no measure for {name} round {round_};"
                    " its log says why.",
                    file=sys.stderr,
                )
            flagged = bool(wall) and outside / wall > self.limit
            row = {
                "variant": name,
                "round": str(round_),
                "attempt": str(attempt),
                # heavy's 3 places: a run under 5 ms isn't 0.00, nor taken for one
                # heavy gave no measure for.
                "wall": "-" if wall is None else f"{wall:.3f}",
                "user": f"{user:.2f}",
                "sys": f"{sys_:.2f}",
                "outside": f"{outside:.1f}",
                "exit": str(code),
                "flagged": str(int(flagged)),
                "start_speed": speeds[0],
                "end_speed": speeds[1],
                "parts": written,
            }
            self.rows.append(row)
            with self.tsv.open("a") as tsv:
                tsv.write("\t".join(row[f] for f in FIELDS) + "\n")
            if code in STOPPED_BY:
                raise Stopped(code - 128)
            if not flagged:
                break
        return True

    def table(self, names):
        print(
            f"{'variant':<12} {'runs':>4} {'mean s':>8} {'min':>8} {'max':>8}"
            f" {'user':>8} {'sys':>8} {'flagged':>7} {'failed':>6}"
        )
        for name in names:
            mine = [
                r for r in self.rows if r["variant"] == name and r["round"] != "warmup"
            ]
            clean = [r for r in mine if counted(r)]
            walls = [float(r["wall"]) for r in clean]

            def mean(field, rows=clean):
                if not rows:
                    return "-"
                return f"{statistics.mean(float(r[field]) for r in rows):.1f}"

            low = f"{min(walls):.1f}" if walls else "-"
            high = f"{max(walls):.1f}" if walls else "-"
            flagged = sum(r["flagged"] == "1" for r in mine)
            failed = sum(r["exit"] != "0" for r in mine)
            print(
                f"{name:<12} {len(clean):>4} {mean('wall'):>8} {low:>8} {high:>8}"
                f" {mean('user'):>8} {mean('sys'):>8} {flagged:>7} {failed:>6}"
            )
        for name in names:
            means = self.part_means(name)
            if means:
                listed = ", ".join(f"{part} {mean:.1f}" for part, mean in means.items())
                print(f"{name} parts: {listed}")
        print(f"results: {self.tsv}")

    def part_means(self, name):
        """Each part's mean seconds over the variant's counted runs, in the order the
        parts first appear."""
        seconds = {}
        for r in self.rows:
            if r["variant"] != name or r["round"] == "warmup" or not counted(r):
                continue
            for pair in filter(None, r["parts"].split(",")):
                part, value = pair.split("=")
                seconds.setdefault(part, []).append(float(value))
        return {part: statistics.mean(values) for part, values in seconds.items()}

    def failed(self):
        return any(r["exit"] != "0" for r in self.rows if r["round"] != "warmup")


def main(argv=None):
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--out", required=True, type=Path, help="folder for the logs and results.tsv"
    )
    parser.add_argument(
        "--rounds", type=int, default=3, help="timed runs of each variant (default 3)"
    )
    parser.add_argument(
        "--warmup", action="store_true", help="run each variant once first, untimed"
    )
    parser.add_argument(
        "--prepare",
        metavar="CMD",
        help="run before each run, untimed, with BENCH_VARIANT set",
    )
    parser.add_argument(
        "--no-rerun",
        action="store_true",
        help="keep a run flagged for outside load as it is",
    )
    parser.add_argument("variant", nargs="*", metavar="NAME=CMD")
    args = parser.parse_args(argv)
    found, revs = variants(args.variant, parser)
    if args.rounds < 1:
        parser.error("--rounds must be at least 1")
    if os.environ.get("HEAVY_SLOT"):
        parser.error(
            "it runs inside a heavy job, where heavy runs each run at once and measures"
            " nothing: run heavy-bench bare, as `bgrun -o LOG -- heavy-bench ...`"
        )
    if (args.out / "results.tsv").exists():
        parser.error(f"{args.out} already holds results: give a new --out")
    trees = bench_trees(revs, parser)
    # The same folder of each worktree as this one is of the repo.
    prefix = git("rev-parse", "--show-prefix") or "" if trees else ""
    bench = Bench(
        args.out,
        args.prepare,
        rerun=not args.no_rerun,
        limit=limit(parser),
        folders={name: tree / prefix for name, tree in trees.items()},
    )

    def stop(signum, _frame):
        raise Stopped(signum)

    # Before any worktree exists, so a stop at any point removes those made.
    for sig in STOPS:
        signal.signal(sig, stop)
    try:
        if not add_trees(trees, revs):
            return 1
        return run_bench(bench, found, args)
    except Stopped as stopped:
        print(f"heavy-bench: stopped by signal {stopped.signum}.", file=sys.stderr)
        return 128 + stopped.signum
    finally:
        remove_trees(trees)


def run_bench(bench, found, args):
    rounds = (["warmup"] if args.warmup else []) + list(range(1, args.rounds + 1))
    try:
        for round_ in rounds:
            for name, command in found.items():
                if not bench.run(name, command, round_):
                    bench.table(found)
                    return 1
    except Stopped as stopped:
        print(f"heavy-bench: stopped by signal {stopped.signum}.", file=sys.stderr)
        bench.table(found)
        return 128 + stopped.signum
    bench.table(found)
    return 1 if bench.failed() else 0


if __name__ == "__main__":
    sys.exit(main())
