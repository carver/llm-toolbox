#!/bin/sh
# Agents' commits also run the slower agent-pre-commit (llm-toolbox agent-commit-gate).
if [ -n "${AI_AGENT:-}" ] && [ -z "${AGENT_PRE_COMMIT:-}" ]; then AGENT_PRE_COMMIT=1 "$(dirname "$0")/agent-pre-commit" || exit; fi
# Formatting only: clippy takes over five seconds here, so it runs in CI
# along with the tests.
set -e
cargo fmt --check
