#!/usr/bin/env -S uv run --quiet --script
# /// script
# dependencies = ["pillow==12.3.0", "playwright==1.64.1"]
# ///
"""Open a web page in headless Chromium, drive it, take screenshots and report its JavaScript errors.

    web-shot [options] [--do ACTION ...] PAGE

PAGE is a URL or a local file path.

Actions (--do, repeatable, run in order once the page has loaded):
  click SELECTOR         click the first element matching a CSS selector
  wait MS                wait, e.g. for an animation or a fetch
  eval JS                run JavaScript in the page and print its value as JSON, or undefined;
                         console.log output isn't shown, so make the value what you want to see
  shot NAME [SELECTOR]   screenshot to OUT/NAME.png: the matching element, else the full page;
                         an element's shot covers what its children draw outside it, such as
                         a badge hung over its corner, unless it hides their overflow
  text [SELECTOR]        print the visible text of the matching element, else the whole page
  links [REGEX]          print "text -> url" for each link whose text or url matches REGEX
  scroll-all             scroll to the bottom until the page stops growing (endless feeds)

A final full-page screenshot, OUT/final.png, is always taken. A shot taller than
1500px is also saved as pieces at most 1400px tall, OUT/NAME.part1.png and on
(replacing an earlier run's), which an image reader shows without scaling them
down. Text, links and eval values go to stdout as their actions run, then the
paths of the screenshots, each followed by its pieces.
The page's uncaught errors and console errors go to stderr, repeats collapsed
to one line with a count, and make the exit status 3 once the screenshots are
saved.

--color-scheme and --reduced-motion set what the page's prefers-color-scheme
and prefers-reduced-motion media queries see, such as to shoot its dark look.
Without them it sees Playwright's defaults: a light scheme, and no preference
about motion.

Every run checks whether the page scrolls sideways, after it loads and at each
shot, and says so on stderr: the page's width against the viewport's, then up
to 5 elements that widen it, the furthest-reaching first, each with the start of
its text and its right edge. Only what widens the page counts: nothing laid out
inside a box that clips or scrolls sideways, nothing fixed to the viewport, and
only the outermost culprit, not its descendants. A report seen at several
moments prints once, naming them. It doesn't change the exit status. A page
whose scripts break the check gets a line saying so instead.

A local .html or .htm file that doesn't start with a doctype, such as an
Artifact file, would load in quirks mode. It loads instead after the skeleton
the Artifact publisher adds: <!doctype html>, a UTF-8 charset meta, a viewport
meta and a [hidden]{display:none!important} rule. The page keeps the file's
URL, so relative links and #anchors work, and nothing is written to disk.
stderr says so.

The browser is Playwright's Chromium. When the cached browser is not the build
this Playwright wants, the newest cached Chromium is used instead, so no
download is needed; with none cached it prints the install command.

Exit status: 0; 1 when the page doesn't load or an action fails, with one line
saying which, after what came before it is printed; 2 for a bad argument or no
Chromium; 3 when the page had errors.

Examples:
  web-shot report/page.html
  web-shot --do "click #legend button[data-series=human]" --do "shot chart #trajectory" report/page.html
  web-shot --size 390x844 https://example.com
  web-shot --color-scheme dark --do "shot dark" https://example.com
  web-shot --do "wait 5000" --do text https://airtable.com/app.../form     # read a JS-rendered form
  web-shot --do scroll-all --do "links /event/" https://example.com/calendar
"""

import argparse
import codecs
import glob
import io
import json
import math
import re
import sys
import tempfile
import time
import urllib.parse
import urllib.request
from dataclasses import dataclass, field
from pathlib import Path

# The docstring up to the end of its Actions list, which -h prints before the options,
# and the rest, which it prints after them.
HELP_HEAD, HELP_TAIL = re.match(
    r"(.*?\nActions.*?)\n\n(.*)", __doc__, re.DOTALL
).groups()
# Each action's form, such as "shot NAME [SELECTOR]", from the Actions list.
FORMS = {
    m.group(1).split()[0]: m.group(1)
    for m in re.finditer(
        r"^  (\S.*?)\s{2,}", HELP_HEAD.split("\nActions")[1], re.MULTILINE
    )
}
# Each action's (min, max) arguments, from its form: a word in brackets is optional.
ARITY = {
    verb: (
        sum(not w.startswith("[") for w in form.split()[1:]),
        len(form.split()) - 1,
    )
    for verb, form in FORMS.items()
}
INSTALL = "uv run --with playwright==1.64.1 playwright install chromium"
# After a scroll, no request in flight this long means the page has loaded what it asked for; a page
# that never stops polling is measured after the cap anyway.
SCROLL_QUIET_MS = 300
SCROLL_ROUND_CAP_MS = 2000
SCROLL_POLL_MS = 50
# The feed is done once its height is unchanged this many rounds in a row, and for this long, for a
# loader that fetches a while after the scroll.
SCROLL_STABLE_ROUNDS = 3
SCROLL_DONE_MS = 2000
SCROLL_MAX_ROUNDS = 400
# Requests that stay open as long as the page does
UNENDING = {"eventsource", "websocket", "media"}
# A shot taller than this is also saved in pieces at most PIECE_HEIGHT tall, which a reader shows
# without scaling them down: a 1280x6353 shot showed at 403x2000.
SPLIT_ABOVE = 1500
PIECE_HEIGHT = 1400
# What an Artifact's publisher wraps its file in. Without a doctype a page loads in quirks mode.
SKELETON = (
    b"<!doctype html>\n"
    b'<meta charset="utf-8">\n'
    b'<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">\n'
    b"<style>[hidden]{display:none!important}</style>\n"
)
# What may come before a doctype that still takes effect: whitespace, comments, and an XML
# declaration, which HTML reads as a comment
BEFORE_DOCTYPE = re.compile(rb"(?:\s|<!--.*?-->|<\?[^>]*>)*", re.DOTALL)
# The page area an element and its children draw on: the union of their boxes, each
# cut to the boxes of the ancestors up to the element that hide their overflow. A
# fixed child is left out: it sits on the window, not on the element.
SHOT_AREA_JS = """element => {
  const box = rect => ({left: rect.left, top: rect.top, right: rect.right, bottom: rect.bottom});
  const cut = (area, limit) => !limit ? area : {
    left: Math.max(area.left, limit.left), top: Math.max(area.top, limit.top),
    right: Math.min(area.right, limit.right), bottom: Math.min(area.bottom, limit.bottom)};
  const hides = style => style.overflowX !== 'visible' || style.overflowY !== 'visible';
  const own = box(element.getBoundingClientRect());
  const area = {...own};
  const walk = (node, limit) => {
    for (const child of node.children) {
      const style = getComputedStyle(child);
      if (style.position === 'fixed') continue;
      const seen = cut(box(child.getBoundingClientRect()), limit);
      if (seen.right > seen.left && seen.bottom > seen.top && style.visibility !== 'hidden') {
        area.left = Math.min(area.left, seen.left);
        area.top = Math.min(area.top, seen.top);
        area.right = Math.max(area.right, seen.right);
        area.bottom = Math.max(area.bottom, seen.bottom);
      }
      walk(child, hides(style) ? seen : limit);
    }
  };
  walk(element, hides(getComputedStyle(element)) ? own : null);
  const x = Math.max(0, area.left + scrollX), y = Math.max(0, area.top + scrollY);
  return {x, y, width: area.right + scrollX - x, height: area.bottom + scrollY - y};
}"""

LINKS_JS = """pattern => [...document.querySelectorAll('a[href]')]
  .map(a => [a.innerText.trim().replace(/\\s+/g, ' '), a.href])
  .filter(([text, href]) => !pattern || new RegExp(pattern, 'i').test(text + ' ' + href))"""


# What makes the page scroll sideways: null when it doesn't, else its scroll width, the viewport's
# width and the culprits. A culprit is an element whose box reaches past the viewport's right edge, or
# whose own text does when its box fits; not one laid out inside a box that clips or scrolls
# sideways, nor one fixed to the viewport, and none inside a culprit. Its argument is how many
# characters of a culprit's text to send.
SIDEWAYS_JS = r"""keep => {
  const root = document.documentElement, body = document.body;
  const width = root.clientWidth, scrollWidth = root.scrollWidth;
  if (scrollWidth <= width) return null;
  // The viewport takes html's overflow, or body's when html's is visible, and that element's own box
  // doesn't clip. Chromium reports the wide scroll width of a viewport that hides it.
  const overflowSource = getComputedStyle(root).overflowX !== 'visible' ? root : body;
  const viewportX = overflowSource ? getComputedStyle(overflowSource).overflowX : 'visible';
  if (viewportX === 'hidden' || viewportX === 'clip') return null;
  const clips = (el, style) => el !== overflowSource && (style.overflowX !== 'visible'
    || /paint|content|strict/.test(style.contain) || ['auto', 'hidden'].includes(style.contentVisibility));
  // The tree the page is laid out by: a shadow host shows its shadow root, where a slot shows what
  // is assigned to it (or its own children, without any), in place of the host's children
  const kids = el => el.shadowRoot ? el.shadowRoot.children
    : el.localName === 'slot' && el.assignedElements().length ? el.assignedElements({flatten: true})
    : el.children;
  const up = el => el.assignedSlot ?? el.parentElement ?? el.getRootNode().host ?? null;
  const clipAround = el => {  // the nearest box at or above el that clips
    for (; el && el !== root; el = up(el)) if (clips(el, getComputedStyle(el))) return el;
    return null;
  };
  const reach = rects => Math.max(-Infinity, ...Array.from(rects, r => r.right)) + scrollX;
  const label = el => el.localName + (el.id ? '#' + el.id : '')
    + Array.from(el.classList).slice(0, 2).map(c => '.' + c).join('');
  const snippet = text => text.trim().replace(/\s+/g, ' ').slice(0, keep);
  const range = document.createRange();
  const culprits = [];
  const culprit = (name, text, right) => culprits.push({name, text: snippet(text), right: Math.round(right)});
  // clip: the clipping box around the one el is laid out in, or null
  const walk = (el, clip) => {
    const style = getComputedStyle(el);
    if (style.display === 'none') return;
    // Fixed to the viewport, so it can't widen the page. (A body's offsetParent is always null.)
    if (style.position === 'fixed' && el.offsetParent === null) return;
    // Laid out in its containing block, which may be outside the clipping box around it
    if ((style.position === 'fixed' || style.position === 'absolute') && el.offsetParent)
      clip = clipAround(el.offsetParent);
    if (!clip) {
      const right = reach(el.getClientRects());
      if (right > width + 0.5) return culprit(label(el), el.innerText ?? el.textContent, right);
      for (const node of el.childNodes) {
        if (node.nodeType !== Node.TEXT_NODE || !node.data.trim()) continue;
        range.selectNodeContents(node);
        const right = reach(range.getClientRects());
        if (right > width + 0.5) return culprit('text in ' + label(el), node.data, right);
      }
    }
    // Inside a clipping box, the walk goes on only to find what escapes it
    const inner = clips(el, style) ? el : clip;
    for (const child of kids(el)) walk(child, inner);
  };
  walk(root, null);
  return {scrollWidth, width, culprits};
}"""
SIDEWAYS_SHOWN = 5  # culprits named; the rest are counted
SNIPPET = 40  # characters of a culprit's text


class UsageError(Exception):
    pass


@dataclass(frozen=True)
class Action:
    verb: str
    args: tuple

    def __str__(self):
        return " ".join((self.verb, *self.args))


class Failed(Exception):
    """The page didn't load, or an action failed in it."""


def first_line(error):
    """The first line of a Playwright error, which goes on with a call log."""
    return str(error).strip().splitlines()[0]


def parse_action(text):
    """'shot chart #trajectory .card' -> Action('shot', ('chart', '#trajectory .card')). A selector or
    script is the rest of the line, spaces and all; only shot splits off a name first."""
    verb, _, rest = text.strip().partition(" ")
    rest = rest.strip()
    if verb not in ARITY:
        raise UsageError(
            f"unknown action {verb!r}; the actions: {' | '.join(FORMS.values())}"
        )
    args = (
        tuple(rest.split(" ", 1))
        if verb == "shot" and rest
        else (rest,)
        if rest
        else ()
    )
    low, high = ARITY[verb]
    if not low <= len(args) <= high:
        raise UsageError(
            f"{verb!r} takes {low}{'' if low == high else f' to {high}'} argument(s): {text!r}; "
            f"its form: {FORMS[verb]}"
        )
    if verb == "wait" and not args[0].isdigit():
        raise UsageError(f"wait takes milliseconds: {text!r}")
    return Action(verb, tuple(a.strip() for a in args))


@dataclass
class Findings:
    """What a run found, kept as it goes, so an action that fails doesn't lose what came before."""

    shots: list = field(default_factory=list)
    errors: list = field(default_factory=list)
    # a sideways report's lines -> the moments it was seen
    sideways: dict = field(default_factory=dict)
    # why a sideways check failed, each time one did
    unchecked: list = field(default_factory=list)

    def check_sideways(self, tab, moment):
        """A check the page breaks, such as by replacing getComputedStyle, is noted and skipped."""
        from playwright.sync_api import Error

        try:
            lines = sideways_report(tab)
        except Error as error:
            self.unchecked.append(
                f"couldn't check sideways scrolling at {moment}: {first_line(error)}"
            )
            return
        if lines:
            self.sideways.setdefault(lines, []).append(moment)

    def show(self):
        """Prints the shots' paths on stdout, and on stderr each sideways report once, naming the
        moments it was seen, then the page's errors."""
        if self.shots:
            print("\n".join(map(str, self.shots)))
        for line in self.unchecked:
            print(line, file=sys.stderr)
        for (head, *rest), moments in self.sideways.items():
            print(
                f"scrolls sideways ({', '.join(moments)}): {head}",
                *rest,
                sep="\n",
                file=sys.stderr,
            )
        for error in collapse(self.errors):
            print(error, file=sys.stderr)


def sideways_report(tab):
    """What makes the page scroll sideways, as lines: its width against the viewport's, then the
    furthest-reaching culprits. () when the page fits."""
    found = tab.evaluate(SIDEWAYS_JS, SNIPPET + 1)  # one more, to know when to cut it
    if not found:
        return ()
    culprits = sorted(found["culprits"], key=lambda culprit: -culprit["right"])
    lines = [f"page {found['scrollWidth']}px wide, viewport {found['width']}px"]
    for culprit in culprits[:SIDEWAYS_SHOWN]:
        text = culprit["text"]
        if len(text) > SNIPPET:
            text = text[:SNIPPET] + "..."
        quoted = f' "{text}"' if text else ""
        lines.append(f"  {culprit['name']}{quoted} reaches {culprit['right']}px")
    if len(culprits) > SIDEWAYS_SHOWN:
        lines.append(f"  and {len(culprits) - SIDEWAYS_SHOWN} more")
    if not culprits:
        lines.append("  found no element that reaches past the viewport")
    return tuple(lines)


def collapse(lines):
    """Repeated lines once each, in first-seen order, with a count when there was more than one."""
    counts = {}
    for line in lines:
        counts[line] = counts.get(line, 0) + 1
    return [line if n == 1 else f"{line} (x{n})" for line, n in counts.items()]


class Network:
    """The requests in flight on a tab, and when one last started or ended. `clock` gives seconds."""

    def __init__(self, clock=time.monotonic):
        self.clock = clock
        self.in_flight = 0
        self.quiet_since = (
            clock()
        )  # when a request last started or ended, or a settle began

    def started(self, request):
        if request.resource_type not in UNENDING:
            self.in_flight += 1
            self.quiet_since = self.clock()

    def ended(self, request):
        if request.resource_type not in UNENDING:
            self.in_flight = max(0, self.in_flight - 1)
            self.quiet_since = self.clock()

    def settle(self, tab):
        """Waits until no request has been in flight for SCROLL_QUIET_MS, counting from now, or until
        SCROLL_ROUND_CAP_MS passes."""
        self.quiet_since = max(self.quiet_since, self.clock())
        waited = 0
        while waited < SCROLL_ROUND_CAP_MS:
            if (
                not self.in_flight
                and (self.clock() - self.quiet_since) * 1000 >= SCROLL_QUIET_MS
            ):
                return
            tab.wait_for_timeout(SCROLL_POLL_MS)
            waited += SCROLL_POLL_MS


def scroll_all(tab, network):
    height, stable = tab.evaluate("document.body.scrollHeight"), 0
    grew = network.clock()
    for _ in range(SCROLL_MAX_ROUNDS):
        tab.evaluate("window.scrollTo(0, document.body.scrollHeight)")
        network.settle(tab)
        new_height = tab.evaluate("document.body.scrollHeight")
        if new_height == height:
            stable += 1
        else:
            stable, grew = 0, network.clock()
        if (
            stable >= SCROLL_STABLE_ROUNDS
            and (network.clock() - grew) * 1000 >= SCROLL_DONE_MS
        ):
            return
        height = new_height


def visible_text(tab, selector):
    text = (
        tab.locator(selector).first.inner_text() if selector else tab.inner_text("body")
    )
    return "\n".join(line.strip() for line in text.splitlines() if line.strip())


def eval_json(tab, script):
    """SCRIPT's value in the page as one line of JSON, or "undefined". Playwright awaits a promise and
    calls a function, as evaluate does. A script that navigates, as location.reload() does, takes its
    value with the page it leaves, so it prints undefined."""
    from playwright.sync_api import Error

    value = tab.evaluate_handle(script)
    try:
        if value.evaluate("v => v === undefined"):
            return "undefined"
        value = value.json_value()
    except Error:  # the page navigated after the script ran
        return "undefined"
    return json.dumps(jsonable(value), ensure_ascii=False, allow_nan=False)


def jsonable(value, inside=()):
    """VALUE, as Playwright gives it, in what JSON can hold: a reference back to an enclosing object
    becomes "[Circular]", a number JSON lacks its JavaScript name, and anything else, such as a Date,
    its text."""
    if isinstance(value, (dict, list)):
        if any(value is outer for outer in inside):
            return "[Circular]"
        inside = (*inside, value)
        if isinstance(value, dict):
            return {str(key): jsonable(item, inside) for key, item in value.items()}
        return [jsonable(item, inside) for item in value]
    if isinstance(value, float) and not math.isfinite(value):
        return "NaN" if math.isnan(value) else "Infinity" if value > 0 else "-Infinity"
    if value is None or isinstance(value, (bool, int, float, str)):
        return value
    return str(value)


def save_pieces(path, png):
    """Saves PNG, the shot saved at PATH, as pieces beside it when it is tall, and returns their paths:
    NAME.part1.png and on, the fewest of at most PIECE_HEIGHT, of equal height but for the last. The
    pieces of an earlier, taller shot by that name go first."""
    from PIL import Image

    Image.MAX_IMAGE_PIXELS = None  # our own screenshot, not a decompression bomb
    for old in path.parent.glob(f"{glob.escape(path.stem)}.part*.png"):
        if re.fullmatch(r"\.part\d+", old.stem[len(path.stem) :]):
            old.unlink()
    image = Image.open(io.BytesIO(png))
    width, height = image.size
    if height <= SPLIT_ABOVE:
        return []
    step = math.ceil(height / math.ceil(height / PIECE_HEIGHT))
    pieces = []
    for number, top in enumerate(range(0, height, step), 1):
        piece = path.with_name(f"{path.stem}.part{number}.png")
        image.crop((0, top, width, min(top + step, height))).save(piece)
        pieces.append(piece)
    return pieces


def file_path(url):
    """The resolved path a file:// URL names, else None."""
    parts = urllib.parse.urlsplit(url)
    if parts.scheme != "file":
        return None
    return Path(urllib.request.url2pathname(parts.path)).resolve()


def local_html(page):
    """The resolved path of the local .html or .htm file PAGE names, as a path or a file:// URL, or
    None."""
    path = file_path(page_url(page))
    if path and path.suffix.lower() in (".html", ".htm") and path.is_file():
        return path
    return None


def in_skeleton(content):
    """CONTENT, a page's bytes, after SKELETON, or None when a doctype starts it. A UTF-16 file is left
    alone too: this look at its bytes can't read it."""
    if content.startswith((codecs.BOM_UTF16_LE, codecs.BOM_UTF16_BE)):
        return None
    content = content.removeprefix(codecs.BOM_UTF8)
    start = BEFORE_DOCTYPE.match(content).end()
    if content[start : start + 9].lower() == b"<!doctype":
        return None
    return SKELETON + content


def serve_in_skeleton(context, path, body):
    """Answers every request for the file at PATH with BODY, keeping its URL, and says so on stderr the
    first time."""
    told = False

    def answer(route):
        nonlocal told
        if not told:
            print(
                f"no doctype in {path.name}: loaded it inside a standard skeleton"
                " (doctype, charset, viewport, [hidden] rule)",
                file=sys.stderr,
                flush=True,
            )
            told = True
        route.fulfill(body=body, content_type="text/html")

    context.route(lambda url: file_path(url) == path, answer)


def page_url(page):
    path = Path(page)
    return path.resolve().as_uri() if "://" not in page and path.exists() else page


def cached_chromium():
    """The newest Chromium in Playwright's cache, or None."""
    cache = Path.home() / ".cache" / "ms-playwright"
    found = sorted(
        cache.glob("chromium-*/chrome-linux*/chrome"),
        key=lambda p: int(p.parts[-3].split("-")[1]),
    )
    return found[-1] if found else None


def launch(playwright):
    try:
        return playwright.chromium.launch()
    except Exception as error:  # Playwright raises its own Error with no finer type for a missing browser
        if "Executable doesn't exist" not in str(error):
            raise
    fallback = cached_chromium()
    if not fallback:
        raise UsageError(f"no Chromium for Playwright; install one with: {INSTALL}")
    return playwright.chromium.launch(executable_path=str(fallback))


def run(page, actions, out, options, cookies, found):
    """Opens PAGE in a browser context made with OPTIONS and runs ACTIONS, then the final shot, adding
    what it finds to FOUND. Raises Failed when the page doesn't load or an action fails."""
    from playwright.sync_api import Error, sync_playwright

    with sync_playwright() as playwright:
        browser = launch(playwright)
        context = browser.new_context(**options)
        url = page_url(page)
        context.add_cookies([{"name": n, "value": v, "url": url} for n, v in cookies])
        html = local_html(page)
        body = html and in_skeleton(html.read_bytes())
        if body:
            serve_in_skeleton(context, html, body)
        tab = context.new_page()
        network = Network()
        tab.on("request", network.started)
        tab.on("requestfinished", network.ended)
        tab.on("requestfailed", network.ended)
        tab.on("pageerror", lambda error: found.errors.append(f"page error: {error}"))
        tab.on(
            "console",
            lambda msg: (
                msg.type == "error"
                and found.errors.append(f"console error: {msg.text}")
            ),
        )
        try:
            tab.goto(url, wait_until="load")
        except Error as error:
            raise Failed(f"couldn't load {page}: {first_line(error)}") from None
        found.check_sideways(tab, "load")
        for action in actions + [Action("shot", ("final",))]:
            try:
                perform(action, tab, network, out, found)
            except Error as error:
                raise Failed(f"{action} failed: {first_line(error)}") from None
        browser.close()


def perform(action, tab, network, out, found):
    if action.verb == "click":
        tab.click(action.args[0])
    elif action.verb == "wait":
        tab.wait_for_timeout(int(action.args[0]))
    elif action.verb == "eval":
        print(eval_json(tab, action.args[0]), flush=True)
    elif action.verb == "text":
        print(visible_text(tab, action.args[0] if action.args else None), flush=True)
    elif action.verb == "links":
        for text, href in tab.evaluate(LINKS_JS, action.args[0] if action.args else ""):
            print(f"{text} -> {href}", flush=True)
    elif action.verb == "scroll-all":
        scroll_all(tab, network)
    else:
        found.check_sideways(tab, f"shot {action.args[0]}")
        path = out / f"{action.args[0]}.png"
        if len(action.args) == 2:
            # As a locator's own shot would: wait for it to show, and scroll it into
            # view, out of an inner scroller too.
            element = tab.locator(action.args[1]).first
            element.wait_for(state="visible")
            element.scroll_into_view_if_needed()
            area = element.evaluate(SHOT_AREA_JS)
            png = tab.screenshot(path=str(path), full_page=True, clip=area)
        else:
            png = tab.screenshot(path=str(path), full_page=True)
        found.shots += [path, *save_pieces(path, png)]


def cookie_arg(text):
    name, sep, value = text.partition("=")
    if not (sep and name):
        raise argparse.ArgumentTypeError(
            f"cookie is NAME=VALUE, e.g. user_id=2: {text!r}"
        )
    return name, value


def size_arg(text):
    width, _, height = text.partition("x")
    if not (width.isdigit() and height.isdigit()):
        raise argparse.ArgumentTypeError(f"size is WxH, e.g. 1280x900: {text!r}")
    return int(width), int(height)


def context_options(args):
    """new_context's arguments for ARGS: the viewport, and the media features asked for. A feature
    not asked for is left out, so the page sees Playwright's default."""
    width, height = args.size
    options = {"viewport": {"width": width, "height": height}}
    if args.color_scheme:
        options["color_scheme"] = args.color_scheme
    if args.reduced_motion:
        options["reduced_motion"] = "reduce"
    return options


def main(argv=None):
    parser = argparse.ArgumentParser(
        # The usage, PAGE and the actions come before the options, so the help's first
        # screen shows how to write an action.
        description=HELP_HEAD,
        epilog=HELP_TAIL,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("page", help="a URL or a local file")
    parser.add_argument(
        "--do",
        action="append",
        default=[],
        metavar="ACTION",
        help="an action, as the list above gives",
    )
    parser.add_argument(
        "--out", type=Path, help="output directory (default: a new temp dir)"
    )
    parser.add_argument(
        "--cookie",
        type=cookie_arg,
        action="append",
        default=[],
        metavar="NAME=VALUE",
        help="a cookie to send with the page, such as an app's login; repeatable",
    )
    parser.add_argument(
        "--size",
        type=size_arg,
        default=(1280, 900),
        help="viewport WxH (default 1280x900)",
    )
    parser.add_argument(
        "--color-scheme",
        choices=("light", "dark"),
        help="what the page's prefers-color-scheme media queries see (default: light)",
    )
    parser.add_argument(
        "--reduced-motion",
        action="store_true",
        help="have the page's prefers-reduced-motion media queries see reduce",
    )
    args = parser.parse_args(argv)
    found = Findings()
    try:
        actions = [parse_action(a) for a in args.do]
        if args.cookie and not page_url(args.page).startswith(("http://", "https://")):
            raise UsageError("--cookie needs an http(s) page, not a file")
        out = args.out or Path(tempfile.mkdtemp(prefix="web-shot-"))
        out.mkdir(parents=True, exist_ok=True)
        try:
            run(args.page, actions, out, context_options(args), args.cookie, found)
        finally:
            found.show()
    except UsageError as error:
        print(f"web-shot: {error}", file=sys.stderr)
        return 2
    except Failed as error:
        print(f"web-shot: {error}", file=sys.stderr)
        return 1
    return 3 if found.errors else 0


if __name__ == "__main__":
    sys.exit(main())
