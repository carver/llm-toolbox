#!/usr/bin/env python3
"""A Claude Code PreToolUse hook that refuses a Bash command piping git commit, wt-ship or
bgrun --wait into another command, or piping a check and then committing.

A pipeline exits with its last command's status. In `git commit -q -F MSG 2>&1 | tail -2`
that's tail's, so a commit its hook refused reads as a success, and the agent builds on
a commit that doesn't exist. wt-ship's landing can fail unseen the same way, and so can
whatever `bgrun --wait` runs, since bgrun exits with its command's status. The refusal
says to drop the pipe, since bgrun --wait prints the log's last lines itself and git
commit prints a few lines. To filter the output anyway, put `set -o pipefail;` first and
pipe into tail, not head, whose early exit can fail the command; or redirect to a file
and read it in the next call. install.py registers it in ~/.claude/settings.json.

A command is piped when `|` or `|&` follows it, or follows a compound command around
it: ( ... ), { ...; }, if ... fi, case ... esac, or a for, while, until or select
loop. It passes when pipefail is on for the shell running that pipeline: a `set
-o pipefail` (or `set -euo pipefail`) earlier in the same script and outside any
compound command, not undone by a `set +o pipefail`, or a shell started with -o
pipefail. It finds what runs as heavy-gate does (lib/shellparse.py): past variable
settings and wrappers such as timeout, env and sudo; in the script of bash -c, eval
or a heredoc fed to a shell; in $(...), backticks and <(...); and in the command bgrun
runs. A bash -c, eval or heredoc whose shell is piped counts as piped throughout,
whatever it sets inside. A new shell starts without pipefail, and a $(...) gets
the pipefail its script has at its end. Help as the first argument (`wt-ship -h |
head`) and `git commit --dry-run` pass, as do a pipe into git commit (`echo msg |
git commit -F -`), `||`, and a `|` in quotes, a heredoc's body or a comment.

It also refuses a check whose status a pipe hides when the same script goes on to
record the result: in `pytest -q | tail -3 && git commit -q --fixup=HEAD`, a failing
test exits as tail did, and the commit goes ahead on it. A check is pytest (also as
the command of `heavy --`, `uv run` or uvx, or as python -m pytest or unittest), cargo
test, nextest, clippy, check, build or mutants, ruff check, mutate-check,
agent-pre-commit, agent-quick-check, pre-commit, pre-commit-run, npm or make test or
check, or ./t; one asked for its help, its version or --collect-only decides nothing
and is none. What records is git commit, wt-ship or `build-state finish`, also under
bgrun, joined by `&&` or `;` alike. Any other piped command before a commit passes
(`git diff --cached --stat | tail -5 && git commit ...`), and so do a check whose
pipeline has pipefail on and a script that reads PIPESTATUS. Only the script's own
commands are read for this rule, not those inside a bash -c, an eval, a $(...) or a
heredoc.

Claude Code shows one hook's refusal at a time, so when this hook refuses, it also
asks heavy-gate, beside it, about the same call, and adds heavy-gate's reason when that
would refuse the call too: a foreground `bgrun --wait -- heavy -- CMD | tail` would
otherwise be refused once for the pipe and again, with the pipe gone, for the wait.

It catches a mistake, not an agent set on getting past it: an alias, a variable that
holds `git`, a function or a script that commits all pass.

    pipe-status-gate < hook-input.json    # as Claude Code calls it

Exit status: 0 allowed, 2 refused (the reason on stderr, ending with a sentence saying
nothing in the command ran), 1 input that isn't JSON.
"""

import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from shellparse import (
    NOTHING_RAN,
    SHELLS,
    Command,
    bgrun_command,
    command_of,
    commands,
    commit_args,
    is_help,
    prepare,
    reads_stdin,
    set_pipefail,
    shell_script,
)

REFUSAL = (
    "Refused: {name} is piped into another command, and a pipeline exits with its last "
    "command's status, so {name} failing reads as success.\n"
    "Drop the pipe: bgrun --wait prints the log's last lines itself (--tail N), and git "
    "commit prints a few lines. To filter anyway, put `set -o pipefail;` first and pipe "
    "into tail, not head (its early exit can fail the command), or redirect to a file "
    "and read it in the next call."
)


UNSEEN_CHECK = (
    "Refused: {check}'s status is hidden by the pipe after it, and {record} follows: "
    "a failing check would read as a pass and {record} would go ahead on it.\n"
    "Put `set -o pipefail;` first, or run the check in a call of its own and read "
    "what it printed before the next one."
)

# The options of uv run and uvx that take a value, which is no command.
UV_VALUES = frozenset(
    {
        "--with",
        "--with-requirements",
        "--with-editable",
        "--from",
        "-p",
        "--python",
        "--project",
        "--directory",
        "--extra",
        "--group",
        "--index",
        "--env-file",
    }
)
CARGO_CHECKS = {"nextest", "test", "clippy", "check", "build", "mutants"}
CHECKS = {
    "pytest",
    "mutate-check",
    "agent-pre-commit",
    "agent-quick-check",
    "pre-commit",
    "pre-commit-run",
}
# Arguments with which a check decides nothing.
NO_RUN = {"-h", "--help", "--version", "-V", "--collect-only", "--co"}


def first_word(words: list[str], values: frozenset[str] = frozenset()) -> int | None:
    """Where the first word of `words` that is no option, and no value of one of
    `values`, lies."""
    skip = False
    for at, word in enumerate(words):
        if skip:
            skip = False
        elif word in values:
            skip = True
        elif not word.startswith(("-", "+")):
            return at
    return None


def check_name(words: list[str]) -> str | None:
    """The check one simple command runs, as the refusal names it, or None: a
    command that only names one in an argument, or asks one for its help, runs
    none."""
    words, _ = command_of(words)
    if not words or NO_RUN & set(words):
        return None
    name, args = Path(words[0]).name, words[1:]
    if name == "heavy":
        return check_name(args[args.index("--") + 1 :]) if "--" in args else None
    if name in ("uv", "uvx"):
        if name == "uv":
            if args[:1] != ["run"]:
                return None
            args = args[1:]
        at = first_word(args, UV_VALUES)
        return None if at is None else check_name(args[at:])
    if name in ("python", "python3"):
        module = args[args.index("-m") + 1 :][:1] if "-m" in args else []
        return module[0] if module in (["pytest"], ["unittest"]) else None
    if name == "cargo":
        at = first_word(args)
        found = args[at] if at is not None else None
        return f"cargo {found}" if found in CARGO_CHECKS else None
    if name == "ruff":
        return "ruff" if args[:1] == ["check"] else None
    if name in ("npm", "make"):
        return f"{name} test" if args[:1] in (["test"], ["check"]) else None
    # llm-toolbox's own test command, by the path it is run with.
    if words[0] == "./t":
        return "./t"
    return name if name in CHECKS else None


def record_name(words: list[str]) -> str | None:
    """What one simple command records a result with, or None: git commit, wt-ship
    or build-state finish, also as the command bgrun runs, not asked for help or a
    dry run."""
    words, _ = command_of(words)
    if not words:
        return None
    name, args = Path(words[0]).name, words[1:]
    if name == "bgrun":
        parsed = bgrun_command(args)
        return record_name(parsed[1]) if parsed else None
    if name == "wt-ship":
        return None if asks_help(args) else "wt-ship"
    if name == "build-state":
        finishes = args[:1] == ["finish"] and not asks_help(args[1:])
        return "build-state finish" if finishes else None
    commit = commit_args(args) if name == "git" else None
    if commit is None or asks_help(commit) or "--dry-run" in commit:
        return None
    return "git commit"


def unseen_check(command: str) -> tuple[str, str] | None:
    """(a check whose status a pipe hides, what the script records after it), for
    the first such pair among the script's own commands, or None."""
    # A script that reads PIPESTATUS takes the check's own status.
    if "PIPESTATUS" in command:
        return None
    pipefail, check = False, None
    for simple in commands(prepare(command)[0]):
        record = record_name(simple.words)
        if check and record:
            return check, record
        if simple.piped and not pipefail:
            check = check or check_name(simple.words)
        if not simple.grouped:
            pipefail = pipefail_after(simple.words, pipefail)
    return None


def hidden_failures(
    command: str, pipefail: bool = False, hidden: bool = False
) -> list[str]:
    """The names of the commands in ``command`` whose failure a pipe hides, in the order
    they come. ``pipefail``: on as the script starts. ``hidden``: the script's own output
    goes into a pipe that hides its status."""
    cleaned, substitutions, heredocs = prepare(command)
    found = []
    for simple in commands(cleaned):
        found += judge(simple.words, hides(simple, hidden, pipefail), pipefail)
        if not simple.grouped:
            pipefail = pipefail_after(simple.words, pipefail)
    for substitution in substitutions:
        found += hidden_failures(substitution, pipefail, hidden)
    for opener, body in heredocs:
        for simple in commands(prepare(opener)[0]):
            if reads_stdin(simple.words):
                hidden_body = hides(simple, hidden, pipefail)
                found += hidden_failures(
                    body, shell_pipefail(simple.words), hidden_body
                )
    return found


def hides(simple: Command, hidden: bool, pipefail: bool) -> bool:
    """Whether a pipe hides the status of what a simple command runs: the script around
    it is hidden, or it is piped while pipefail is off."""
    return hidden or simple.piped and not pipefail


def judge(words: list[str], hidden: bool, pipefail: bool) -> list[str]:
    """The names of the commands one simple command runs whose failure a pipe hides.
    ``hidden``: its output goes into a pipe that hides its status; ``pipefail``: on
    where it runs."""
    words, _ = command_of(words)
    if not words:
        return []
    name, args = Path(words[0]).name, words[1:]
    if name in SHELLS:
        script = shell_script(words)
        if script is None:
            return []
        return hidden_failures(script, shell_pipefail(words), hidden)
    if name == "eval":
        return hidden_failures(" ".join(args), pipefail, hidden)
    if name == "bgrun":
        parsed = bgrun_command(args)
        if parsed is None:
            return []
        waits, rest = parsed
        return (["bgrun --wait"] if waits and hidden else []) + judge(
            rest, False, False
        )
    if not hidden:
        return []
    if name == "wt-ship":
        return [] if asks_help(args) else ["wt-ship"]
    commit = commit_args(args) if name == "git" else None
    if commit is None or asks_help(commit) or "--dry-run" in commit:
        return []
    return ["git commit"]


def asks_help(args: list[str]) -> bool:
    """Whether a command's arguments ask for its help: -h or --help comes first."""
    return bool(args) and is_help(args[0])


def pipefail_after(words: list[str], pipefail: bool) -> bool:
    """Whether pipefail is on after one simple command, which may be a `set`."""
    words, _ = command_of(words)
    return set_pipefail(words[1:], pipefail) if words[:1] == ["set"] else pipefail


def shell_pipefail(words: list[str]) -> bool:
    """Whether a shell command starts its shell with pipefail on (-o pipefail)."""
    words, _ = command_of(words)
    return set_pipefail(words[1:], False)


HEAVY_GATE = Path(__file__).resolve().parent / "heavy-gate"
# Well under the 10 s install.py gives this hook, so a stalled heavy-gate costs only
# its own reason, never this hook's refusal.
HEAVY_GATE_TIMEOUT = 4


def heavy_gate_reason(event: dict) -> str | None:
    """heavy-gate's reason for refusing the same call, without its `Refused: ` and its
    closing sentence, or None when it allows the call or can't be run."""
    try:
        verdict = subprocess.run(
            [sys.executable, HEAVY_GATE],
            input=json.dumps(event),
            capture_output=True,
            text=True,
            check=False,
            timeout=HEAVY_GATE_TIMEOUT,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if verdict.returncode != 2:
        return None
    reason = verdict.stderr.strip().removeprefix("Refused: ").removesuffix(NOTHING_RAN)
    return reason.strip() or None


def main(argv=None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if any(arg in ("-h", "--help") for arg in argv):
        print(__doc__)
        return 0
    try:
        event = json.load(sys.stdin)
    except json.JSONDecodeError as error:
        print(
            f"pipe-status-gate: the hook input isn't JSON ({error}); it reads the "
            "PreToolUse event Claude Code sends on stdin.",
            file=sys.stderr,
        )
        return 1
    if event.get("tool_name") != "Bash":
        return 0
    command = (event.get("tool_input") or {}).get("command") or ""
    found = hidden_failures(command)
    if found:
        refusal = REFUSAL.format(name=found[0])
    elif unseen := unseen_check(command):
        refusal = UNSEEN_CHECK.format(check=unseen[0], record=unseen[1])
    else:
        return 0
    if heavy := heavy_gate_reason(event):
        refusal += f"\nheavy-gate would refuse this call too: {heavy}"
    print(f"{refusal} {NOTHING_RAN}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
