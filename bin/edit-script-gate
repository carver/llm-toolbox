#!/usr/bin/env python3
"""A Claude Code PreToolUse hook that steers literal text edits to apply-edits.

Refuses a Bash command that runs inline Python (a heredoc or -c) which reads a file,
calls .replace( and writes a file: the read-replace-write script that apply-edits
replaces. A pattern-based edit (re.sub, sed) passes, and so does a script marked
"# not a text edit", for one that only looks like an edit. install.py registers it
in ~/.claude/settings.json.

    edit-script-gate < hook-input.json    # as Claude Code calls it
"""

import json
import re
import sys

# Python run as a command, at the start of the command or after ; & | ( or a newline.
RUNS_PYTHON = re.compile(
    r"(?:^|[;&|(\n])\s*(?:uv run(?: \S+)*? )?python3?(?:\.\d+)?\s", re.MULTILINE
)
INLINE_CODE = re.compile(r"<<-?\s*['\"]?\w+|\s-c\s")
READS = re.compile(r"\.read\(\)|read_text\(")
WRITES = re.compile(r"\.write\(|write_text\(")
MARKER = "# not a text edit"
REASON = (
    "Refused: an inline Python script that reads a file, .replace()s literal text and "
    "writes it back. Pipe old/new blocks to apply-edits instead (apply-edits -h): it "
    "applies them all or nothing and shows the closest text when one misses. A "
    "pattern-based edit can use re.sub or sed; mark a script that isn't a text edit "
    f"with a '{MARKER}' line."
)


def is_edit_script(command: str) -> bool:
    """Whether ``command`` runs inline Python that reads, .replace()s and writes."""
    return (
        MARKER not in command
        and RUNS_PYTHON.search(command) is not None
        and INLINE_CODE.search(command) is not None
        and ".replace(" in command
        and READS.search(command) is not None
        and WRITES.search(command) is not None
    )


def main(argv=None) -> int:
    event = json.load(sys.stdin)
    if event.get("tool_name") != "Bash":
        return 0
    if is_edit_script(event.get("tool_input", {}).get("command", "")):
        print(REASON, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
