#!/usr/bin/env python3
"""List and resolve git conflict hunks, then continue the operation they stopped.

    conflicts FILE...           list each file's hunks, numbered, with both sides
    conflicts FILE N SIDE       resolve hunk N of FILE
    conflicts FILE all SIDE     resolve every hunk of FILE the same way
    conflicts --continue        stage the resolved files and continue

Triples repeat, to resolve several files in one call:
`conflicts a.py all ours b.md 1 theirs b.md 2 both`. Hunk numbers are the listing's,
from before the call, so one file's hunks can each take a side in the same call. The
call resolves every triple or none: an argument out of place is a usage error, and a
hunk that isn't there or a file it can't read changes no file. N, all and the SIDE
words are never file names; a file so named goes as ./all.

SIDE is ours (the side after <<<<<<<), theirs (the side before >>>>>>>), both (ours,
then theirs) or base (the ||||||| side, in a diff3 or zdiff3 hunk). Each side's marker
label is printed with it: in a rebase, ours (HEAD) is the branch being rebased onto
and theirs is the commit being replayed.

apply-edits can't resolve a hunk, since its own blocks use the ======= line. A
separator line counts as a marker only inside a hunk, so a reStructuredText underline
is content. In a file git has in conflict, a hunk that one of the merge's inputs
already held word for word, such as a test fixture's, is content too, and markers are
as long as the file's conflict-marker-size attribute makes git write them (7 when
unset). A hunk that never closes, lacks its separator or opens inside another, or a
closing or base marker outside any hunk, makes conflicts refuse the file and change
nothing. Line endings, and bytes that aren't UTF-8, are kept. Resolving never stages
a file: once a file has no hunk left it says so.

--continue finishes the stopped rebase, cherry-pick, merge, revert or am. It checks
what would be committed: each file git has unmerged, as `git add` would stage it
(worked out in a copy of the index), and each staged by hand since the stop, as
staged. While any still holds a hunk (counted as the listing counts them) or is
malformed, it names each with its count and stages nothing. It does the same for a
conflict git wrote no markers into, where nothing tells a resolution from the side
git left: a side deleted, binary, a symlink or submodule, or a merge attribute such
as binary; `git add` or `git rm` that one yourself, once it holds what it should.
Otherwise it stages the unmerged files, runs `git COMMAND --continue` with
GIT_EDITOR=true, so each commit keeps the message git prepared, passes on git's
output and exits with its status. When that stops at the next commit's conflicts, it
lists them as `conflicts FILE` does. Paths print relative to the current directory.

Exit status: 0 listed, resolved, or continued to the end; 1 a hunk that isn't there
or a malformed or unreadable file (nothing changed), --continue refused (nothing
staged), or the continue stopped at the next conflict; 2 a usage error (nothing
changed); 3 --continue with nothing in progress; any other: git's own failure, from
staging or the continue.
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile
from dataclasses import dataclass, field
from pathlib import Path

USAGE = """
  conflicts [-h] FILE...
  conflicts [-h] FILE N|all SIDE [FILE N|all SIDE ...]
  conflicts [-h] --continue"""
SIDES = ("ours", "theirs", "both", "base")
MARK = 7  # git's default conflict-marker-size


@dataclass
class Hunk:
    start: int  # line number of <<<<<<<, from 1
    end: int  # line number of >>>>>>>
    ours_label: str
    theirs_label: str
    size: int = MARK  # the marker length it was written with
    ours: list[str] = field(default_factory=list)
    base: list[str] | None = None
    base_label: str = ""
    theirs: list[str] = field(default_factory=list)


@dataclass(frozen=True)
class Known:
    """What git says of a file: the marker length its conflicts are written with, and
    the hunks its merge inputs already held (each as its lines without endings),
    which are content, such as a test fixture's."""

    size: int = MARK
    content: frozenset[tuple[str, ...]] = frozenset()


class Refused(Exception):
    """A file this call can't resolve as asked; nothing is written."""


class Malformed(Refused):
    """Markers that don't make a hunk."""


class Usage(Exception):
    pass


def marker(line: str, char: str, size: int = MARK) -> str | None:
    """The label after a marker made of `char`, or None when the line isn't one."""
    body = line.rstrip("\r\n")
    if len(body) < size or body[:size] != char * size:
        return None
    if body[size : size + 1] not in ("", " "):
        return None
    return body[size + 1 :]


def unmarked(lines: list[str]) -> tuple[str, ...]:
    return tuple(line.rstrip("\r\n") for line in lines)


PLAIN = Known()  # a file git says nothing of: 7-character markers, no fixtures


def parse(lines: list[str], known: Known = PLAIN) -> list[Hunk | str]:
    """The file as plain lines and hunks, in order. A hunk `known` holds as content
    stays plain lines."""
    size = known.size
    parts: list[Hunk | str] = []
    hunk, section = None, None
    for number, line in enumerate(lines, start=1):
        opening = marker(line, "<", size)
        if hunk is None:
            if opening is not None:
                hunk, section = Hunk(number, 0, opening, "", size), "ours"
            elif (
                marker(line, ">", size) is not None
                or marker(line, "|", size) is not None
            ):
                raise Malformed(f"line {number}: a {line[:size]} outside any hunk")
            else:
                parts.append(line)
            continue
        if opening is not None:
            raise Malformed(
                f"line {number}: a hunk opens inside the one from line {hunk.start}"
            )
        if section == "ours" and (base := marker(line, "|", size)) is not None:
            hunk.base, hunk.base_label, section = [], base, "base"
        elif section in ("ours", "base") and marker(line, "=", size) is not None:
            section = "theirs"
        elif (closing := marker(line, ">", size)) is not None:
            if section != "theirs":
                raise Malformed(
                    f"line {number}: the hunk from line {hunk.start} has no {'=' * size}"
                )
            hunk.end, hunk.theirs_label = number, closing
            raw = lines[hunk.start - 1 : number]
            if unmarked(raw) in known.content:
                parts.extend(raw)
            else:
                parts.append(hunk)
            hunk = None
        elif section == "ours":
            hunk.ours.append(line)
        elif section == "base":
            hunk.base.append(line)
        else:
            hunk.theirs.append(line)
    if hunk is not None:
        raise Malformed(f"the hunk from line {hunk.start} never closes")
    return parts


REGULAR = ("100644", "100755")  # index modes of a file git merges as text


@dataclass
class Facts:
    """One path as the index has it: its entries by stage, as (mode, blob)."""

    stages: dict[int, tuple[str, str]]
    known: Known
    merge: str  # its merge attribute
    binary: bool  # a NUL byte early in some stage's blob, as git judges it


def run_git(
    args: list[str], cwd: Path | None, stdin: bytes | None = None, env=None
) -> bytes:
    """git's output, or b"" when git fails or isn't there."""
    try:
        done = subprocess.run(
            ["git", *args],
            cwd=cwd,
            input=stdin,
            env=env,
            capture_output=True,
            check=False,
        )
    except OSError:
        return b""
    return done.stdout if done.returncode == 0 else b""


def toplevel() -> Path | None:
    out = run_git(["rev-parse", "--show-toplevel"], None).rstrip(b"\n")
    return Path(os.fsdecode(out)) if out else None


def index_stages(
    top: Path, flag: str, paths: list[str] | None = None, env=None
) -> dict:
    """Each path's entries by stage, as `git ls-files FLAG` lists them: -u the
    unmerged ones, --resolve-undo those of paths staged by hand during this stop,
    --stage every one."""
    if paths == []:
        return {}
    args = ["--literal-pathspecs", "ls-files", "-z", flag, "--", *(paths or [])]
    found: dict[str, dict[int, tuple[str, str]]] = {}
    for record in run_git(args, top, env=env).split(b"\0"):
        if record:
            info, _, path = record.partition(b"\t")
            mode, sha, stage = info.decode().split()
            found.setdefault(os.fsdecode(path), {})[int(stage)] = (mode, sha)
    return found


def blobs(top: Path, shas: set[str]) -> dict[str, bytes]:
    if not shas:
        return {}
    out = run_git(
        ["cat-file", "--batch"], top, "".join(f"{s}\n" for s in shas).encode()
    )
    found, at = {}, 0
    while (eol := out.find(b"\n", at)) != -1:
        sha, kind, *size = out[at:eol].decode().split()
        at = eol + 1
        if kind != "missing":
            found[sha] = out[at : at + int(size[0])]
            at += int(size[0]) + 1
    return found


def marker_size(value: str | None) -> int:
    """conflict-marker-size as git reads it: a whole number, signed or not, above 0
    and within a C int, else the default."""
    if value and re.fullmatch(r"[+-]?[0-9]+", value) and 0 < int(value) < 2**31:
        return int(value)
    return MARK


def held(data: list[bytes], size: int) -> frozenset[tuple[str, ...]]:
    """The hunks these blobs hold, each as its lines without endings."""
    found = set()
    for blob in data:
        lines = text_lines(blob)
        try:
            parts = parse(lines, Known(size))
        except Malformed:
            continue
        found.update(unmarked(lines[h.start - 1 : h.end]) for h in hunks(parts))
    return frozenset(found)


def gather(top: Path, entries: dict[str, dict[int, tuple[str, str]]]) -> dict:
    """Facts for each path (relative to `top`) of `entries`, which are its index
    stages, empty for a path not in conflict."""
    if not entries:
        return {}
    # As the merge read them: HEAD's, not those the merge brought into the worktree.
    attributes = ["check-attr", "-z", "conflict-marker-size", "merge", "--", *entries]
    out = run_git([attributes[0], "--source=HEAD", *attributes[1:]], top)
    out = out or run_git(attributes, top)  # no HEAD yet
    fields = [os.fsdecode(f) for f in out.split(b"\0")]
    attrs: dict[str, dict[str, str]] = {}
    for at in range(0, len(fields) - 2, 3):
        attrs.setdefault(fields[at], {})[fields[at + 1]] = fields[at + 2]
    shas = {
        sha for s in entries.values() for mode, sha in s.values() if mode in REGULAR
    }
    data = blobs(top, shas)
    facts = {}
    for path, stages in entries.items():
        size = marker_size(attrs.get(path, {}).get("conflict-marker-size"))
        inputs = [data[sha] for _, sha in stages.values() if sha in data]
        facts[path] = Facts(
            stages,
            Known(size, held(inputs, size)),
            attrs.get(path, {}).get("merge", "unspecified"),
            any(b"\0" in blob[:8000] for blob in inputs),
        )
    return facts


def known_files(paths: list[str]) -> dict[str, Known]:
    """Known for each path as given that lies in this repository."""
    top = toplevel()
    if top is None:
        return {}
    inside = {}
    for path in paths:
        relative = os.path.relpath(os.path.realpath(path), os.path.realpath(top))
        if relative != os.pardir and not relative.startswith(os.pardir + os.sep):
            inside[path] = relative
    if not inside:
        return {}
    named = sorted(set(inside.values()))
    entries: dict[str, dict[int, tuple[str, str]]] = {path: {} for path in named}
    entries.update(index_stages(top, "--resolve-undo", named))
    entries.update(index_stages(top, "-u", named))
    facts = gather(top, entries)
    return {path: facts[relative].known for path, relative in inside.items()}


def hunks(parts: list[Hunk | str]) -> list[Hunk]:
    return [part for part in parts if isinstance(part, Hunk)]


def side_lines(hunk: Hunk, side: str) -> list[str]:
    if side == "both":
        return hunk.ours + hunk.theirs
    if side == "base":
        if hunk.base is None:
            raise Malformed(
                f"hunk at line {hunk.start} has no base side (not a diff3 hunk)"
            )
        return hunk.base
    return hunk.ours if side == "ours" else hunk.theirs


def read_lines(path: Path) -> list[str]:
    """The file's lines with their endings; a byte that isn't UTF-8 survives a write."""
    with open(path, newline="", encoding="utf-8", errors="surrogateescape") as file:
        return file.read().splitlines(keepends=True)


def text_lines(blob: bytes) -> list[str]:
    """A blob's lines, as read_lines reads a file's."""
    return blob.decode("utf-8", "surrogateescape").splitlines(keepends=True)


def load(path: Path, known: Known) -> list[Hunk | str]:
    """The file's parts; Refused when it's malformed or can't be read."""
    try:
        return parse(read_lines(path), known)
    except OSError as error:
        raise Refused(error.strerror) from error


def replace_all(texts: list[tuple[str, str]]) -> None:
    """Write each (path, text) beside its file, then move each into place, so a write
    that fails leaves every file as it was. An OSError names the path given."""
    written = []
    try:
        for path, text in texts:
            real = Path(os.path.realpath(path))
            try:
                handle, temp = tempfile.mkstemp(
                    dir=real.parent, prefix=f".{real.name}."
                )
                written.append((temp, real))
                with open(
                    handle, "w", newline="", encoding="utf-8", errors="surrogateescape"
                ) as file:
                    file.write(text)
                shutil.copymode(real, temp)
            except OSError as error:
                raise OSError(error.errno, error.strerror, path) from error
    except BaseException:
        for temp, _ in written:
            os.unlink(temp)
        raise
    for temp, real in written:
        os.replace(temp, real)


def show(path: str, parts: list[Hunk | str]) -> None:
    found = hunks(parts)
    if not found:
        print(f"{path}: no conflicts")
        return
    for number, hunk in enumerate(found, start=1):
        print(f"{path}, hunk {number}, lines {hunk.start}-{hunk.end}")
        sides = [("ours", hunk.ours_label, hunk.ours)]
        if hunk.base is not None:
            sides.append(("base", hunk.base_label, hunk.base))
        sides.append(("theirs", hunk.theirs_label, hunk.theirs))
        for name, label, lines in sides:
            print(f"  {name}{f' ({label})' if label else ''}:")
            for line in lines:
                print(f"    | {line.rstrip(chr(13) + chr(10))}")


def is_keyword(word: str) -> bool:
    """A word that picks a hunk or a side, so never a FILE (`./all` is one)."""
    return word == "all" or is_number(word) or word in SIDES


def is_number(word: str) -> bool:
    return word.isascii() and word.isdigit()


def choices(args: list[str]) -> list[tuple[str, list[tuple[str, str]]]] | None:
    """Each FILE with its (N|all, SIDE) picks, in the order given, or None when every
    argument is a file to list. A file named twice, by any path, is one entry."""
    if not any(map(is_keyword, args)):
        return None
    files: dict[str, tuple[str, list[tuple[str, str]]]] = {}
    for at in range(0, len(args), 3):
        path, *rest = args[at : at + 3]
        if is_keyword(path):
            raise Usage(
                f"expected a FILE, not {path!r} (a file so named goes as ./{path})"
            )
        if not rest:
            raise Usage(f"expected N|all SIDE after {path}")
        which = rest[0]
        if which != "all" and not is_number(which):
            raise Usage(f"expected N or all after {path}, not {which!r}")
        side = rest[1] if len(rest) > 1 else None
        if side not in SIDES:
            raise Usage(
                f"expected a SIDE ({', '.join(SIDES)}) after {path} {which}"
                + (f", not {side!r}" if side else "")
            )
        _, picks = files.setdefault(os.path.realpath(path), (path, []))
        if picks and "all" in (which, *(earlier for earlier, _ in picks)):
            raise Usage(f"{path}: all picks every hunk, so it takes no other pick")
        if which != "all" and int(which) in {int(earlier) for earlier, _ in picks}:
            raise Usage(f"{path}: hunk {int(which)} is picked twice")
        picks.append((which, side))
    return list(files.values())


def resolved(path: str, picks: list[tuple[str, str]], known: Known) -> tuple[str, str]:
    """The text of `path` with `picks` applied to its hunks as listed, and the line that
    says so."""
    parts = parse(read_lines(Path(path)), known)
    found = hunks(parts)
    if picks[0][0] == "all":
        sides = dict.fromkeys(range(len(found)), picks[0][1])
    else:
        sides = {}
        for which, side in picks:
            number = int(which)
            if not 1 <= number <= len(found):
                raise Refused(f"no hunk {number}, as it has {len(found)}")
            sides[number - 1] = side
    out, index = [], 0
    for part in parts:
        if isinstance(part, str):
            out.append(part)
            continue
        out.extend(side_lines(part, sides[index]) if index in sides else render(part))
        index += 1
    said = picks[0][1] if len(picks) == 1 else ", ".join(map(" ".join, picks))
    left = len(found) - len(sides)
    after = f"{plural(left, 'hunk')} left" if left else "no conflicts left"
    if not left:
        after += f", so `git add {path}`, or `conflicts --continue`"
    return "".join(out), f"{path}: resolved ({said}); {after}"


def plural(count: int, noun: str) -> str:
    return f"{count} {noun}{'' if count == 1 else 's'}"


def resolve(files: list[tuple[str, list[tuple[str, str]]]]) -> int:
    """Apply every file's picks, or none: any failure writes nothing."""
    done, known = [], known_files([path for path, _ in files])
    for path, picks in files:
        try:
            done.append((path, *resolved(path, picks, known.get(path, PLAIN))))
        except Refused as error:
            print(f"{path}: {error}; changed nothing", file=sys.stderr)
            return 1
        except OSError as error:
            print(f"{path}: {error.strerror}; changed nothing", file=sys.stderr)
            return 1
    try:
        replace_all([(path, text) for path, text, _ in done])
    except OSError as error:
        print(f"{error.filename}: {error.strerror}; changed nothing", file=sys.stderr)
        return 1
    for _, _, said in done:
        print(said)
    return 0


def render(hunk: Hunk) -> list[str]:
    """A hunk back as its marker lines, for the hunks left unresolved."""
    eol = (
        "\r\n"
        if any(line.endswith("\r\n") for line in hunk.ours + hunk.theirs)
        else "\n"
    )
    size = hunk.size
    lines = [f"{'<' * size} {hunk.ours_label}".rstrip() + eol, *hunk.ours]
    if hunk.base is not None:
        lines += [f"{'|' * size} {hunk.base_label}".rstrip() + eol, *hunk.base]
    lines += [
        "=" * size + eol,
        *hunk.theirs,
        f"{'>' * size} {hunk.theirs_label}".rstrip() + eol,
    ]
    return lines


def list_files(paths: list[str]) -> int:
    code, known = 0, known_files(paths)
    for path in paths:
        try:
            show(path, parse(read_lines(Path(path)), known.get(path, PLAIN)))
        except Refused as error:
            print(f"{path}: {error}", file=sys.stderr)
            code = 1
        except OSError as error:
            print(f"{path}: {error.strerror}", file=sys.stderr)
            code = 1
    return code


# Each operation by the file git keeps in its dir while one is stopped, first match
# first: `git am` keeps rebase-apply/applying in the folder a rebase also uses, and a
# range cherry-pick or revert whose stopped commit was committed by hand keeps only
# sequencer/todo.
OPERATIONS = (
    ("rebase-merge", "rebase"),
    ("rebase-apply/applying", "am"),
    ("rebase-apply", "rebase"),
    ("CHERRY_PICK_HEAD", "cherry-pick"),
    ("REVERT_HEAD", "revert"),
    ("MERGE_HEAD", "merge"),
    ("sequencer/todo", None),  # named by its first command
)
SEQUENCED = {"pick": "cherry-pick", "revert": "revert"}
MISSING_SIDE = {
    frozenset({1, 3}): "deleted by us",
    frozenset({1, 2}): "deleted by them",
    frozenset({2}): "added by us",
    frozenset({3}): "added by them",
    frozenset({1}): "both deleted",
}
# merge attribute values under which git merges text and writes markers.
TEXT_MERGES = ("unspecified", "set", "text", "union")


def git_paths(top: Path, names: tuple[str, ...]) -> dict[str, Path]:
    """Where each of `names` lives in this worktree's git dir."""
    args = [arg for name in names for arg in ("--git-path", name)]
    out = run_git(["rev-parse", *args], top).decode().splitlines()
    return {name: top / path for name, path in zip(names, out)}


def operation(top: Path) -> str | None:
    """The git command whose stop this is: rebase, am, cherry-pick, revert or merge."""
    paths = git_paths(top, tuple(name for name, _ in OPERATIONS))
    for name, command in OPERATIONS:
        if not paths[name].exists():
            continue
        if command:
            return command
        commands = paths[name].read_text().split()
        return SEQUENCED.get(commands[0]) if commands else None
    return None


def shown(top: Path, path: str) -> str:
    """`path` (relative to `top`) as `conflicts` takes it from here."""
    relative = os.path.relpath(top / path)
    return f"./{relative}" if is_keyword(relative) or relative[0] == "-" else relative


def unmarked_why(facts: Facts, file: Path) -> str | None:
    """Why git wrote no markers into this unmerged file, when it wrote none: so
    nothing tells its resolution from the side git left in the worktree."""
    if 2 not in facts.stages or 3 not in facts.stages:
        return MISSING_SIDE[frozenset(facts.stages)]
    if any(mode not in REGULAR for mode, _ in facts.stages.values()):
        return "a symlink or submodule"
    if facts.binary:
        return "binary"
    if facts.merge not in TEXT_MERGES:
        return f"merged by its merge attribute ({facts.merge})"
    if file.is_symlink() or not file.is_file():
        return "not a file in the worktree"
    return None


def unmarked_note(top: Path, path: str, facts: Facts) -> str | None:
    """For an unmerged file git wrote no markers into, the line that says so."""
    name, why = shown(top, path), unmarked_why(facts, top / path)
    if why is None:
        return None
    return (
        f"{name}: {why}, so git wrote no markers to check; `git add {name}`"
        f" or `git rm {name}` once it holds what it should"
    )


def as_staged(top: Path, adding: list[str], paths: list[str]) -> tuple[int, dict]:
    """The text each of `paths` would be committed with once `adding` is staged, as git
    stores it (after its filters and encodings), worked out in a copy of the index so
    nothing is staged yet; with git add's failure status, or 0. A path that wouldn't
    be committed as a regular file has none."""
    index = git_paths(top, ("index",))["index"]
    handle, copy = tempfile.mkstemp(dir=index.parent, prefix="conflicts-index.")
    os.close(handle)
    env = {**os.environ, "GIT_INDEX_FILE": copy}
    try:
        shutil.copyfile(index, copy)
        if adding:
            add = subprocess.run(
                ["git", "--literal-pathspecs", "add", "--", *adding],
                cwd=top,
                env=env,
                check=False,
            )
            if add.returncode:
                return add.returncode, {}
        entries = index_stages(top, "--stage", paths, env)
    finally:
        os.unlink(copy)
    kept = {path: s[0] for path, s in entries.items() if s.get(0, ("",))[0] in REGULAR}
    data = blobs(top, {sha for _, sha in kept.values()})
    return 0, {path: text_lines(data[sha]) for path, (_, sha) in kept.items()}


def proceed() -> int:
    """`conflicts --continue`."""
    top = toplevel()
    command = operation(top) if top else None
    if command is None:
        print(
            "conflicts: no rebase, cherry-pick, merge, revert or am in progress",
            file=sys.stderr,
        )
        return 3
    unmerged = index_stages(top, "-u")
    by_hand = {
        path: stages
        for path, stages in index_stages(top, "--resolve-undo").items()
        if path not in unmerged
    }
    facts = gather(top, {**unmerged, **by_hand})
    notes = {path: unmarked_note(top, path, facts[path]) for path in unmerged}
    adding = sorted(path for path, note in notes.items() if note is None)
    status, staged = as_staged(top, adding, sorted(facts))
    if status:
        return status
    left = []
    for path in sorted(facts):
        name, where = shown(top, path), "" if path in unmerged else ", as staged"
        try:
            count = len(hunks(parse(staged.get(path, []), facts[path].known)))
        except Malformed as error:
            left.append(f"{name}: {error}{where}")
            continue
        if notes.get(path):
            left.append(notes[path])
        elif count:
            left.append(f"{name}: {plural(count, 'hunk')} left{where}")
    if left:
        print(
            f"conflicts: {plural(len(left), 'file')} still in conflict, so nothing"
            " was staged; resolve these, then run `conflicts --continue` again:",
            *(f"  {line}" for line in left),
            sep="\n",
            file=sys.stderr,
        )
        return 1
    if adding:
        add = subprocess.run(
            ["git", "--literal-pathspecs", "add", "--", *adding], cwd=top, check=False
        )
        if add.returncode:
            return add.returncode
    print(
        f"conflicts: staged {plural(len(adding), 'file')}; running git {command}"
        " --continue",
        flush=True,
    )
    code = subprocess.run(
        ["git", "-c", "advice.mergeConflict=false", command, "--continue"],
        cwd=top,
        env={**os.environ, "GIT_EDITOR": "true"},
        check=False,
    ).returncode
    # Every unmerged file was staged, so one unmerged now is the next commit's.
    if code and (unmerged := index_stages(top, "-u")):
        facts = gather(top, unmerged)
        for path in sorted(facts):
            if note := unmarked_note(top, path, facts[path]):
                print(note)
                continue
            try:
                show(shown(top, path), load(top / path, facts[path].known))
            except Refused as error:
                print(f"{shown(top, path)}: {error}")
        sys.stdout.flush()
        print(
            f"conflicts: the {command} stopped at the next conflict; resolve it,"
            " then run `conflicts --continue`",
            file=sys.stderr,
        )
    return code


def main(argv=None):
    parser = argparse.ArgumentParser(
        usage=USAGE,
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("args", nargs="*", help=argparse.SUPPRESS)
    parser.add_argument(
        "--continue",
        dest="proceed",
        action="store_true",
        help="check, stage and continue the stopped rebase, cherry-pick, merge,"
        " revert or am",
    )
    options = parser.parse_args(argv)
    args = options.args
    sys.stdout.reconfigure(errors="replace")  # a listed line that isn't UTF-8
    if options.proceed:
        if args:
            parser.error("--continue takes no FILE")
        return proceed()
    if not args:
        parser.error("name a FILE, or --continue")
    try:
        files = choices(args)
    except Usage as error:
        parser.error(str(error))
    if files is None:
        return list_files(args)
    return resolve(files)


if __name__ == "__main__":
    sys.exit(main())
