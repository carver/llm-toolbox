#!/usr/bin/env python3
"""Start a Rust egui desktop app for Ubuntu GNOME on Wayland.

Copies templates/egui-app into DIR, filling in the crate name, app id and
window title. The result builds as is: an eframe window drawn with glow,
with an icon, a .desktop entry whose StartupWMClass matches the app id, a
startup timing line on stderr, an egui_kittest test, git hooks (rustfmt
before each commit, clippy and the tests for agents' commits), a CI
workflow, a per-user install script, and a CLAUDE.md with the gotchas the
earlier apps ran into.

DIR must be missing, empty, or hold only .git. It becomes a git repository
if it is not one, with core.hooksPath set to .githooks.
"""

import argparse
import re
import shutil
import subprocess
import sys
from pathlib import Path

TEMPLATE = Path(__file__).resolve().parent.parent / "templates" / "egui-app"
PLACEHOLDER = re.compile(r"\{\{\s*(\w+)\s*\}\}")
# Lowercase, since the name doubles as the app id and the .desktop file's name.
CRATE_NAME = re.compile(r"[a-z](?:[a-z0-9_-]*[a-z0-9])?")
# The library crate is named after the package with - as _, so it must not be
# a Rust keyword (2024 edition, reserved ones included).
RUST_KEYWORDS = {
    "abstract",
    "as",
    "async",
    "await",
    "become",
    "box",
    "break",
    "const",
    "continue",
    "crate",
    "do",
    "dyn",
    "else",
    "enum",
    "extern",
    "false",
    "final",
    "fn",
    "for",
    "gen",
    "if",
    "impl",
    "in",
    "let",
    "loop",
    "macro",
    "match",
    "mod",
    "move",
    "mut",
    "override",
    "priv",
    "pub",
    "ref",
    "return",
    "self",
    "static",
    "struct",
    "super",
    "trait",
    "true",
    "try",
    "type",
    "typeof",
    "unsafe",
    "unsized",
    "use",
    "virtual",
    "where",
    "while",
    "yield",
}
# Cargo refuses these: standard library crates, and target/ directory names.
CARGO_RESERVED = {"alloc", "core", "proc_macro", "std", "test"} | {
    "build",
    "deps",
    "examples",
    "incremental",
}
# Characters that would break the Rust string literals or the .desktop entry.
TITLE_FORBIDDEN = re.compile(r'["\\\n\r]')


def name_problem(crate: str) -> str | None:
    if not CRATE_NAME.fullmatch(crate):
        return "use lowercase letters, digits, - and _, starting with a letter and ending with a letter or digit"
    ident = crate.replace("-", "_")
    if ident in RUST_KEYWORDS:
        return "a Rust keyword cannot name a crate"
    if ident in CARGO_RESERVED:
        return "cargo reserves this name"
    return None


def default_title(crate: str) -> str:
    return " ".join(word.capitalize() for word in re.split(r"[-_]+", crate) if word)


def as_text(data: bytes) -> str | None:
    """The file's text, or None for a binary file, which is copied as is."""
    try:
        return data.decode()
    except UnicodeDecodeError:
        return None


def fill(text: str, values: dict[str, str], where: Path) -> str:
    def substitute(match: re.Match[str]) -> str:
        key = match.group(1)
        if key not in values:
            raise SystemExit(
                f"new-egui-app: unknown placeholder {{{{{key}}}}} in {where}"
            )
        return values[key]

    return PLACEHOLDER.sub(substitute, text)


def render(values: dict[str, str]) -> dict[Path, tuple[bytes, Path]]:
    """Each output path, relative to the project, with its content and the
    template file it came from. Exits on an unknown placeholder, before
    anything is written."""
    rendered = {}
    for source in sorted(TEMPLATE.rglob("*")):
        if not source.is_file():
            continue
        relative = source.relative_to(TEMPLATE)
        data = source.read_bytes()
        text = as_text(data)
        if text is not None:
            data = fill(text, values, relative).encode()
        rendered[Path(fill(str(relative), values, relative))] = (data, source)
    return rendered


def write(target: Path, rendered: dict[Path, tuple[bytes, Path]]) -> None:
    for relative, (data, source) in rendered.items():
        dest = target / relative
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_bytes(data)
        shutil.copymode(source, dest)


def why_unusable(target: Path) -> str | None:
    if not target.exists():
        return None
    if not target.is_dir():
        return f"{target} is not a directory"
    others = [p.name for p in target.iterdir() if p.name != ".git"]
    if others:
        shown = ", ".join(sorted(others)[:5])
        if len(others) > 5:
            shown += f" and {len(others) - 5} more"
        return f"{target} is not empty (holds {shown})"
    return None


def git(target: Path, *args: str) -> None:
    subprocess.run(["git", "-C", str(target), *args], check=True)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="new-egui-app",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Nothing is committed: build and look at the app first, then\n"
            "commit it yourself (`cargo build` writes Cargo.lock, which belongs\n"
            "in the first commit)."
        ),
    )
    parser.add_argument("dir", type=Path, help="where to create the project")
    parser.add_argument(
        "--name",
        help="crate name, also the binary, app id and .desktop file name "
        "(default: DIR's basename)",
    )
    parser.add_argument(
        "--title",
        help='window title and launcher name (default: from the name, "my-app" -> "My App")',
    )
    args = parser.parse_args(argv)

    target = args.dir.resolve()
    crate = args.name or target.name
    problem = name_problem(crate)
    if problem:
        parser.error(f"name {crate!r}: {problem}")
    title = args.title or default_title(crate)
    if TITLE_FORBIDDEN.search(title):
        parser.error("title: no quotes, backslashes or line breaks")
    problem = why_unusable(target)
    if problem:
        print(f"new-egui-app: {problem}", file=sys.stderr)
        return 1

    values = {
        "crate": crate,
        "crate_ident": crate.replace("-", "_"),
        "title": title,
    }
    rendered = render(values)
    target.mkdir(parents=True, exist_ok=True)
    write(target, rendered)
    if not (target / ".git").exists():
        git(target, "init", "--quiet")
    git(target, "config", "core.hooksPath", ".githooks")
    print(f"Created {crate} in {target}. Next: cd there, `cargo run`, then commit.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
