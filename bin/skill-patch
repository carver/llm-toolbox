#!/usr/bin/env python3
"""Keep hand edits to other authors' skills as patches that survive updates.

    skill-patch save NAME [-C WORKTREE] [--why TEXT [--replace-why]]
    skill-patch apply [NAME ...]

save writes skill-patches/NAME.patch in llm-toolbox: the diff from the
upstream version the skill was installed from to the installed copy in
~/.agents/skills/NAME, headed by one `# Why:` line per layer of edits. Edit
the installed copy first, then save. A new patch needs --why. On a skill that
already has a patch, --why adds a layer: the diff takes in the new edit, and
its reason joins the earlier ones, which save prints. --replace-why drops the
earlier reasons instead, for an edit that supersedes them. Saving without
--why keeps every reason. A skill back to its upstream state loses its patch.

-C WORKTREE writes the patch into that llm-toolbox worktree instead of the
main tree, to commit there and land with wt-ship. It refuses a folder of any
other repo, and a worktree whose base is behind a landed change to the same
patch, since the reasons it would layer on are stale: rebase it first. When
another worktree, or the main tree, holds an unlanded change to the patch, it
saves and names them: the installed copy all sessions share holds that
session's edits too, if it made them there, so this patch takes them in
without their reasons, and whichever lands second merges the reasons.

apply puts each patch (or the named ones) on its installed skill, skipping
those already on. install.py runs it after installing or updating. A patch
that no longer fits leaves the skill as upstream ships it: redo the change on
the installed copy, using the patch file as the guide, then save again.

Exit status: 0 success; 1 a patch didn't apply, or save found nothing to
compare against; 2 usage error.

Examples:
    skill-patch save show-me -C ../llm-toolbox-wt-show-me --why "Publish HTML views as Artifacts; open does nothing here."
    skill-patch apply
"""

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import thirdparty as tp
from maintree import git


class PatchError(Exception):
    pass


def source_of(name: str) -> str:
    for source, names in tp.third_party_skills().items():
        if name in names:
            return source
    raise PatchError(f"{name} isn't in install.py's THIRD_PARTY_SKILLS")


def installed_from(name: str) -> Path:
    """The upstream folder at the version installed, from the skills-news cache."""
    clone = tp.fetch(source_of(name), tp.CACHE)
    folder = tp.upstream_skills(clone).get(name)
    if folder is None:
        raise PatchError(f"{name} is no longer in its source")
    lock = json.loads(tp.LOCK.read_text())["skills"] if tp.LOCK.is_file() else {}
    recorded = lock.get(name, {}).get("skillFolderHash")
    if recorded != tp.tree_hash(clone, folder):
        raise PatchError(
            f"{name} changed upstream since it was installed, so its old version isn't "
            "at hand: run install.py --update, redo the edit, then save"
        )
    return folder


def worktrees(directory: Path) -> list[Path]:
    """The repo's work trees, the main one first, leaving out any whose folder is gone."""
    listing = git(directory, "worktree", "list", "--porcelain") or ""
    found = [
        Path(line[9:]) for line in listing.splitlines() if line.startswith("worktree ")
    ]
    return [tree for tree in found if tree.is_dir()]


def blob(tree: Path, rev: str, rel: str) -> str | None:
    """The id of `rel` at `rev`, or None when it isn't there."""
    found = git(tree, "rev-parse", "-q", "--verify", f"{rev}:{rel}")
    return found.strip() if found else None


def worktree_patches(directory: Path, name: str) -> Path:
    """The skill-patches/ folder of `directory`, an llm-toolbox worktree, once its
    base holds every landed change to NAME's patch. Warns of unlanded ones elsewhere."""
    found = directory.is_dir() and git(
        directory,
        "rev-parse",
        "--path-format=absolute",
        "--show-toplevel",
        "--git-common-dir",
    )
    if not found:
        raise PatchError(f"{directory} isn't a git work tree")
    top, common = map(Path, found.splitlines())
    ours = git(tp.REPO, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if not ours or Path(ours.strip()).resolve() != common.resolve():
        raise PatchError(f"{directory} isn't a worktree of {tp.REPO}")
    rel = f"{tp.PATCHES.name}/{name}.patch"
    trees = worktrees(top)
    main = trees[0] if trees else top
    tip = (git(main, "rev-parse", "-q", "--verify", "HEAD") or "").strip()
    if not tip:
        return top / tp.PATCHES.name
    branch = (git(main, "symbolic-ref", "-q", "--short", "HEAD") or "").strip()
    onto = branch or tip[:12]
    ours = f"the main tree's {branch}" if branch else f"the main tree's HEAD ({onto})"

    def base(tree: Path) -> str | None:
        found = git(tree, "merge-base", "HEAD", tip)
        return found.strip() if found else None

    start = base(top)
    if start is None:
        raise PatchError(f"couldn't find {top}'s base on {ours}")
    if blob(top, start, rel) != blob(top, tip, rel):
        dirty = git(top, "status", "--porcelain", "--untracked-files=no")
        raise PatchError(
            f"{ours} changed {rel} after {top}'s base, so the reasons there are "
            f"stale: rebase it onto {onto} (git -C {top} rebase {onto})"
            + (" (commit or stash first)" if dirty else "")
            + ", then save again"
        )
    for tree in trees:
        if tree.resolve() == top.resolve() or (since := base(tree)) is None:
            continue
        here = (tree / rel).is_file() and git(tree, "hash-object", rel)
        if (here.strip() if here else None) != blob(tree, since, rel):
            print(
                f"skill-patch: {tree} holds an unlanded change to {rel}. The "
                "installed copy holds that session's edits too, if it made them "
                "there, so this patch takes them in without their reasons: the "
                "second of the two to land merges the reasons in its rebase "
                "conflict.",
                file=sys.stderr,
            )
    return top / tp.PATCHES.name


def save(
    name: str, why: str | None, replace_why: bool, patches: Path | None = None
) -> str:
    installed = tp.INSTALLED / name
    if not installed.is_dir():
        raise PatchError(f"{name} isn't installed in {tp.INSTALLED}")
    _, patch = tp.diff(installed_from(name), installed)
    existing = tp.patch_file(name, patches)
    if not patch:
        if existing:
            existing.unlink()
            return f"{name} matches upstream; removed {existing.name}"
        return f"{name} matches upstream; no patch"
    why = " ".join((why or "").split())  # one line, so it stays a # Why: line
    earlier = tp.whys(existing) if existing else []
    whys = [] if replace_why else list(earlier)
    if why and why not in whys:
        whys.append(why)
    if not whys:
        raise PatchError("a new patch needs --why")
    path = tp.write_patch(name, whys, patch, patches)
    report = [f"saved {path}; its reasons, one per layer of edits:"]
    report += [f"  {i}. {w}" for i, w in enumerate(whys, 1)]
    if dropped := [w for w in earlier if w not in whys]:
        report += ["dropped:", *(f"  - {w}" for w in dropped)]
    return "\n".join(report)


def apply(names: list[str]) -> int:
    patches = [tp.PATCHES / f"{n}.patch" for n in names] or sorted(
        tp.PATCHES.glob("*.patch")
    )
    conflicts = 0
    for patch in patches:
        name = patch.stem
        skill = tp.INSTALLED / name
        if not patch.is_file() or not skill.is_dir():
            print(f"  skipped {name}: no patch or no installed skill")
            continue
        status = tp.apply(skill, patch)
        if status == "conflict":
            conflicts += 1
            print(
                f"  CONFLICT {name}: {patch.name} no longer fits; redo it on {skill}, "
                f"then skill-patch save {name} -C WORKTREE"
            )
        elif status == "applied":
            print(f"  patched {name}")
    return 1 if conflicts else 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=__doc__.split("\n\n", 2)[2],
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    commands = parser.add_subparsers(dest="command", required=True)
    save_cmd = commands.add_parser(
        "save", help="write the installed skill's edits to its patch"
    )
    save_cmd.add_argument("name")
    save_cmd.add_argument(
        "-C",
        dest="worktree",
        type=Path,
        help="an llm-toolbox worktree to write the patch into, instead of the main tree",
    )
    save_cmd.add_argument(
        "--why",
        help="the reason for the edit; required for a new patch, and added as a "
        "new layer to an existing one",
    )
    save_cmd.add_argument(
        "--replace-why",
        action="store_true",
        help="with --why: drop the earlier reasons, for an edit that supersedes them",
    )
    apply_cmd = commands.add_parser(
        "apply", help="put patches on their installed skills"
    )
    apply_cmd.add_argument("names", nargs="*", metavar="NAME")
    args = parser.parse_args(argv)
    if args.command == "save" and args.replace_why and not args.why:
        save_cmd.error("--replace-why needs --why")
    try:
        if args.command == "save":
            patches = args.worktree and worktree_patches(args.worktree, args.name)
            print(save(args.name, args.why, args.replace_why, patches))
            return 0
        return apply(args.names)
    except PatchError as e:
        print(f"skill-patch: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
