#!/usr/bin/env python3
"""Replace old text with new in files, all or nothing, from blocks on stdin.

  apply-edits <<'EOF'
  --- src/app.py
  <<<<<<<
  old text, exactly as in the file, any number of lines
  =======
  new text (leave empty to delete the old text's lines)
  >>>>>>>
  --- README.md
  <<<<<<<
  ...
  EOF

Each `--- PATH` (relative to the current directory) starts a file's blocks; a file
takes any number, applied in order, each to the text the ones before it left. Every
old text must occur exactly once. If any block misses, nothing is written, and the
block is named with the closest text in the file shown as a diff.

Exit status: 0 applied, 1 a block didn't apply (nothing written), 2 usage error.
"""

import difflib
import os
import sys
import tempfile
from dataclasses import dataclass, field
from pathlib import Path

USAGE = 2
MISSED = 1
OPEN, DIVIDER, CLOSE = "<<<<<<<", "=======", ">>>>>>>"


class UsageError(Exception):
    pass


@dataclass
class Block:
    number: int
    old: str
    new: str


@dataclass
class FileEdits:
    path: Path
    blocks: list[Block] = field(default_factory=list)


def parse(text: str) -> list[FileEdits]:
    """The files and their blocks, in order. Raises UsageError."""
    files: list[FileEdits] = []
    lines = iter(enumerate(text.splitlines(), 1))
    for number, line in lines:
        if line.startswith("--- "):
            files.append(FileEdits(Path(line[4:].strip())))
        elif line == OPEN:
            if not files:
                raise UsageError(f"line {number}: a block before any '--- PATH' line")
            current = files[-1]
            old = _until(lines, DIVIDER, number)
            new = _until(lines, CLOSE, number)
            if not old.strip():
                raise UsageError(f"line {number}: a block with no old text")
            current.blocks.append(Block(len(current.blocks) + 1, old, new))
        elif line.strip():
            raise UsageError(
                f"line {number}: expected '--- PATH' or {OPEN}, got {line!r}"
            )
    if not any(f.blocks for f in files):
        raise UsageError("no blocks on stdin")
    return files


def _until(lines: "iter[tuple[int, str]]", end: str, start: int) -> str:
    """The lines up to the `end` marker, joined. Raises UsageError if it never comes."""
    taken: list[str] = []
    for _, line in lines:
        if line == end:
            return "\n".join(taken)
        if line in (OPEN, DIVIDER, CLOSE):
            break
        taken.append(line)
    raise UsageError(f"line {start}: block has no {end} line where expected")


def applied(edits: FileEdits, text: str) -> tuple[str, list[str]]:
    """The file's text with its blocks applied, and what went wrong with any that missed."""
    problems = []
    for block in edits.blocks:
        count = text.count(block.old)
        name = (
            f"{edits.path} block {block.number} ({block.old.splitlines()[0].strip()!r})"
        )
        if count == 1:
            text = replaced(text, block)
        elif count == 0:
            problems.append(f"{name}: old text not found.\n{closest(block.old, text)}")
        else:
            at = ", ".join(str(n) for n in line_numbers(text, block.old))
            problems.append(f"{name}: found {count} times, at lines {at}; add context.")
    return text, problems


def replaced(text: str, block: Block) -> str:
    """The text with the block's old text swapped for its new. Deleting whole lines
    takes the line break after them too."""
    at = text.index(block.old)
    end = at + len(block.old)
    if (
        not block.new
        and text[end : end + 1] == "\n"
        and (at == 0 or text[at - 1] == "\n")
    ):
        end += 1
    return text[:at] + block.new + text[end:]


def line_numbers(text: str, part: str) -> list[int]:
    numbers, start = [], 0
    while (index := text.find(part, start)) >= 0:
        numbers.append(text.count("\n", 0, index) + 1)
        start = index + len(part)
    return numbers


def closest(old: str, text: str) -> str:
    """The run of the file's lines most like `old`, as a diff from it."""
    wanted = old.splitlines()
    lines = text.splitlines()
    size = min(len(wanted), len(lines))
    if size == 0:
        return "  (the file is empty)"
    best, best_at = 0.0, 0
    for at in range(len(lines) - size + 1):
        window = "\n".join(lines[at : at + size])
        ratio = difflib.SequenceMatcher(None, old, window).ratio()
        if ratio > best:
            best, best_at = ratio, at
    found = lines[best_at : best_at + size]
    diff = difflib.unified_diff(
        wanted, found, "old text", "file", lineterm="", n=len(wanted)
    )
    shown = "\n".join(f"  {line}" for line in list(diff)[2:])
    return f"  closest is lines {best_at + 1}-{best_at + size} ({best:.0%} alike):\n{shown}"


def write(path: Path, text: str) -> None:
    """Replace the file's contents in one step, keeping its permissions."""
    mode = path.stat().st_mode
    fd, temp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(temp, mode)
    os.replace(temp, path)


def main() -> int:
    if len(sys.argv) > 1:
        print(
            __doc__, file=sys.stdout if sys.argv[1] in ("-h", "--help") else sys.stderr
        )
        return 0 if sys.argv[1] in ("-h", "--help") else USAGE
    try:
        files = parse(sys.stdin.read())
        for edits in files:
            if not edits.path.is_file():
                raise UsageError(f"no such file: {edits.path}")
    except UsageError as e:
        print(f"apply-edits: {e}", file=sys.stderr)
        return USAGE
    results, problems = [], []
    for edits in files:
        text, missed = applied(edits, edits.path.read_text())
        results.append((edits, text))
        problems += missed
    if problems:
        print("\n".join(problems) + "\nNothing was written.", file=sys.stderr)
        return MISSED
    for edits, text in results:
        write(edits.path, text)
        count = len(edits.blocks)
        print(f"{edits.path}: {count} edit{'' if count == 1 else 's'}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
