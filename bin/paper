#!/usr/bin/env -S uv run --quiet --script
# /// script
# dependencies = ["requests"]
# ///
"""Fetch a paper's metadata, citations or full text from Semantic Scholar and arXiv.

    paper meta ID...
    paper cites ID [--limit N]
    paper search QUERY... [--limit N]
    paper text ID
    paper outline ID
    paper grep ID PATTERN [-C N] [-i]

meta prints one short block per paper: title, year and venue, authors (with
affiliations when Semantic Scholar has them), citation count, its arXiv, DOI
and Semantic Scholar ids, and, for an arXiv paper, its latest version with
the dates of its first and latest versions (one arXiv API request per call).
cites lists papers citing ID (default 20), search the top matches for a
keyword query (default 10), each with year, title, venue, first three authors
and ids. text downloads the PDF, extracts it with `pdftotext -layout` and
prints the path of the .txt file. A whole paper runs to 10-20k tokens, so
start with outline: its section headings with line numbers, to read just the
sections you need with an offset and limit. grep prints the lines matching a
regex, with their line numbers and 2 lines of context (-C N to change, -i to
ignore case), for finding one number or claim. Both fetch the text first, like
text. outline spots numbered headings ("3 Method", "4.2 Results", "A
Appendix") and the usual section names; when a layout defeats it, grep for a
heading instead.

ID is an arXiv id (2404.00806, version suffix optional), an arxiv.org abs or
pdf URL, a DOI (10.1145/... bare or as a doi.org URL), or a 40-character
Semantic Scholar paperId. text takes arXiv ids and URLs, DOIs or a direct PDF
URL: an arXiv DOI (10.48550/arXiv....) fetches from arXiv, and any other DOI
fetches the open-access PDF OpenAlex lists, if it lists one. For a paper with
none of these (PMLR, OpenReview), find its paperId with search.

Every answer is cached in $PAPER_CACHE (default
/home/carver/code/claudedev/cache/paper): Semantic Scholar responses as JSON,
OpenAlex responses likewise in openalex/, arXiv versions and dates for a day
(new versions appear), PDFs with their text. Delete the s2 folder there to
refetch Semantic Scholar answers (metadata, citations, searches), or a
paper's files in pdf/ to fetch its text anew. If arXiv can't be reached, meta
prints the rest and warns.

Semantic Scholar answers more requests, and 429s less, with an API key. paper
sends one when $S2_API_KEY is set, else when the file
/home/carver/code/claudedev/.semantic-scholar/api-key holds one; it goes only to
Semantic Scholar, never to arXiv or a PDF host. Without a key, requests go
anonymous.

Requests are paced across every paper process that shares the cache, so
agents running paper in parallel stay under the limits: Semantic Scholar's at
least 1.1 seconds apart (a key allows about one a second), OpenAlex's at least
0.15 seconds, the arXiv API's at least 3 seconds apart. Each waits its turn on
a lock file in the cache. PDF downloads aren't paced.

Rate limits (HTTP 429, including Semantic Scholar's JSON error object), 5xx
and timeouts are retried with exponential backoff, honouring Retry-After: up
to 6 attempts and 2 minutes of waiting. Don't sleep and retry yourself.

When Semantic Scholar still fails after those retries, meta, search and cites
answer from OpenAlex instead, for arXiv ids and DOIs (a Semantic Scholar
paperId has no OpenAlex form), and later lookups in the same run go straight
to OpenAlex. A `source:` line in the output says so: OpenAlex counts and
lists far fewer citations than Semantic Scholar for arXiv papers, so rerun
later for Semantic Scholar's numbers, and an empty OpenAlex citer list doesn't
show that nothing cites the paper. OpenAlex requests carry
mailto=robocarver@worldofmail.com, and an API key when $OPENALEX_API_KEY is
set, else when /home/carver/code/claudedev/.openalex/api-key holds one; it
goes only to OpenAlex. Without a key, every request from this network shares
one small daily budget. A key OpenAlex refuses (not yet activated, or
invalid) is dropped, with a warning. OpenAlex lists at most 200 papers per
request, so --limit above 200 gets 200.

Exit status: 0 success, 1 not found (or the URL is not a PDF pdftotext can
read, or a DOI has no open-access PDF; search with no hits exits 1, and so
do grep with no matching line and outline with no heading; cites with no
citing papers says so and exits 0), 2 usage error, 3 the remote refused or
failed the request after retries, or sent an unexpected answer, including
Semantic Scholar failing while OpenAlex fails too or has no record: try
again later.

Examples:
    paper meta 2404.00806 10.1145/3442188.3445922
    paper cites https://arxiv.org/abs/1706.03762 --limit 50
    paper search detect collusion multi-agent games --limit 5
    less "$(paper text 2404.00806)"
    paper text https://doi.org/10.1093/joclec/nhy016
    paper outline 2404.00806
    paper grep 2404.00806 'collusion rate|markup' -C 1
"""

import argparse
import fcntl
import hashlib
import json
import os
import random
import re
import subprocess
import sys
import time
from collections.abc import Callable, Iterator
from contextlib import contextmanager
from dataclasses import asdict, dataclass, field
from functools import cached_property
from pathlib import Path
from typing import Any
from urllib.parse import quote, unquote, urlparse, urlsplit
from xml.etree import ElementTree

OK, NOT_FOUND, USAGE, REMOTE = 0, 1, 2, 3
S2 = "https://api.semanticscholar.org/graph/v1"
DEFAULT_CACHE = "/home/carver/code/claudedev/cache/paper"
KEY_ENV = "S2_API_KEY"
KEY_FILE = Path("/home/carver/code/claudedev/.semantic-scholar/api-key")
ARXIV_API = "https://export.arxiv.org/api/query"
ARXIV_TTL = 24 * 3600  # seconds; arXiv dates are refetched after a day
ATOM = "{http://www.w3.org/2005/Atom}"
TIMEOUT = 30
ATTEMPTS = 6
BUDGET = 120  # seconds of sleeping between attempts, at most
PACED = {
    "Semantic Scholar": 1.1,
    "arXiv": 3.0,
    "OpenAlex": 0.15,
}  # seconds between requests
OPENALEX = "https://api.openalex.org"
OPENALEX_MAILTO = "robocarver@worldofmail.com"
OPENALEX_KEY_ENV = "OPENALEX_API_KEY"
OPENALEX_KEY_FILE = Path("/home/carver/code/claudedev/.openalex/api-key")
OPENALEX_PAGE_MAX = 200  # OpenAlex refuses a larger per_page
META_FIELDS = (
    "title,year,venue,citationCount,externalIds,authors.name,authors.affiliations"
)
CITES_FIELDS = "title,year,venue,externalIds,authors"
SEARCH_FIELDS = CITES_FIELDS + ",citationCount"

ARXIV = re.compile(r"\d{4}\.\d{4,5}(?:v\d+)?")
ARXIV_VERSION = re.compile(r"v\d+$")
# A new-style (2404.00806) or old-style (quant-ph/9801069) arXiv id, without a version.
ARXIV_ANY = r"\d{4}\.\d{4,5}|[a-z][a-z-]*(?:\.[A-Z]{2})?/\d{7}"
ARXIV_ABS = re.compile(rf"https?://arxiv\.org/abs/({ARXIV_ANY})v(\d+)")
ARXIV_ID = re.compile(rf"(?:{ARXIV_ANY})(?:v\d+)?")
DOI = re.compile(r"10\.\d{4,9}/\S+")
S2_HEX = re.compile(r"[0-9a-f]{40}")
ARXIV_HOSTS = {"arxiv.org", "www.arxiv.org"}
DOI_HOSTS = {"doi.org", "dx.doi.org", "www.doi.org"}

Paper = dict[
    str, Any
]  # a Semantic Scholar paper object, or an OpenAlex work in its shape


class UsageError(Exception):
    pass


class NotFound(Exception):
    pass


class RemoteError(Exception):
    """The remote refused or failed the request, after retries."""


class ExtractFailed(Exception):
    """The download was not a PDF, or pdftotext could not read it."""


class TransportError(Exception):
    """The request never got an HTTP answer: a timeout or a dropped connection."""


class GaveUp(RemoteError):
    """A service still failed (throttled, 5xx, timeout) after every retry."""


class Retryable(Exception):
    """One attempt failed in a way worth retrying: a 429, a 5xx or a timeout."""

    def __init__(self, problem: str, retry_after: float | None = None):
        super().__init__(problem)
        self.retry_after = retry_after


# ID parsing


@dataclass(frozen=True)
class PaperId:
    """A parsed ID. Each kind knows its Semantic Scholar path and its PDF."""

    value: str

    def s2_path(self) -> str:
        return "/paper/" + quote(self.s2_id(), safe=":/")

    def s2_id(self) -> str:
        return self.value

    def openalex_path(self) -> str | None:
        """The OpenAlex work path for this id, or None when OpenAlex can't take it."""
        return None

    def pdf_source(self) -> tuple[str | None, str]:
        """The PDF's URL and the cache file stem for it. The URL is None when it has to
        be looked up (a DOI's open-access PDF, through OpenAlex)."""
        raise UsageError(
            f"needs an arXiv id or URL, a DOI, or a PDF URL: {self.value!r}"
        )


class ArxivId(PaperId):
    def s2_id(self) -> str:
        return "arXiv:" + ARXIV_VERSION.sub("", self.value)

    def openalex_path(self) -> str | None:
        return "/works/doi:10.48550/arXiv." + ARXIV_VERSION.sub("", self.value)

    def pdf_source(self) -> tuple[str, str]:
        return f"https://arxiv.org/pdf/{self.value}", "arxiv-" + self.value


class Doi(PaperId):
    def s2_id(self) -> str:
        return "DOI:" + self.value

    def openalex_path(self) -> str | None:
        return "/works/doi:" + quote(self.value, safe=":/")

    def pdf_source(self) -> tuple[str | None, str]:
        m = ARXIV_DOI.fullmatch(self.value)
        if m and ARXIV.fullmatch(m.group(1)):
            return ArxivId(m.group(1)).pdf_source()
        doi = self.value.lower()  # DOIs are case-insensitive
        return None, cache_stem("doi", doi, doi)


class S2PaperId(PaperId):
    pass


class PdfUrl(PaperId):
    def s2_path(self) -> str:
        raise UsageError(f"a PDF URL works only with `paper text`: {self.value!r}")

    def pdf_source(self) -> tuple[str, str]:
        name = Path(urlparse(self.value).path).stem
        return self.value, cache_stem("url", self.value, name)


def cache_stem(prefix: str, key: str, name: str) -> str:
    """A flat, safe file stem for a PDF's cache: the prefix, a hash of `key`, and
    `name` with anything unsafe in a file name replaced."""
    safe = re.sub(r"[^A-Za-z0-9._-]+", "_", name)[:60]
    digest = hashlib.sha256(key.encode()).hexdigest()[:12]
    return f"{prefix}-{digest}-{safe}"


def parse_id(text: str) -> PaperId:
    """An arXiv id, DOI, S2 paperId or PDF URL, from any form of ID we take."""
    text = text.strip()
    if ARXIV.fullmatch(text):
        return ArxivId(text)
    if DOI.fullmatch(text):
        return Doi(text)
    if S2_HEX.fullmatch(text.lower()):
        return S2PaperId(text.lower())
    url = urlsplit(text)
    if url.scheme in ("http", "https") and url.hostname:
        if url.hostname in ARXIV_HOSTS:
            parts = url.path.strip("/").split("/", 1)
            if len(parts) == 2 and parts[0] in ("abs", "pdf"):
                candidate = parts[1].removesuffix(".pdf")
                if ARXIV.fullmatch(candidate):
                    return ArxivId(candidate)
            raise UsageError(f"not an arXiv paper URL: {text!r}")
        if url.hostname in DOI_HOSTS:
            candidate = unquote(url.path.lstrip("/"))
            if DOI.fullmatch(candidate):
                return Doi(candidate)
            raise UsageError(f"not a DOI URL: {text!r}")
        return PdfUrl(text)
    raise UsageError(
        f"not a paper id: {text!r} (arXiv id or URL, DOI, S2 paperId, or a PDF URL)"
    )


# HTTP client


@dataclass
class Response:
    status: int
    headers: dict[str, str]
    content: bytes


Fetch = Callable[..., Response]  # (method, url, *, params=None, headers=None)
Extract = Callable[[Path, Path], None]  # (pdf, txt) -> None


def requests_fetch(
    method: str,
    url: str,
    *,
    params: dict[str, Any] | None = None,
    headers: dict[str, str] | None = None,
) -> Response:
    import requests

    try:
        r = requests.request(
            method, url, params=params, headers=headers, timeout=TIMEOUT
        )
    except (requests.Timeout, requests.ConnectionError) as e:
        raise TransportError(type(e).__name__) from e
    return Response(r.status_code, dict(r.headers), r.content)


@dataclass(frozen=True)
class ApiKey:
    """An API key, and where it came from for error messages."""

    value: str = field(repr=False)
    source: str


def read_key(env: str, path: Path) -> ApiKey | None:
    """The key from $env, else from the file at `path`, else None."""
    value = os.environ.get(env, "").strip()
    if value:
        return ApiKey(value, "$" + env)
    try:
        value = path.read_text(encoding="utf-8").strip()
    except FileNotFoundError:
        return None
    except UnicodeDecodeError:
        raise UsageError(f"the API key file {path} is not UTF-8 text") from None
    except OSError as e:
        raise UsageError(f"can't read the API key file {path}: {e.strerror}") from None
    return ApiKey(value, str(path)) if value else None


def find_api_key() -> ApiKey | None:
    """The Semantic Scholar key from $S2_API_KEY, else from KEY_FILE, else None."""
    return read_key(KEY_ENV, KEY_FILE)


def find_openalex_key() -> ApiKey | None:
    """The OpenAlex key from $OPENALEX_API_KEY, else from OPENALEX_KEY_FILE, else None."""
    return read_key(OPENALEX_KEY_ENV, OPENALEX_KEY_FILE)


def pdftotext(pdf: Path, txt: Path) -> None:
    try:
        subprocess.run(
            ["pdftotext", "-layout", str(pdf), str(txt)],
            check=True,
            capture_output=True,
            text=True,
        )
    except FileNotFoundError as e:
        raise ExtractFailed(
            "pdftotext is not installed (apt install poppler-utils)"
        ) from e
    except subprocess.CalledProcessError as e:
        raise ExtractFailed(f"pdftotext failed: {e.stderr.strip()}") from e


@dataclass(frozen=True)
class Pacer:
    """Keeps requests to one service at least `interval` seconds apart, across every
    process that shares `path`. The file holds the last request's time; a caller takes
    its lock and holds it while waiting, so callers queue up."""

    path: Path
    interval: float
    clock: Callable[[], float] = time.time
    sleep: Callable[[float], None] = time.sleep

    def wait(self) -> float:
        """Waits for this request's turn and returns the time it recorded for it."""
        self.path.parent.mkdir(parents=True, exist_ok=True)
        with self.path.open("a+") as f:
            fcntl.flock(f, fcntl.LOCK_EX)  # released when the file closes
            f.seek(0)
            try:
                last = float(f.read())
            except ValueError:
                last = 0.0
            # At most one interval, so a clock set back can't stall every process.
            delay = min(last + self.interval - self.clock(), self.interval)
            if delay > 0:
                self.sleep(delay)
            now = self.clock()
            f.seek(0)
            f.truncate()
            f.write(repr(now))
        return now


class Client:
    """Fetches, sleeps between retries and extracts PDFs, all swappable in tests."""

    def __init__(
        self,
        fetch: Fetch,
        sleep: Callable[[float], None],
        extract: Extract,
        pace: Callable[[str], None] | None = None,
    ):
        self.fetch = fetch
        self.sleep = sleep
        self.extract = extract
        self.cache = Path(os.environ.get("PAPER_CACHE") or DEFAULT_CACHE)
        self.pace = pace or self.wait_turn
        # Once Semantic Scholar has given up, later cache misses in this run skip it.
        self.s2_gave_up: GaveUp | None = None
        self.openalex_key_refused = False
        self.warned_fallback = False

    def wait_turn(self, service: str) -> None:
        """Waits until `service`'s interval since its last request, by any process, has passed."""
        name = ".pace-" + service.lower().replace(" ", "-")
        Pacer(self.cache / name, PACED[service]).wait()

    @cached_property
    def api_key(self) -> ApiKey | None:
        """Looked up on first use, so a bad key file can't stop a PDF download."""
        return find_api_key()

    def s2(
        self, path: str, params: dict[str, Any], require: str | None = None
    ) -> dict[str, Any]:
        """A Semantic Scholar response's JSON, from the cache when it's there.

        The answer must be an object, holding the key `require` if given."""
        url = S2 + path
        cached = self.cache_file("s2", url, params)
        if cached.exists():
            return json.loads(cached.read_text(encoding="utf-8"))
        if self.s2_gave_up:
            raise self.s2_gave_up
        headers = {"x-api-key": self.api_key.value} if self.api_key else None
        try:
            response = self.request(
                "Semantic Scholar", "GET", url, params=params, headers=headers
            )
        except GaveUp as e:
            self.s2_gave_up = e
            raise
        if response.status == 404:
            raise NotFound(error_text(response))
        if response.status != 200:
            problem = (
                f"Semantic Scholar: HTTP {response.status}: {error_text(response)}"
            )
            if response.status in (401, 403) and self.api_key:
                problem += f" (the API key from {self.api_key.source} may be invalid)"
            raise RemoteError(problem)
        data = json_object("Semantic Scholar", response, require)
        write_atomic(cached, json.dumps(data).encode())
        return data

    def cache_file(self, folder: str, url: str, params: dict[str, Any]) -> Path:
        """Where the answer to `url` with `params` is cached, named by a hash of both."""
        key = json.dumps([url, params], sort_keys=True)
        return (
            self.cache / folder / (hashlib.sha256(key.encode()).hexdigest() + ".json")
        )

    @cached_property
    def openalex_key(self) -> ApiKey | None:
        return find_openalex_key()

    def openalex(self, path: str, params: dict[str, Any]) -> dict[str, Any]:
        """An OpenAlex response's JSON, from the cache when it's there. The cache key
        leaves out the mailto and the API key."""
        url = OPENALEX + path
        cached = self.cache_file("openalex", url, params)
        if cached.exists():
            return json.loads(cached.read_text(encoding="utf-8"))
        response = self.openalex_request(url, params)
        if response.status == 404:
            raise NotFound(url)
        if response.status != 200:
            problem = error_text(response)
            if self.openalex_key:
                problem = problem.replace(self.openalex_key.value, "<api key>")
            raise RemoteError(f"OpenAlex: HTTP {response.status}: {problem}")
        data = json_object("OpenAlex", response)
        write_atomic(cached, json.dumps(data).encode())
        return data

    def fallback(
        self, gave_up: GaveUp, path: str, params: dict[str, Any]
    ) -> dict[str, Any]:
        """OpenAlex's answer, after Semantic Scholar gave up. Says so on stderr once per
        run. OpenAlex failing too, or not knowing the paper, is a RemoteError naming
        both."""
        if not self.warned_fallback:
            print(f"paper: {gave_up}; answering from OpenAlex", file=sys.stderr)
            self.warned_fallback = True
        try:
            return self.openalex(path, params)
        except NotFound:
            raise RemoteError(
                f"{gave_up}; OpenAlex has no record of it either"
            ) from None
        except RemoteError as e:
            raise RemoteError(f"{gave_up}; OpenAlex failed too: {e}") from None

    def openalex_request(self, url: str, params: dict[str, Any]) -> Response:
        """One OpenAlex request with mailto and the key. A key OpenAlex refuses (not yet
        activated, or invalid) is dropped, with a warning, and the request sent again
        without it."""
        sent = dict(params, mailto=OPENALEX_MAILTO)
        key = None if self.openalex_key_refused else self.openalex_key
        if key:
            sent["api_key"] = key.value
        response = self.request("OpenAlex", "GET", url, params=sent)
        if key and response.status in (401, 403):
            why = (
                "is not activated yet"
                if error_code(response) == "key_not_activated"
                else f"was refused (HTTP {response.status}; it may be invalid)"
            )
            print(
                f"paper: the OpenAlex key from {key.source} {why}; asking without it",
                file=sys.stderr,
            )
            self.openalex_key_refused = True
            keyless = {k: v for k, v in sent.items() if k != "api_key"}
            response = self.request("OpenAlex", "GET", url, params=keyless)
        return response

    def arxiv_dates(self, ids: list[str]) -> dict[str, "ArxivDates"]:
        """Version and dates per arXiv id (given without a version), from the cache when
        under a day old, else from one arXiv API request for all the rest. An id arXiv
        doesn't return is left out and not cached: the API sometimes answers an empty
        feed under load."""
        found: dict[str, ArxivDates] = {}
        missing = []
        for aid in dict.fromkeys(ids):
            cached = self.cache / "arxiv" / arxiv_cache_name(aid)
            if cached.exists() and time.time() - cached.stat().st_mtime < ARXIV_TTL:
                found[aid] = ArxivDates(
                    **json.loads(cached.read_text(encoding="utf-8"))
                )
            else:
                missing.append(aid)
        if not missing:
            return found
        response = self.request(
            "arXiv",
            "GET",
            ARXIV_API,
            params={"id_list": ",".join(missing), "max_results": len(missing)},
        )
        if response.status != 200:
            raise RemoteError(f"arXiv: HTTP {response.status}: {error_text(response)}")
        fetched = parse_arxiv_feed(response.content)
        for aid in missing:
            if aid in fetched:
                body = json.dumps(asdict(fetched[aid])).encode()
                write_atomic(self.cache / "arxiv" / arxiv_cache_name(aid), body)
                found[aid] = fetched[aid]
        return found

    def request(
        self,
        service: str,
        method: str,
        url: str,
        params: dict[str, Any] | None = None,
        headers: dict[str, str] | None = None,
    ) -> Response:
        """The response, retrying 429s, 5xx and timeouts with backoff."""
        slept = 0.0
        for attempt in range(1, ATTEMPTS + 1):
            if service in PACED:
                self.pace(service)
            try:
                return self.request_once(method, url, params, headers)
            except Retryable as e:
                failure = e
            if attempt == ATTEMPTS or slept >= BUDGET:
                break
            delay = min(backoff(attempt, failure.retry_after), BUDGET - slept)
            self.sleep(delay)
            slept += delay
        raise GaveUp(
            f"{service} failed, gave up after {attempt} attempts"
            f" ({slept:.0f}s of backoff): {failure}"
        )

    def request_once(
        self,
        method: str,
        url: str,
        params: dict[str, Any] | None,
        headers: dict[str, str] | None,
    ) -> Response:
        """The response, or Retryable for a 429, a 5xx or a timeout.

        Semantic Scholar's error object, {"message": ..., "code": "429"},
        counts as that status whatever the HTTP status says."""
        try:
            response = self.fetch(method, url, params=params, headers=headers)
        except TransportError as e:
            raise Retryable(str(e) or "timeout") from e
        code = s2_error_code(response) or response.status
        if code == 429 or code >= 500:
            raise Retryable(
                f"HTTP {code}: {error_text(response)}",
                parse_retry_after(response.headers),
            )
        return Response(code, response.headers, response.content)


def backoff(attempt: int, retry_after: float | None) -> float:
    """Seconds to wait before the next attempt: Retry-After, else exponential."""
    if retry_after is not None:
        return retry_after
    return 2**attempt * random.uniform(1, 1.5)


def s2_error_code(response: Response) -> int | None:
    """The status in a Semantic Scholar error object, or None if it isn't one."""
    try:
        data = json.loads(response.content)
    except ValueError:
        return None
    if (
        isinstance(data, dict)
        and {"message", "code"} <= set(data)
        and str(data["code"]).isdigit()
    ):
        return int(data["code"])
    return None


def json_object(
    service: str, response: Response, require: str | None = None
) -> dict[str, Any]:
    """The response's JSON object, holding the key `require` if given."""
    try:
        data = json.loads(response.content)
    except ValueError:
        data = None
    if not isinstance(data, dict) or (require and not data.get(require)):
        raise RemoteError(
            f"{service} sent an unexpected answer: "
            + response.content[:200].decode(errors="replace")
        )
    return data


def error_code(response: Response) -> str | None:
    """The `code` field of a JSON error body, such as OpenAlex's "key_not_activated"."""
    try:
        data = json.loads(response.content)
    except ValueError:
        return None
    return str(data.get("code")) if isinstance(data, dict) and "code" in data else None


def parse_retry_after(headers: dict[str, str]) -> float | None:
    for name, value in headers.items():
        if name.lower() == "retry-after":
            try:
                return max(0.0, float(value))
            except ValueError:
                return None
    return None


def error_text(response: Response) -> str:
    try:
        data = json.loads(response.content)
    except ValueError:
        return response.content[:200].decode(errors="replace")
    if isinstance(data, dict):
        return str(data.get("message") or data.get("error") or data)
    return str(data)[:200]


@contextmanager
def replaced_on_success(path: Path) -> Iterator[Path]:
    """A temporary path to write; it replaces `path` if the block succeeds."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    yield tmp
    tmp.replace(path)


def write_atomic(path: Path, content: bytes) -> None:
    with replaced_on_success(path) as tmp:
        tmp.write_bytes(content)


# arXiv


@dataclass(frozen=True)
class ArxivDates:
    version: int
    submitted: str  # first version, YYYY-MM-DD
    updated: str  # latest version


def parse_arxiv_feed(content: bytes) -> dict[str, ArxivDates]:
    """Each entry of an arXiv API answer, by id without its version suffix."""
    try:
        root = ElementTree.fromstring(content)
    except ElementTree.ParseError as e:
        raise RemoteError(f"arXiv sent an unexpected answer: {e}") from e
    found = {}
    for entry in root.iter(ATOM + "entry"):
        m = ARXIV_ABS.fullmatch((entry.findtext(ATOM + "id") or "").strip())
        if m:
            found[m.group(1)] = ArxivDates(
                version=int(m.group(2)),
                submitted=(entry.findtext(ATOM + "published") or "")[:10],
                updated=(entry.findtext(ATOM + "updated") or "")[:10],
            )
    return found


def arxiv_id_of(paper: Paper) -> str | None:
    """The paper's arXiv id from Semantic Scholar, without a version."""
    value = (paper.get("externalIds") or {}).get("ArXiv") or ""
    return ARXIV_VERSION.sub("", value) if ARXIV_ID.fullmatch(value) else None


def arxiv_cache_name(aid: str) -> str:
    """A flat file name: old-style ids hold a slash."""
    return aid.replace("/", "_") + ".json"


# OpenAlex

ARXIV_DOI = re.compile(r"10\.48550/arxiv\.(.+)", re.IGNORECASE)
ARXIV_LANDING = re.compile(rf"https?://(?:www\.)?arxiv\.org/abs/({ARXIV_ANY})(?:v\d+)?")


def openalex_paper(work: dict[str, Any]) -> Paper:
    """An OpenAlex work in the shape the formatting functions take."""
    doi = (work.get("doi") or "").removeprefix("https://doi.org/")
    external = {}
    aid = openalex_arxiv_id(work, doi)
    if aid:
        external["ArXiv"] = aid
    if doi:
        external["DOI"] = doi
    source = (work.get("primary_location") or {}).get("source") or {}
    return {
        "openalexId": str(work.get("id") or "").rsplit("/", 1)[-1],
        "title": work.get("display_name"),
        "year": work.get("publication_year"),
        "venue": source.get("display_name"),
        "citationCount": work.get("cited_by_count"),
        "externalIds": external,
        "authors": [
            {
                "name": (a.get("author") or {}).get("display_name"),
                "affiliations": [
                    i.get("display_name") for i in a.get("institutions") or []
                ],
            }
            for a in work.get("authorships") or []
        ],
        "source": "OpenAlex",
    }


def openalex_arxiv_id(work: dict[str, Any], doi: str) -> str | None:
    """The work's arXiv id, from its arXiv DOI or an arxiv.org landing page."""
    m = ARXIV_DOI.fullmatch(doi)
    if m and ARXIV_ID.fullmatch(m.group(1)):
        return m.group(1)
    locations = [work.get("primary_location"), work.get("best_oa_location")]
    for location in [*locations, *(work.get("locations") or [])]:
        m = ARXIV_LANDING.fullmatch((location or {}).get("landing_page_url") or "")
        if m:
            return m.group(1)
    return None


def from_openalex(client: Client, pid: PaperId, gave_up: GaveUp) -> Paper:
    """The paper from OpenAlex, after Semantic Scholar gave up on it."""
    path = pid.openalex_path()
    if path is None:
        raise gave_up
    return openalex_paper(client.fallback(gave_up, path, {}))


SOURCE_NOTE = (
    "source: OpenAlex, because Semantic Scholar gave up after its retries. OpenAlex"
    " counts and lists far fewer citations than Semantic Scholar for arXiv papers;"
    " rerun later for Semantic Scholar's."
)
SOURCE_LINE = "  " + SOURCE_NOTE


# Formatting


def ids_line(paper: Paper) -> str:
    ext = paper.get("externalIds") or {}
    parts = []
    if ext.get("ArXiv"):
        parts.append("arXiv:" + ext["ArXiv"])
    if ext.get("DOI"):
        parts.append("DOI:" + ext["DOI"])
    if paper.get("paperId"):
        parts.append("S2:" + paper["paperId"])
    elif paper.get("openalexId"):
        parts.append("OpenAlex:" + paper["openalexId"])
    return " ".join(parts)


def author_names(paper: Paper, limit: int | None = None) -> str:
    authors = paper.get("authors") or []
    shown = authors if limit is None else authors[:limit]
    names = []
    for author in shown:
        affs = author.get("affiliations") or []
        name = author.get("name")
        names.append(f"{name} ({'; '.join(affs)})" if affs else str(name))
    if len(authors) > len(shown):
        names.append(f"+{len(authors) - len(shown)} more")
    return ", ".join(names)


def meta_block(paper: Paper, dates: ArxivDates | None = None) -> str:
    lines = [paper.get("title") or "(untitled)"]
    if paper.get("source") == "OpenAlex":
        lines.append(SOURCE_LINE)
    where = " · ".join(str(x) for x in (paper.get("year"), paper.get("venue")) if x)
    if where:
        lines.append("  " + where)
    if paper.get("authors"):
        lines.append("  authors: " + author_names(paper, limit=10))
    lines.append(f"  citations: {paper.get('citationCount')}")
    lines.append("  ids: " + ids_line(paper))
    if dates:
        lines.append(arxiv_line(dates))
    return "\n".join(lines)


def arxiv_line(dates: ArxivDates) -> str:
    return f"  arXiv: v{dates.version}, submitted {dates.submitted}, updated {dates.updated}"


def list_block(paper: Paper, show_citation_count: bool = False) -> str:
    """A shorter block, for one paper among many."""
    head = " · ".join(
        str(x) for x in (paper.get("year"), paper.get("title"), paper.get("venue")) if x
    )
    lines = [head]
    if paper.get("authors"):
        lines.append("  authors: " + author_names(paper, limit=3))
    tail = ids_line(paper)
    if show_citation_count:
        tail = f"{tail} · citations: {paper.get('citationCount')}"
    lines.append("  ids: " + tail)
    return "\n".join(lines)


# Commands


def meta_paper(client: Client, pid: PaperId) -> Paper:
    """The paper's metadata from Semantic Scholar, or from OpenAlex once it gives up."""
    try:
        return client.s2(pid.s2_path(), {"fields": META_FIELDS}, require="paperId")
    except GaveUp as e:
        return from_openalex(client, pid, e)


def cmd_meta(client: Client, args: argparse.Namespace) -> int:
    pids = [parse_id(text) for text in args.ids]
    for pid in pids:
        pid.s2_path()  # a PDF URL is refused here, before any request
    code = OK
    papers = []
    failure = None
    for text, pid in zip(args.ids, pids):
        try:
            papers.append(meta_paper(client, pid))
        except NotFound:
            print(f"paper: not found: {text}", file=sys.stderr)
            code = NOT_FOUND
        except RemoteError as e:
            failure = e  # print what was fetched first, then report it
            break
    with_ids = [(p, arxiv_id_of(p)) for p in papers]
    arxiv_ids = [aid for _, aid in with_ids if aid]
    dates: dict[str, ArxivDates] = {}
    if arxiv_ids:
        try:
            dates = client.arxiv_dates(arxiv_ids)
        except RemoteError as e:
            print(f"paper: arXiv dates unavailable: {e}", file=sys.stderr)
        else:
            for aid in arxiv_ids:
                if aid not in dates:
                    print(f"paper: arXiv has no entry for {aid}", file=sys.stderr)
    for p, aid in with_ids:
        print(meta_block(p, dates.get(aid) if aid else None))
    if failure:
        raise failure
    return code


def cmd_cites(client: Client, args: argparse.Namespace) -> int:
    pid = parse_id(args.id)
    path = pid.s2_path() + "/citations"
    try:
        data = client.s2(path, {"fields": CITES_FIELDS, "limit": args.limit})
    except NotFound:
        raise NotFound(args.id) from None
    except GaveUp as e:
        return openalex_cites(client, pid, args, e)
    citing = [
        row["citingPaper"]
        for row in data.get("data") or []
        if (row.get("citingPaper") or {}).get("paperId")
    ]
    if not citing:
        print(f"no papers cite {args.id}")
    for paper in citing:
        print(list_block(paper))
    return OK


def openalex_cites(
    client: Client, pid: PaperId, args: argparse.Namespace, gave_up: GaveUp
) -> int:
    """cites from OpenAlex, under a source note. An empty list isn't "no papers cite"."""
    work = from_openalex(client, pid, gave_up)
    data = client.fallback(
        gave_up,
        "/works",
        {
            "filter": "cites:" + work["openalexId"],
            "per_page": min(args.limit, OPENALEX_PAGE_MAX),
        },
    )
    print(SOURCE_NOTE)
    citing = [openalex_paper(w) for w in data.get("results") or []]
    if not citing:
        print(f"OpenAlex lists no papers citing {args.id}; that doesn't show none do")
    for paper in citing:
        print(list_block(paper))
    return OK


def cmd_search(client: Client, args: argparse.Namespace) -> int:
    query = " ".join(args.query)
    note = None
    try:
        data = client.s2(
            "/paper/search",
            {"query": query, "fields": SEARCH_FIELDS, "limit": args.limit},
        )
        papers = data.get("data") or []
    except GaveUp as e:
        found = client.fallback(
            e,
            "/works",
            {"search": query, "per_page": min(args.limit, OPENALEX_PAGE_MAX)},
        )
        papers = [openalex_paper(w) for w in found.get("results") or []]
        note = SOURCE_NOTE
    if not papers:
        where = " in OpenAlex" if note else ""
        print(f"paper: no papers match {query!r}{where}", file=sys.stderr)
        return NOT_FOUND
    if note:
        print(note)
    for paper in papers:
        print(list_block(paper, show_citation_count=True))
    return OK


def cached_text(client: Client, id_text: str, command: str) -> Path:
    """The paper's extracted text, downloaded and extracted first if not cached."""
    try:
        pid = parse_id(id_text)
        url, stem = pid.pdf_source()
    except UsageError as e:
        raise UsageError(f"`paper {command}` {e}") from e
    folder = client.cache / "pdf"
    pdf, txt = folder / (stem + ".pdf"), folder / (stem + ".txt")
    if not txt.exists():
        if url is None:
            url = open_access_pdf(client, pid)
        response = client.request("PDF download", "GET", url)
        if response.status == 404:
            raise NotFound(url)
        if response.status != 200:
            raise RemoteError(f"PDF download: HTTP {response.status} for {url}")
        if not response.content.startswith(b"%PDF"):
            raise ExtractFailed(f"not a PDF at {url}")
        write_atomic(pdf, response.content)
        with replaced_on_success(txt) as partial:
            client.extract(pdf, partial)
    return txt


def open_access_pdf(client: Client, pid: PaperId) -> str:
    """The URL of an open-access PDF of the paper, found through OpenAlex."""
    path = pid.openalex_path()
    assert path is not None  # only a DOI's pdf_source leaves the URL to look up
    try:
        work = client.openalex(path, {})
    except NotFound:
        raise NotFound(f"{pid.value} is not in OpenAlex") from None
    best = work.get("best_oa_location") or {}
    locations = work.get("locations") or []
    pdfs = [best.get("pdf_url"), *((loc or {}).get("pdf_url") for loc in locations)]
    for url in pdfs:
        if url:
            return url
    primary = work.get("primary_location") or {}
    pages = [best.get("landing_page_url"), primary.get("landing_page_url")]
    pages += [(loc or {}).get("landing_page_url") for loc in locations]
    landing = next((p for p in pages if p), None) or work.get("doi") or "none listed"
    raise NotFound(
        f"no open-access PDF for {pid.value} in OpenAlex; its landing page: {landing}"
    )


def cmd_text(client: Client, args: argparse.Namespace) -> int:
    print(cached_text(client, args.id, "text"))
    return OK


def text_lines(path: Path) -> list[str]:
    """The text's lines, split on newlines only: str.splitlines() also splits on the
    form feed pdftotext puts between pages, which would push line numbers off by one
    per page."""
    lines = path.read_text(errors="replace").split("\n")
    return lines[:-1] if lines and lines[-1] == "" else lines


# A section number (1-29, with up to two subsection levels) and its title, at a line's
# start or after a column gap. pdftotext often pads the space after the number, and a
# run of 3+ spaces ends the title. Larger numbers are table cells, not sections.
SECTION_PART = r"(?:[1-9]|[12]\d)"
NUMBERED_HEADING = re.compile(
    rf"(?:^|\s{{3,}})({SECTION_PART}(?:\.{SECTION_PART}){{0,2}}\.?"
    rf"|[A-H](?:\.{SECTION_PART}){{0,2}}\.?)\s+([A-Z](?:(?!\s{{3}}).)*)"
)
TITLE_WORDS = 12
NAMED_HEADINGS = {
    "abstract",
    "introduction",
    "background",
    "related work",
    "method",
    "methods",
    "methodology",
    "experiments",
    "experimental setup",
    "results",
    "discussion",
    "limitations",
    "conclusion",
    "conclusions",
    "references",
    "appendix",
    "acknowledgments",
    "acknowledgements",
}
HEADING_CHARS = 80


def heading_in(line: str) -> str | None:
    """The section heading on a line of `pdftotext -layout` output, or None. Both
    columns of a two-column layout count. A page's first line starts with a form feed."""
    line = line.replace("\f", "")
    for found in NUMBERED_HEADING.finditer(line):
        number, title = found.group(1), found.group(2).strip()
        if is_title(title, lettered=number[0].isalpha()):
            return f"{number} {title}"
    for chunk in re.split(r"\s{3,}", line.strip()):
        name = chunk.rstrip(":").lower()
        if name in NAMED_HEADINGS:
            return chunk
        appendix = re.fullmatch(r"appendix [a-z0-9]\S*(?: (.*))?", name)
        if appendix and (
            appendix.group(1) is None or is_title(chunk.split(None, 2)[2], False)
        ):
            return chunk
    return None


def is_title(text: str, lettered: bool) -> bool:
    """Whether the text after a section number reads like a heading: short, mostly
    letters, not ending mid-sentence (list items, addresses and hyphenated lines do).
    After a letter ("A Prompts") the first word needs 3+ characters, which rules out
    small-caps fragments such as "C ON V ERSE"."""
    words = text.split()
    visible = [c for c in text if not c.isspace()]
    letters = sum(c.isalpha() for c in visible)
    return (
        len(text) <= HEADING_CHARS
        and len(words) <= TITLE_WORDS
        and letters >= 3
        and letters >= 0.8 * len(visible)
        and not text.endswith((".", ",", ":", ";", "-", '"', "”", "’"))
        and not (lettered and len(words[0]) < 3)
    )


def cmd_outline(client: Client, args: argparse.Namespace) -> int:
    lines = text_lines(cached_text(client, args.id, "outline"))
    found = [(n, h) for n, line in enumerate(lines, 1) if (h := heading_in(line))]
    if not found:
        print(f"paper: no headings found in {args.id}; try paper grep", file=sys.stderr)
        return NOT_FOUND
    for n, heading in found:
        print(f"{n:>6}  {heading}")
    return OK


def cmd_grep(client: Client, args: argparse.Namespace) -> int:
    try:
        pattern = re.compile(args.pattern, re.IGNORECASE if args.ignore_case else 0)
    except re.error as e:
        raise UsageError(f"bad pattern {args.pattern!r}: {e}") from e
    lines = text_lines(cached_text(client, args.id, "grep"))
    hits = [i for i, line in enumerate(lines) if pattern.search(line)]
    if not hits:
        return NOT_FOUND
    # Each hit with its context, merged where they touch or overlap, like grep.
    blocks: list[list[int]] = []
    for i in hits:
        start, end = max(0, i - args.context), min(len(lines), i + args.context + 1)
        if blocks and start <= blocks[-1][1]:
            blocks[-1][1] = max(blocks[-1][1], end)
        else:
            blocks.append([start, end])
    hit_set = set(hits)
    for n, (start, end) in enumerate(blocks):
        if n and args.context:
            print("--")
        for i in range(start, end):
            print(f"{i + 1}{':' if i in hit_set else '-'}{lines[i]}")
    return OK


def context_lines(text: str) -> int:
    value = int(text)
    if value < 0:
        raise argparse.ArgumentTypeError(f"context can't be negative: {value}")
    return value


COMMANDS = {
    "meta": cmd_meta,
    "cites": cmd_cites,
    "search": cmd_search,
    "text": cmd_text,
    "outline": cmd_outline,
    "grep": cmd_grep,
}
EXIT_CODES = {UsageError: USAGE, ExtractFailed: NOT_FOUND, RemoteError: REMOTE}


# Main


def main(
    argv: list[str] | None = None,
    fetch: Fetch | None = None,
    sleep: Callable[[float], None] = time.sleep,
    extract: Extract | None = None,
    pace: Callable[[str], None] | None = None,
) -> int:
    parser = argparse.ArgumentParser(
        prog="paper",
        description=__doc__.split("\n\n")[0],
        epilog=__doc__.split("\n\n", 2)[2],
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", required=True, metavar="COMMAND")
    meta = sub.add_parser("meta", help="title, authors, year, venue, citations, ids")
    meta.add_argument("ids", nargs="+", metavar="ID")
    cites = sub.add_parser("cites", help="papers citing ID")
    cites.add_argument("id", metavar="ID")
    cites.add_argument("--limit", type=int, default=20, help="how many (default 20)")
    search = sub.add_parser("search", help="keyword search")
    search.add_argument("query", nargs="+", metavar="QUERY")
    search.add_argument("--limit", type=int, default=10, help="how many (default 10)")
    id_help = "arXiv id or URL, DOI, or PDF URL"
    text = sub.add_parser("text", help="full text: prints the cached .txt path")
    text.add_argument("id", metavar="ID", help=id_help)
    outline = sub.add_parser("outline", help="section headings with line numbers")
    outline.add_argument("id", metavar="ID", help=id_help)
    grep = sub.add_parser("grep", help="lines matching a regex, with line numbers")
    grep.add_argument("id", metavar="ID", help=id_help)
    grep.add_argument("pattern", metavar="PATTERN", help="a Python regex")
    grep.add_argument(
        "-C",
        "--context",
        type=context_lines,
        default=2,
        help="lines of context (default 2)",
    )
    grep.add_argument("-i", "--ignore-case", action="store_true")
    args = parser.parse_args(argv)
    client = Client(fetch or requests_fetch, sleep, extract or pdftotext, pace)
    try:
        return COMMANDS[args.command](client, args)
    except NotFound as e:
        print(f"paper: not found: {e}", file=sys.stderr)
        return NOT_FOUND
    except (UsageError, ExtractFailed, RemoteError) as e:
        print(f"paper: {e}", file=sys.stderr)
        return next(code for kind, code in EXIT_CODES.items() if isinstance(e, kind))


if __name__ == "__main__":
    sys.exit(main())
