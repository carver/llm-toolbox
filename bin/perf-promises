#!/usr/bin/env python3
"""Check a repo's performance promises: how long the commands it runs through heavy
take, against what perf-promises.toml at its top promises.

    perf-promises status [-C DIR]
    perf-promises --session-start < hook-event.json

A promise is a `[[promise]]` table:

    [[promise]]
    name = "commit-check"            # unique in the file; [a-z0-9-]
    command = '^agent-commit-check'  # Python regex, searched in the job's command words
    seconds = 30                     # promised running time of the whole run
    measured = "median of 12 runs in heavy's record, 2026-11-26"
    measured_seconds = 28            # what that measurement gave
    source = "030df63"               # where the promise was made: commit, issue, pitch
    counts = [0]                     # exit statuses whose runs count (default [0])

Every key but counts is required. The command words are those heavy's record keeps
(`heavy -h`), or the check's name for a commit check's job (`agent-pre-commit`,
`wt-ship's checks`), with the first word cut to its last path part. Promise a whole
run's time ("40 mutants take 2 minutes"), never a per-item one. llm-toolbox's own
perf-promises.toml covers jobs in every repo, since its tools run everywhere; in
llm-toolbox itself the tree's own copy is read.

heavy measures every job against the promises of its repo and llm-toolbox's as it
ends: its running time, from start to end without its wait in the queue, goes on
the log of the first promise it matches in each file, and a run of twice its promise
or more gets one note on stderr, `heavy: NAME ran 312 s, 2.6x its promised 120 s
(REPO/perf-promises.toml): perf-promises status` (in a commit check's pass line, for
the gate's checks). A run counts toward its promise when its exit status is in
counts or a signal stopped it; one that shared a lane (--share), or beside other work
that used over half its cores, is logged but left out, and its note says so. A file
or entry that can't be read is that note instead, and never fails the job.

status prints each promise of DIR's repo (default: the current folder) and
llm-toolbox's: its promised seconds, the runs logged, the median of its newest 5
counted runs of the last 14 days and the p90 of them all, and BROKEN when that median
is twice the promise or more; below 5 runs, `n=3, not judged`. Only log lines with the
promise's current seconds and command count, so a worktree's edited promise doesn't
skew main's. A promise is flagged when its seconds are over 3 times its
measured_seconds, or when it matched jobs once but none in 7 days, and so are the
problems reading each file. One that never matched a job, as a tripwire for a dropped
command is meant to, isn't flagged: status ends its line `never matched`.

--session-start is Claude Code's SessionStart hook, which install.py registers: it
reads the event on stdin, checks the promises of its cwd's repo and llm-toolbox's, and
prints each broken or flagged promise, and each file it can't read, as a line in hook
JSON, for the owner (`systemMessage`) and the agent (`additionalContext`): `perf
promise broken in REPO: NAME median 312 s over its last 5 runs, 2.6x the 120 s
promised (SOURCE); perf-promises status`. It prints nothing when all hold.

Each repo's runs are logged in its git common dir, perf-promises/NAME.tsv, shared by
its worktrees, a tab-separated line a run (its end in UTC, seconds, exit or sigN, load,
the promised seconds, the command's hash, session, folder), the newest 200 kept.

Environment:
  PERF_PROMISES_DIR     a folder for the logs, REPO/NAME.tsv, in place of each repo's
                        git dir (the tests set it)
  PERF_PROMISES_GLOBAL  a file that stands in for llm-toolbox's perf-promises.toml
                        (tests)

Exit status: status 0, or 1 when a promise is broken; --session-start always 0; 2 a
usage error.
"""

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import perfpromises


def session_start():
    """The hook: never fails, never prints anything but its JSON."""
    try:
        folder = json.loads(sys.stdin.read())["cwd"]
        lines = perfpromises.alarm_lines(folder)
    except Exception:  # noqa: BLE001 - a session's start must never fail on it
        return 0
    if lines:
        text = "\n".join(lines)
        context = {"hookEventName": "SessionStart", "additionalContext": text}
        print(json.dumps({"systemMessage": text, "hookSpecificOutput": context}))
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--session-start", action="store_true", help="the hook")
    parser.add_argument("-C", dest="folder", default=".", help="the repo's folder")
    parser.add_argument("command", nargs="?", choices=["status"])
    args = parser.parse_args(argv)
    if args.session_start:
        if args.command:
            parser.error("--session-start takes no command")
        return session_start()
    if args.command != "status":
        parser.error("expected `status` or `--session-start`")
    lines, broken = perfpromises.status_lines(str(Path(args.folder).resolve()))
    print("\n".join(lines))
    return 1 if broken else 0


if __name__ == "__main__":
    sys.exit(main())
