#!/usr/bin/env python3
"""Signal processes found by name or command line, and never the caller.

`pkill -f PATTERN` also matches the shell running it, because the pattern is in
that shell's own command line, and kills it. safekill skips itself and every
ancestor. Say how many processes you mean:

  safekill --one -f PATTERN   exactly one must match; if several do, list them and
                              signal none
  safekill --all -f PATTERN   signal every match

Exit status: 0 signalled (and, with --wait, every signalled process exited),
1 nothing matched, 2 --one found several (listed, none signalled) or a usage
error (unknown signal, bad pattern), 3 a signal failed or a process outlived
--wait. See also waitone.
"""

import argparse
import os
import re
import signal
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from procmatch import exactly_one, matches, none_matched, wait_gone

FAILED = 3


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="safekill",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument(
        "--one", action="store_true", help="exactly one process must match"
    )
    mode.add_argument("--all", action="store_true", help="signal every match")
    parser.add_argument(
        "pattern",
        help="exact process name, or with -f a regex over the full command line",
    )
    parser.add_argument(
        "-f",
        "--full",
        action="store_true",
        help="match the full command line, like pkill -f",
    )
    parser.add_argument(
        "-s",
        "--signal",
        default="TERM",
        help="signal name or number (default %(default)s)",
    )
    parser.add_argument(
        "-n", "--dry-run", action="store_true", help="show what would be signalled"
    )
    parser.add_argument(
        "-w",
        "--wait",
        type=float,
        default=0,
        metavar="SECONDS",
        help="wait up to SECONDS in all for the signalled processes to exit; "
        "exit 3 if one doesn't",
    )
    return parser


def parse_signal(text: str) -> signal.Signals | None:
    name = text.upper().removeprefix("SIG")
    try:
        return (
            signal.Signals(int(name))
            if name.isdigit()
            else signal.Signals["SIG" + name]
        )
    except (KeyError, ValueError):
        return None


def targets(args: argparse.Namespace) -> dict[int, str] | int:
    """pid -> command line of the processes to signal, or an exit status."""
    if args.one:
        found = exactly_one(args.pattern, args.full, "safekill")
        if isinstance(found, int):
            return found
        pid, cmdline = found
        return {pid: cmdline}
    return matches(args.pattern, args.full) or none_matched(
        args.pattern, "safekill", args.full
    )


def signal_and_wait(found: dict[int, str], sig: signal.Signals, wait: float) -> int:
    """Signal each process, then wait up to `wait` seconds in all for them to exit."""
    status = 0
    signalled = []
    for pid, cmdline in sorted(found.items()):
        try:
            os.kill(pid, sig)
        except OSError as e:
            print(f"safekill: {sig.name} to {pid} failed: {e}", file=sys.stderr)
            status = FAILED
            continue
        signalled.append(pid)
        print(f"sent {sig.name} to {pid}  {cmdline}")
    if wait:
        deadline = time.monotonic() + wait
        for pid in signalled:
            if not wait_gone(pid, max(0.0, deadline - time.monotonic())):
                print(f"safekill: {pid} still running after {wait}s", file=sys.stderr)
                status = FAILED
    return status


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    sig = parse_signal(args.signal)
    if sig is None:
        parser.error(f"unknown signal {args.signal!r}")
    if args.full:
        try:
            re.compile(args.pattern)
        except re.error as e:
            parser.error(f"bad pattern {args.pattern!r}: {e}")
    found = targets(args)
    if isinstance(found, int):
        return found
    if args.dry_run:
        for pid, cmdline in sorted(found.items()):
            print(f"would send {sig.name} to {pid}  {cmdline}")
        return 0
    return signal_and_wait(found, sig, args.wait)


if __name__ == "__main__":
    sys.exit(main())
